{
  "name": "@tuneboss/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/src/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "express": "latest",
    "mysql2": "^3.23.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@vercel/node": "^5.8.21",
    "drizzle-kit": "latest",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.62.0"
  }
}
