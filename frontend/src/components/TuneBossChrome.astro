  let tuneBossChromeController: AbortController | undefined;

  const initTuneBossChrome = () => {
  tuneBossChromeController?.abort();
  tuneBossChromeController = new AbortController();
  const { signal } = tuneBossChromeController;

  const root = document.documentElement;
  const navbar = document.querySelector("[data-navbar]");
  const menu = document.querySelector("[data-menu]");
  const panel = document.querySelector("[data-menu-panel]");
  const menuItems = document.querySelectorAll("[data-menu-item]");
  const openButtons = document.querySelectorAll("[data-menu-open]");
  const closeButtons = document.querySelectorAll("[data-menu-close]");
  const backTopButton = document.querySelector("[data-back-top]");
  const waFloat = document.querySelector("[data-wa-float]");
  const toastRoot = document.querySelector("[data-toast-root]");
  const cartDrawer = document.querySelector("[data-cart-drawer]");
  const cartPanel = document.querySelector("[data-cart-panel]");
  const cartBadge = document.querySelector("[data-cart-badge]");
  const cartItemsRoot = document.querySelector("[data-cart-items]");
  const cartSummary = document.querySelector("[data-cart-summary]");
  const cartTotal = document.querySelector("[data-cart-total]");
  const authDialogs = {
    login: document.querySelector('[data-auth-dialog="login"]'),
    register: document.querySelector('[data-auth-dialog="register"]'),
  };
  let authScrollY = 0;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let cart: any[] = [];

  const setMenu = (open: boolean) => {
    document.body.style.overflow = open ? "hidden" : "";
    menu?.setAttribute("aria-hidden", open ? "false" : "true");
    menu?.toggleAttribute("inert", !open);
    menu?.classList.toggle("visible", open);
    menu?.classList.toggle("opacity-100", open);
    menu?.classList.toggle("invisible", !open);
    menu?.classList.toggle("opacity-0", !open);
    panel?.classList.toggle("translate-x-0", open);
    panel?.classList.toggle("-translate-x-full", !open);
    menuItems.forEach((item) => {
      item.classList.toggle("translate-x-0", open);
      item.classList.toggle("opacity-100", open);
      item.classList.toggle("translate-x-[-2rem]", !open);
      item.classList.toggle("opacity-0", !open);
    });
    waFloat?.classList.toggle("hidden", open);
  };

  const syncNav = () => {
    const scrolled = window.scrollY > 50;
    const showBackTop = window.scrollY > 120;
    navbar?.classList.toggle("py-3", scrolled);
    navbar?.classList.toggle("py-4", !scrolled);
    backTopButton?.classList.toggle("visible", showBackTop);
    backTopButton?.classList.toggle("invisible", !showBackTop);
    backTopButton?.classList.toggle("opacity-100", showBackTop);
    backTopButton?.classList.toggle("opacity-0", !showBackTop);
    backTopButton?.classList.toggle("translate-y-0", showBackTop);
    backTopButton?.classList.toggle("translate-y-3", !showBackTop);
  };

  const setLanguage = (lang: string) => {
    const safeLang = lang === "en" ? "en" : "id";
    root.lang = safeLang;
    localStorage.setItem("lang", safeLang);
    document.querySelectorAll("[data-lang-toggle]").forEach((btn) => { btn.textContent = safeLang.toUpperCase(); });

    document.querySelectorAll("[data-i18n]").forEach((node) => {
      const key = node.getAttribute("data-i18n") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) node.textContent = copy[safeLang][key];
    });

    document.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
      const key = node.getAttribute("data-i18n-placeholder") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) node.setAttribute("placeholder", copy[safeLang][key]);
    });

    document.querySelectorAll("[data-i18n-title]").forEach((node) => {
      const key = node.getAttribute("data-i18n-title") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) document.title = `${copy[safeLang][key]} | TuneBoss ID`;
    });
    
    root.classList.remove("lang-en-loading");
  };

  const escapeHtml = (value: string | undefined | null) => {
    const map = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" };
    return String(value || "").replace(/[&<>"']/g, (char) => map[char as keyof typeof map] || char);
  };

  const showToast = (title: string, description: string) => {
    if (!toastRoot) return;

    const toast = document.createElement("div");
    toast.className = "alert-toast flex items-start gap-4 border border-green-300 bg-background p-4 text-foreground shadow-xl dark:border-green-700";
    toast.setAttribute("role", "alert");
    toast.innerHTML = `
      <div class="shrink-0 text-green-500">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.8 10.9a10 10 0 1 1-4.7-7.7" />
          <path d="m9 11 3 3L22 4" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold">${escapeHtml(title)}</p>
        <p class="mt-1 text-sm leading-relaxed opacity-90">${escapeHtml(description)}</p>
      </div>
      <button class="shrink-0 rounded-full p-1 text-xl leading-none opacity-70 transition-opacity hover:opacity-100" type="button" aria-label="Close">×</button>
    `;

    const close = () => {
      toast.classList.remove("is-visible");
      window.setTimeout(() => toast.remove(), 250);
    };

    toast.querySelector("button")?.addEventListener("click", close, { signal });
    toastRoot.prepend(toast);
    window.setTimeout(() => toast.classList.add("is-visible"), 20);
    window.setTimeout(close, 3200);
  };

  const formatRupiah = (value: number) => `Rp. ${new Intl.NumberFormat("id-ID").format(value)}`;
  const parseRupiah = (value: string | number) => Number(String(value).replace(/[^\d]/g, "")) || 0;
  const cartCount = () => cart.reduce((total, item) => total + item.quantity, 0);

  const saveCart = () => localStorage.setItem("tuneboss-cart", JSON.stringify(cart));
  const icon = {
    minus: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14" /></svg>',
    plus: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>',
    trash: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>',
  };

  const renderCart = () => {
    const count = cartCount();
    const productCount = cart.length;
    const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

    if (cartBadge) {
      cartBadge.textContent = String(count);
      cartBadge.classList.toggle("invisible", count === 0);
    }
    if (cartSummary) {
      const isEnglish = root.lang === "en";
      cartSummary.textContent = count === 0
        ? (isEnglish ? "Cart is empty" : "Keranjang kosong")
        : (isEnglish ? `${productCount} products, ${count} items` : `${productCount} produk, ${count} item`);
    }
    if (cartTotal) cartTotal.textContent = formatRupiah(total);
    if (!cartItemsRoot) return;

    if (cart.length === 0) {
      cartItemsRoot.innerHTML = `
        <div class="flex h-full flex-col items-center justify-center text-center">
          <p class="text-lg font-bold uppercase tracking-widest">Keranjang kosong</p>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-primary">Tambahkan produk TuneBoss pilihan Anda terlebih dahulu.</p>
          <button data-cart-close class="mt-6 border border-primary/20 px-5 py-3 text-xs font-bold uppercase tracking-widest transition-colors hover:border-primary hover:text-primary" type="button">Lanjut Belanja</button>
        </div>
      `;
      return;
    }

    cartItemsRoot.innerHTML = cart
      .map(
        (item) => `
          <article class="border-b border-primary/10 py-5">
            <div class="flex items-start justify-between gap-4">
              <div class="flex min-w-0 gap-4">
                <img src="${escapeHtml(item.image || "/images/tuneboss-motorcycle-ecu.png")}" alt="" loading="eager" class="h-20 w-20 shrink-0 object-contain" aria-hidden="true" />
                <div class="min-w-0">
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">TuneBoss</p>
                  <p class="mt-1 text-base font-bold uppercase tracking-wide">${escapeHtml(item.name)}</p>
                  <p class="mt-2 text-sm text-primary">${formatRupiah(item.price)}</p>
                </div>
              </div>
              <button data-cart-remove="${escapeHtml(item.id)}" class="flex h-9 w-9 items-center justify-center border border-primary/15 transition-colors hover:border-primary hover:text-primary" type="button" aria-label="Hapus ${escapeHtml(item.name)}">${icon.trash}</button>
            </div>
            <div class="mt-4 flex items-center justify-between">
              <div class="flex items-center border border-primary/20">
                <button data-cart-dec="${escapeHtml(item.id)}" class="flex h-9 w-9 items-center justify-center transition-colors hover:bg-primary hover:text-white" type="button" aria-label="Kurangi ${escapeHtml(item.name)}">${icon.minus}</button>
                <input
                  data-cart-input="${escapeHtml(item.id)}"
                  class="h-9 w-12 border-x border-primary/20 bg-transparent text-center text-sm outline-none transition-colors focus:border-primary focus:text-primary"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  value="${item.quantity}"
                  max="${Number(item.max || 99)}"
                  aria-label="Jumlah ${escapeHtml(item.name)}"
                />
                <button data-cart-inc="${escapeHtml(item.id)}" class="flex h-9 w-9 items-center justify-center transition-colors hover:bg-primary hover:text-white" type="button" aria-label="Tambah ${escapeHtml(item.name)}">${icon.plus}</button>
              </div>
              <strong class="text-sm font-bold">${formatRupiah(item.price * item.quantity)}</strong>
            </div>
          </article>
        `,
      )
      .join("");
  };

  const loadCart = () => {
    try {
      const saved = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
      cart = Array.isArray(saved)
        ? saved
            .filter((item) => item && item.id && item.name)
            .map((item) => ({
              ...item,
              max: Number(item.max || 99),
              quantity: Math.max(1, Math.min(Number(item.quantity || 1), Number(item.max || 99) || 99)),
            }))
        : [];
    } catch {
      cart = [];
    }
    renderCart();
  };

  const setCartDrawer = (open: boolean) => {
    document.body.style.overflow = open ? "hidden" : "";
    cartDrawer?.setAttribute("aria-hidden", open ? "false" : "true");
    cartDrawer?.toggleAttribute("inert", !open);
    cartDrawer?.classList.toggle("visible", open);
    cartDrawer?.classList.toggle("opacity-100", open);
    cartDrawer?.classList.toggle("invisible", !open);
    cartDrawer?.classList.toggle("opacity-0", !open);
    cartPanel?.classList.toggle("translate-x-0", open);
    cartPanel?.classList.toggle("translate-x-full", !open);
    backTopButton?.classList.toggle("hidden", open);
    waFloat?.classList.toggle("hidden", open);
  };

  const addToCart = (button: HTMLElement) => {
    const id = button.dataset.productId || button.dataset.productName || "product";
    const name = button.dataset.productName || "Produk";
    const price = parseRupiah(button.dataset.productPrice || "0");
    const qtyInput = button.closest("[data-cart-form]")?.querySelector("[data-cart-qty]");
    const max = qtyInput instanceof HTMLInputElement ? Number(qtyInput.dataset.max || 99) : 99;
    const quantity = qtyInput instanceof HTMLInputElement ? Math.max(1, Math.min(Number(qtyInput.value || 1), max || 99)) : 1;
    const existing = cart.find((item) => item.id === id);

    if (existing) {
      existing.max = Number(existing.max || max || 99);
      existing.quantity = Math.min(existing.max || 99, existing.quantity + quantity);
    } else {
      cart.push({ id, name, price, image: button.dataset.productImage || "", quantity, max });
    }

    saveCart();
    renderCart();

    const isEnglish = root.lang === "en";
    showToast(isEnglish ? "Added to cart" : "Masuk keranjang", isEnglish ? `${name} has been added to your cart.` : `${name} berhasil ditambahkan ke keranjang.`);
  };

  const updateCartItem = (id: string, action: string) => {
    const item = cart.find((entry) => entry.id === id);
    if (!item) return;

    const max = Number(item.max || 99);
    if (action === "inc") item.quantity = Math.min(max || 99, item.quantity + 1);
    if (action === "dec") item.quantity -= 1;
    if (action === "remove" || item.quantity <= 0) cart = cart.filter((entry) => entry.id !== id);

    saveCart();
    renderCart();
  };

  const setCartQuantity = (id: string, value: string | number) => {
    const item = cart.find((entry) => entry.id === id);
    if (!item) return;
    const max = Number(item.max || 99);
    const quantity = Math.max(1, Math.min(Number(value || 1), max || 99));
    item.quantity = quantity;
    saveCart();
    renderCart();
  };

  const lockAuthScroll = () => {
    if (document.body.style.position === "fixed") return;
    authScrollY = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${authScrollY}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
    document.body.style.width = "100%";
    document.body.style.overflow = "hidden";
  };

  const unlockAuthScroll = () => {
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    document.body.style.width = "";
    document.body.style.overflow = "";
    window.scrollTo(0, authScrollY);
  };

  const openAuthDialog = (mode = "login") => {
    const dialog = authDialogs[mode as keyof typeof authDialogs] || authDialogs.login;
    document.body.dataset.authSwitching = "true";
    Object.values(authDialogs).forEach((item) => {
      if (item instanceof HTMLDialogElement && item.open && item !== dialog) item.close();
    });
    delete document.body.dataset.authSwitching;
    if (dialog instanceof HTMLDialogElement && !dialog.open) {
      lockAuthScroll();
      dialog.showModal();
    }
  };

  document.querySelectorAll("[data-auth-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button instanceof HTMLElement) openAuthDialog(button.dataset.authOpen || "login");
      setMenu(false);
    }, { signal });
  });

  document.querySelectorAll("[data-auth-switch]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button instanceof HTMLElement) openAuthDialog(button.dataset.authSwitch || "login");
    }, { signal });
  });

  document.querySelectorAll("[data-auth-close]").forEach((button) => {
    button.addEventListener("click", () => button.closest("dialog")?.close(), { signal });
  });

  Object.values(authDialogs).forEach((dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.addEventListener("close", () => {
      if (document.body.dataset.authSwitching) return;
      if (!Object.values(authDialogs).some((item) => item instanceof HTMLDialogElement && item.open)) {
        unlockAuthScroll();
      }
    }, { signal });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    }, { signal });
  });

  document.querySelectorAll("[data-auth-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const mode = form.dataset.authForm === "register" ? "register" : "login";

      const emailInput = form.elements.namedItem("email");
      const passwordInput = form.elements.namedItem("password");
      const nameInput = form.elements.namedItem("name");
      const confirmPasswordInput = form.elements.namedItem("confirmPassword");

      form.querySelectorAll(".auth-error").forEach(el => {
        el.textContent = "";
        el.classList.add("hidden");
      });

      let schema;
      if (mode === "register") {
        schema = z.object({
          email: z.string().min(1, { message: "Email wajib diisi" }).regex(/^[^\s@]+@[^\s@]+\.[^\s@]+$/, { message: "Format email tidak valid" }),
          password: z.string().min(6, { message: "Password minimal 6 karakter" }),
          name: z.string().min(1, { message: "Nama wajib diisi" }),
          confirmPassword: z.string().min(1, { message: "Konfirmasi password wajib diisi" }),
        }).refine((data) => data.password === data.confirmPassword, {
          message: "Password tidak sama",
          path: ["confirmPassword"],
        });
      } else {
        schema = z.object({
          email: z.string().min(1, { message: "Email wajib diisi" }).regex(/^[^\s@]+@[^\s@]+\.[^\s@]+$/, { message: "Format email tidak valid" }),
          password: z.string().min(6, { message: "Password minimal 6 karakter" }),
        });
      }

      const formData = {
        email: emailInput instanceof HTMLInputElement ? emailInput.value : "",
        password: passwordInput instanceof HTMLInputElement ? passwordInput.value : "",
        ...(mode === "register" ? { 
          name: nameInput instanceof HTMLInputElement ? nameInput.value : "",
          confirmPassword: confirmPasswordInput instanceof HTMLInputElement ? confirmPasswordInput.value : ""
        } : {})
      };

      const result = schema.safeParse(formData);

      if (!result.success) {
        result.error.issues.forEach(issue => {
          const field = issue.path[0];
          const input = form.elements.namedItem(field as string);
          if (input instanceof HTMLElement) {
            const errorContainer = input.closest("label")?.querySelector(".auth-error");
            if (errorContainer) {
              errorContainer.textContent = issue.message;
              errorContainer.classList.remove("hidden");
            }
          }
        });
        return;
      }

      const lang = root.lang === "en" ? "en" : "id";
      const titleKey = mode === "register" ? "auth.registerToast" : "auth.signinToast";
      const copyKey = mode === "register" ? "auth.registerToastCopy" : "auth.signinToastCopy";
      showToast(copy[lang][titleKey], copy[lang][copyKey]);
      form.closest("dialog")?.close();

      document.cookie = "tuneboss-auth=true; path=/; max-age=31536000";
      if (typeof window.checkAuthStatus === "function") window.checkAuthStatus();
      else window.location.reload();
    }, { signal });
  });

  openButtons.forEach((button) => button.addEventListener("click", () => setMenu(true), { signal }));
  closeButtons.forEach((button) => button.addEventListener("click", () => setMenu(false), { signal }));
  document.querySelectorAll("[data-cart-open]").forEach((button) => button.addEventListener("click", () => setCartDrawer(true), { signal }));
  document.querySelectorAll("[data-cart-close]").forEach((button) => button.addEventListener("click", () => setCartDrawer(false), { signal }));
  backTopButton?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }), { signal });
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("[data-cart-close]")) {
      setCartDrawer(false);
      return;
    }

    const addButton = event.target.closest("[data-add-cart]");
    if (addButton instanceof HTMLElement) {
      addToCart(addButton);
      return;
    }

    const passwordButton = event.target.closest("[data-password-toggle]");
    if (passwordButton instanceof HTMLElement) {
      const input = passwordButton.parentElement?.querySelector("[data-auth-password]");
      if (!(input instanceof HTMLInputElement)) return;
      const visible = input.type === "text";
      input.type = visible ? "password" : "text";
      passwordButton.querySelector("[data-eye-show]")?.classList.toggle("hidden", !visible);
      passwordButton.querySelector("[data-eye-hide]")?.classList.toggle("hidden", visible);
      passwordButton.setAttribute("aria-label", visible ? "Show password" : "Hide password");
      return;
    }

    const incButton = event.target.closest("[data-cart-inc]");
    const decButton = event.target.closest("[data-cart-dec]");
    const removeButton = event.target.closest("[data-cart-remove]");
    if (incButton instanceof HTMLElement) updateCartItem(incButton.dataset.cartInc || "", "inc");
    if (decButton instanceof HTMLElement) updateCartItem(decButton.dataset.cartDec || "", "dec");
    if (removeButton instanceof HTMLElement) updateCartItem(removeButton.dataset.cartRemove || "", "remove");
  }, { signal });

  document.addEventListener("input", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !input.matches("[data-cart-input]")) return;
    input.value = input.value.replace(/\D/g, "");
  }, { signal });

  document.addEventListener("change", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !input.matches("[data-cart-input]")) return;
    setCartQuantity(input.dataset.cartInput || "", input.value);
  }, { signal });

  document.addEventListener("blur", (event) => {
    const input = event.target;
    if (!(input instanceof HTMLInputElement) || !input.matches("[data-cart-input]")) return;
    setCartQuantity(input.dataset.cartInput || "", input.value);
  }, { capture: true, signal });

  document.querySelectorAll("[data-lang-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => setLanguage(root.lang === "id" ? "en" : "id"), { signal });
  });
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      root.classList.toggle("dark");
      localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
    }, { signal });
  });

  if (localStorage.getItem("theme") === "dark") root.classList.add("dark");
  loadCart();
  setLanguage(localStorage.getItem("lang") === "en" ? "en" : "id");

  window.checkAuthStatus = () => {
    const isLoggedIn = document.cookie.includes("tuneboss-auth=true");
    document.querySelectorAll("[data-auth-guest]").forEach(el => el.classList.toggle("hidden", isLoggedIn));
    document.querySelectorAll("[data-auth-user]").forEach(el => {
      if (isLoggedIn) {
        el.classList.remove("hidden");
        el.classList.add("flex");
      } else {
        el.classList.add("hidden");
        el.classList.remove("flex");
      }
    });

    const iconGuest = document.querySelector("[data-auth-icon-guest]");
    const iconUser = document.querySelector("[data-auth-icon-user]");
    if (iconGuest) iconGuest.classList.toggle("hidden", isLoggedIn);
    if (iconUser) iconUser.classList.toggle("hidden", !isLoggedIn);

    const checkoutBtn = document.querySelector("[data-cart-checkout-btn]");
    if (checkoutBtn) {
      if (isLoggedIn) {
        checkoutBtn.textContent = "Checkout";
        (checkoutBtn as HTMLElement).onclick = () => { window.location.href = "/cart"; };
      } else {
        checkoutBtn.textContent = "Login to Checkout";
        (checkoutBtn as HTMLElement).onclick = () => {
          if (typeof setCartDrawer === "function") setCartDrawer(false);
          if (typeof openAuthDialog === "function") openAuthDialog("login");
        };
      }
    }
  };
  window.checkAuthStatus();

  document.querySelectorAll("[data-auth-logout]").forEach(btn => {
    btn.addEventListener("click", () => {
      document.cookie = "tuneboss-auth=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";
      window.checkAuthStatus();
      setMenu(false);
      window.location.href = "/";
    }, { signal });
  });

  window.addEventListener("scroll", syncNav, { passive: true, signal });
  syncNav();

  Promise.all([import("gsap"), import("gsap/ScrollTrigger")]).then(([{ gsap }, { ScrollTrigger }]) => {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray("[data-reveal]").forEach((node) => {
      gsap.fromTo(
        node as Element,
        { y: 60, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 1.2,
          ease: "expo.out",
          scrollTrigger: {
            trigger: node as Element,
            start: "top 85%",
          },
        },
      );
    });
  });
  };

  initTuneBossChrome();
  document.addEventListener("astro:page-load", initTuneBossChrome);

  document.addEventListener("astro:before-swap", (event) => {
    const safeLang = localStorage.getItem("lang") === "en" ? "en" : "id";
    if (safeLang === "id") return; // id is default HTML, no translation needed
    
    const doc = event.newDocument;
    doc.documentElement.lang = safeLang;
    
    doc.querySelectorAll("[data-lang-toggle]").forEach((btn) => { btn.textContent = safeLang.toUpperCase(); });

    doc.querySelectorAll("[data-i18n]").forEach((node) => {
      const key = node.getAttribute("data-i18n") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) node.textContent = copy[safeLang][key];
    });

    doc.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
      const key = node.getAttribute("data-i18n-placeholder") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) node.setAttribute("placeholder", copy[safeLang][key]);
    });

    doc.querySelectorAll("[data-i18n-title]").forEach((node) => {
      const key = node.getAttribute("data-i18n-title") as keyof typeof copy["en"];
      if (key && copy[safeLang][key]) doc.title = `${copy[safeLang][key]} | TuneBoss ID`;
    });
  });
</script>
