---
import { Image } from "astro:assets";
import { ArrowUp, ChevronRight, Eye, EyeOff, Home, LogIn, Moon, Package, ShoppingBag, Sun, User, UserPlus, X, Truck } from "lucide-react";
import { FaFacebookF, FaInstagram, FaTiktok, FaYoutube } from "react-icons/fa6";
import logo from "../../public/tuneboss-logo.png";
---

<nav data-navbar class="fixed left-0 top-0 z-40 w-full border-b border-primary/10 bg-background/95 py-4 text-foreground shadow-sm backdrop-blur-lg transition-all duration-500">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between px-5 md:px-12">
    <div class="flex flex-1 justify-start">
      <button data-menu-open class="group flex items-center space-x-3 outline-none transition-colors hover:text-primary" type="button" aria-label="Menu">
        <div class="relative flex h-5 w-6 flex-col justify-between" aria-hidden="true">
          <span class="block h-[2px] w-6 bg-current transition-all duration-300 group-hover:w-8" aria-hidden="true"></span>
          <span class="block h-[2px] w-6 bg-current transition-all duration-300" aria-hidden="true"></span>
          <span class="block h-[2px] w-4 bg-current transition-all duration-300 group-hover:w-8" aria-hidden="true"></span>
        </div>
        <span class="hidden text-sm font-bold uppercase tracking-widest md:block">Menu</span>
      </button>
    </div>

    <a href="/" class="z-50 flex-none" aria-label="TuneBoss Home">
      <Image src={logo} alt="TuneBoss" class="h-6 w-auto object-contain md:h-10" loading="eager" />
    </a>

    <div class="z-50 flex flex-1 items-center justify-end space-x-4 md:space-x-6">
      <button data-lang-toggle class="hidden text-xs font-bold uppercase tracking-widest transition-colors hover:text-primary md:block md:text-sm" type="button" aria-label="Toggle Language">ID</button>
      <button data-theme-toggle class="hidden transition-transform duration-500 hover:rotate-180 md:block" type="button" aria-label="Toggle Theme">
        <Sun data-sun size={20} strokeWidth={2} className="hidden transition-colors group-hover:text-primary dark:block" />
        <Moon data-moon size={20} strokeWidth={2} className="block transition-colors group-hover:text-primary dark:hidden" />
      </button>
      <button data-cart-open class="group relative transition-transform duration-300 hover:scale-110" type="button" aria-label="Keranjang">
        <ShoppingBag size={20} strokeWidth={2} className="transition-colors group-hover:text-primary" />
        <span data-cart-badge class="invisible absolute -right-2 -top-2 flex h-4 min-w-4 items-center justify-center rounded-full bg-primary px-1 text-[10px] font-bold text-white">0</span>
      </button>
      <button data-auth-open="login" class="group transition-transform duration-300 hover:scale-110" type="button" aria-label="Account">
        <User size={20} strokeWidth={2} className="transition-colors group-hover:text-primary" />
      </button>
    </div>
  </div>
</nav>

<div data-menu class="invisible fixed inset-0 z-50 flex opacity-0 transition-all duration-700" aria-hidden="true" inert>
  <button data-menu-close class="absolute inset-0 bg-black/40 backdrop-blur-md transition-opacity duration-700 dark:bg-black/70" type="button" aria-label="Close menu"></button>

  <aside data-menu-panel class="relative flex h-full w-full -translate-x-full flex-col border-r border-primary/10 bg-white/95 text-foreground shadow-2xl backdrop-blur-3xl transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] dark:bg-black/95 md:w-[450px]">
    <div class="flex items-center justify-between px-10 pb-6 pt-8">
      <a href="/" aria-label="TuneBoss Home">
        <Image src={logo} alt="TuneBoss" class="h-9 w-auto object-contain" loading="eager" />
      </a>
      <button data-menu-close class="group flex h-11 w-11 items-center justify-center rounded-full border border-primary/10 bg-secondary/10 transition-all duration-300 hover:rotate-90 hover:border-primary hover:bg-primary/10" type="button" aria-label="Close menu">
        <X size={20} strokeWidth={1.5} className="transition-colors group-hover:text-primary" />
      </button>
    </div>

    <div class="flex-grow overflow-y-auto px-10 py-6">
      <ul class="flex flex-col space-y-2">
        {[
          ["Home", "/", Home],
          ["Products", "/products", Package],
          ["Keranjang", "/cart", ShoppingBag],
          ["Lacak Pesanan", "/tracking", Truck],
        ].map(([name, path, Icon], index) => (
          <li class="translate-x-[-2rem] opacity-0 transition-all duration-500" data-menu-item style={`transition-delay: ${100 + index * 100}ms`}>
            <a href={path} aria-label={name} class="group relative flex items-center justify-between overflow-hidden border-b border-primary/5 py-5 transition-colors duration-300 hover:border-primary/30">
              <span class="flex items-center gap-4 text-2xl font-light tracking-wide transition-all duration-300 group-hover:translate-x-2 group-hover:text-primary">
                <Icon size={20} strokeWidth={1.5} className="transition-colors group-hover:text-primary" />
                <span data-i18n={path === "/" ? "nav.home" : path === "/products" ? "nav.products" : path === "/tracking" ? "nav.tracking" : "nav.cart"}>{name}</span>
              </span>
              <ChevronRight size={20} strokeWidth={1} className="text-primary transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="border-t border-primary/10 bg-secondary/5 px-10 py-12">
      <div class="mb-8 flex items-center gap-6 md:hidden">
        <button data-lang-toggle class="text-sm font-bold uppercase tracking-widest transition-colors hover:text-primary" type="button" aria-label="Toggle Language">ID</button>
        <button data-theme-toggle class="group transition-transform duration-500 hover:rotate-180" type="button" aria-label="Toggle Theme">
          <Sun data-sun size={20} strokeWidth={2} className="hidden transition-colors group-hover:text-primary dark:block" />
          <Moon data-moon size={20} strokeWidth={2} className="block transition-colors group-hover:text-primary dark:hidden" />
        </button>
      </div>
      <p data-i18n="account.title" class="mb-4 text-[10px] uppercase tracking-[0.3em] text-primary">Account</p>
      <div class="flex flex-col space-y-4">
        <a href="/login" aria-label="Sign In" class="drawer-account-link flex items-center gap-3 text-left text-sm font-bold tracking-widest">
          <LogIn size={16} strokeWidth={1.5} />
          <span data-i18n="account.signin">Sign In</span>
        </a>
        <a href="/register" aria-label="Create Account" class="drawer-account-link flex items-center gap-3 text-left text-sm font-bold tracking-widest">
          <UserPlus size={16} strokeWidth={1.5} />
          <span data-i18n="account.create">Create Account</span>
        </a>
      </div>
    </div>
  </aside>
</div>

<slot />

<div data-cart-drawer class="invisible fixed inset-0 z-50 flex justify-end opacity-0 transition-all duration-300" aria-hidden="true" inert>
  <button data-cart-close class="absolute inset-0 bg-black/50 backdrop-blur-sm" type="button" aria-label="Close cart"></button>
  <aside data-cart-panel class="relative flex h-full w-full translate-x-full flex-col border-l border-primary/10 bg-background text-foreground shadow-2xl transition-transform duration-300 md:max-w-md">
    <div class="flex items-center justify-between border-b border-primary/10 px-6 py-5">
      <div class="flex items-start gap-3">
        <ShoppingBag size={22} strokeWidth={1.8} className="mt-1 text-primary" aria-hidden="true" />
        <div>
          <h2 class="text-xl font-bold uppercase tracking-widest" aria-label="Keranjang">Keranjang</h2>
        <p data-cart-summary class="mt-2 text-sm text-primary">Keranjang kosong</p>
        </div>
      </div>
      <button data-cart-close class="p-2 transition-colors hover:text-primary" type="button" aria-label="Close cart">
        <X size={20} strokeWidth={1.6} />
      </button>
    </div>
    <div data-cart-items class="flex-1 overflow-y-auto px-6 py-5"></div>
    <div class="border-t border-primary/10 px-6 py-5">
      <div class="mb-4 flex items-center justify-between text-sm uppercase tracking-widest">
        <span>Subtotal</span>
        <strong data-cart-total>Rp. 0</strong>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <button data-cart-close class="border border-primary/20 px-4 py-3 text-xs font-bold uppercase tracking-widest transition-colors hover:border-primary hover:text-primary" type="button">Lanjut Belanja</button>
        <button class="bg-primary px-4 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-[#c95b04]" type="button">Checkout</button>
      </div>
    </div>
  </aside>
</div>

<button data-back-top class="invisible fixed bottom-8 right-5 z-50 flex h-11 w-11 translate-y-3 items-center justify-center rounded-full bg-primary text-white opacity-0 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-[#c95b04] md:right-8" type="button" aria-label="Back to top">
  <ArrowUp size={18} strokeWidth={1.8} />
</button>

<div data-toast-root class="fixed right-4 top-24 z-[60] flex w-[calc(100vw-2rem)] max-w-sm flex-col gap-3 md:right-8"></div>

<dialog data-auth-dialog="login" class="auth-dialog w-[calc(100vw-2rem)] max-w-lg border border-primary/20 bg-background p-0 text-foreground shadow-2xl">
  <div class="relative p-7 md:p-8">
    <button data-auth-close class="absolute right-4 top-4 rounded-full p-2 opacity-70 transition-colors hover:text-primary hover:opacity-100" type="button" aria-label="Close">
      <X size={18} strokeWidth={1.6} />
    </button>
    <div class="mb-6 flex flex-col items-center gap-3 text-center">
      <div>
        <h2 data-i18n="auth.loginTitle" class="text-2xl font-bold uppercase tracking-[0.18em]" aria-label="Sign In">Sign In</h2>
        <p data-i18n="auth.loginCopy" class="mt-3 text-base leading-relaxed text-foreground/70">Enter your credentials to access your account.</p>
      </div>
    </div>
    <form data-auth-form="login" class="space-y-5">
      <label class="block">
        <span data-i18n="auth.email" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Email</span>
        <input data-i18n-placeholder="auth.emailPlaceholder" class="auth-input" type="email" placeholder="hello@tuneboss.id" required />
      </label>
      <label class="block">
        <span data-i18n="auth.password" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Password</span>
        <span class="relative block">
          <input data-auth-password data-i18n-placeholder="auth.passwordPlaceholder" class="auth-input pr-12" type="password" placeholder="Enter your password" required />
          <button data-password-toggle class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-foreground/60 transition-colors hover:text-primary" type="button" aria-label="Show password">
            <Eye data-eye-show size={20} strokeWidth={1.8} />
            <EyeOff data-eye-hide size={20} strokeWidth={1.8} className="hidden" />
          </button>
        </span>
      </label>
      <div class="flex items-center justify-between gap-4 text-sm">
        <label class="flex items-center gap-2 text-foreground/70">
          <input class="h-4 w-4 accent-primary" type="checkbox" />
          <span data-i18n="auth.remember">Remember me</span>
        </label>
        <button data-i18n="auth.forgot" class="tuneboss-link text-[10px]" type="button">Forgot password?</button>
      </div>
      <button data-i18n="auth.signin" class="w-full border border-primary bg-primary px-5 py-4 text-base font-bold uppercase tracking-[0.22em] text-white transition-colors hover:bg-[#c95b04]" type="submit">Sign In</button>
    </form>
    <div class="my-5 flex items-center gap-3 text-xs uppercase tracking-widest text-foreground/50 before:h-px before:flex-1 before:bg-primary/10 after:h-px after:flex-1 after:bg-primary/10">
      <span data-i18n="auth.or">Or</span>
    </div>
    <button data-auth-switch="register" class="w-full border border-primary/20 px-5 py-3 text-sm font-bold uppercase tracking-[0.22em] transition-colors hover:border-primary hover:text-primary" type="button">
      <span data-i18n="auth.createAccount">Create Account</span>
    </button>
  </div>
</dialog>

<dialog data-auth-dialog="register" class="auth-dialog w-[calc(100vw-2rem)] max-w-lg border border-primary/20 bg-background p-0 text-foreground shadow-2xl">
  <div class="relative p-7 md:p-8">
    <button data-auth-close class="absolute right-4 top-4 rounded-full p-2 opacity-70 transition-colors hover:text-primary hover:opacity-100" type="button" aria-label="Close">
      <X size={18} strokeWidth={1.6} />
    </button>
    <div class="mb-6 flex flex-col items-center gap-3 text-center">
      <div>
        <h2 data-i18n="auth.registerTitle" class="text-2xl font-bold uppercase tracking-[0.18em]" aria-label="Create Account">Create Account</h2>
        <p data-i18n="auth.registerCopy" class="mt-3 text-base leading-relaxed text-foreground/70">Create your TuneBoss account to continue.</p>
      </div>
    </div>
    <form data-auth-form="register" class="space-y-5">
      <label class="block">
        <span data-i18n="auth.name" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Name</span>
        <input data-i18n-placeholder="auth.namePlaceholder" class="auth-input" type="text" placeholder="TuneBoss Rider" required />
      </label>
      <label class="block">
        <span data-i18n="auth.email" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Email</span>
        <input data-i18n-placeholder="auth.emailPlaceholder" class="auth-input" type="email" placeholder="hello@tuneboss.id" required />
      </label>
      <label class="block">
        <span data-i18n="auth.password" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Password</span>
        <span class="relative block">
          <input data-auth-password data-i18n-placeholder="auth.passwordPlaceholder" class="auth-input pr-12" type="password" placeholder="Enter your password" required />
          <button data-password-toggle class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-foreground/60 transition-colors hover:text-primary" type="button" aria-label="Show password">
            <Eye data-eye-show size={20} strokeWidth={1.8} />
            <EyeOff data-eye-hide size={20} strokeWidth={1.8} className="hidden" />
          </button>
        </span>
      </label>
      <button data-i18n="auth.createAccount" class="w-full border border-primary bg-primary px-5 py-4 text-base font-bold uppercase tracking-[0.22em] text-white transition-colors hover:bg-[#c95b04]" type="submit">Create Account</button>
    </form>
    <button data-auth-switch="login" class="mt-5 w-full border border-primary/20 px-5 py-3 text-sm font-bold uppercase tracking-[0.22em] transition-colors hover:border-primary hover:text-primary" type="button">
      <span data-i18n="auth.backToSignin">Back to Sign In</span>
    </button>
  </div>
</dialog>

<footer class="w-full border-t border-primary/10 bg-secondary/5 pb-10 pt-12 dark:bg-white/5">
  <div class="mx-auto max-w-[1600px] px-6 md:px-12">
    <div class="mb-16 grid grid-cols-1 gap-14 md:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_1.2fr_0.9fr] lg:gap-20">
      <div>
        <a href="/" class="mb-6 block" aria-label="TuneBoss Home">
          <Image src={logo} alt="TuneBoss" class="h-10 w-auto object-contain" loading="lazy" />
        </a>
        <p class="max-w-md text-sm font-light leading-relaxed text-primary">
          <span data-i18n="footer.copy">Designed for daily commuters, hobbyists and race teams, TuneBoss ECU enables detailed engine tuning. This extracts the best performance and prevents engine damage after modifications.</span>
        </p>
      </div>

      <div class="order-2 lg:order-none">
        <h4 data-i18n="footer.navigation" class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-primary">Navigation</h4>
        <ul class="space-y-4">
          <li><a data-i18n="nav.home" class="tuneboss-link" href="/">Home</a></li>
          <li><a data-i18n="nav.products" class="tuneboss-link" href="/products">Products</a></li>
          <li><a data-i18n="nav.cart" class="tuneboss-link" href="/cart">Keranjang</a></li>
        </ul>
      </div>

      <div class="order-1 lg:order-none">
        <h4 data-i18n="footer.concierge" class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-primary">Contact</h4>
        <ul class="space-y-4">
          <li class="text-xs font-light uppercase tracking-widest"><span class="mb-1 block text-[10px] text-primary">Email</span>hello@tuneboss.id</li>
          <li class="text-xs font-light uppercase tracking-widest"><span class="mb-1 block text-[10px] text-primary">Phone/WA</span>+62 817-5792-805</li>
          <li class="text-xs font-light uppercase tracking-widest leading-relaxed"><span data-i18n="footer.showroom" class="mb-1 block text-[10px] text-primary">Address</span>Jl. Ringroad Timur, Plumbon, Banguntapan, Kec. Banguntapan, Kabupaten Bantul, Daerah Istimewa Yogyakarta 55281, Indonesia</li>
        </ul>
      </div>

      <div>
        <h4 data-i18n="footer.follow" class="mb-6 text-[10px] font-bold uppercase tracking-[0.3em] text-primary">Follow Us</h4>
        <ul class="flex items-center space-x-5">
          <li><a class="social-link" href="https://www.facebook.com/tunebossid" aria-label="Facebook" rel="noreferrer"><FaFacebookF size={18} /></a></li>
          <li><a class="social-link" href="https://www.instagram.com/tuneboss.id" aria-label="Instagram" rel="noreferrer"><FaInstagram size={20} /></a></li>
          <li><a class="social-link" href="https://www.youtube.com/@tunebossid" aria-label="YouTube" rel="noreferrer"><FaYoutube size={22} /></a></li>
          <li><a class="social-link" href="https://www.tiktok.com/@tuneboss.id" aria-label="TikTok" rel="noreferrer"><FaTiktok size={18} /></a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between space-y-4 border-t border-primary/10 pt-8 md:flex-row md:space-y-0">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">&copy; 2026 TUNEBOSS.ID</p>
      <div class="flex space-x-6 md:pr-32">
        <a data-i18n="footer.privacy" class="tuneboss-link" href="/privacy">Privacy Policy</a>
        <a data-i18n="footer.terms" class="tuneboss-link" href="/terms">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .tuneboss-link {
    position: relative;
    display: inline-flex;
    padding-block: 0.25rem;
    font-size: 0.75rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    transition: color 0.3s;
  }

  .tuneboss-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--primary);
    transition: width 0.3s ease-out;
  }

  .tuneboss-link:hover {
    color: var(--primary);
  }

  .tuneboss-link:hover::after {
    width: 100%;
  }

  .drawer-account-link {
    transition: color 0.3s ease;
  }

  .drawer-account-link:hover {
    color: var(--primary);
  }

  .auth-dialog {
    inset: 0;
    margin: auto;
    max-height: min(90vh, 720px);
    overflow-y: auto;
    border-radius: 0.5rem;
    opacity: 0;
    transform: translateY(1rem) scale(0.96);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .auth-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .auth-dialog::backdrop {
    background: rgb(0 0 0 / 0.68);
    backdrop-filter: blur(10px);
  }

  .auth-input {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    border-radius: 0.375rem;
    background: transparent;
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .auth-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent);
  }

  .social-link {
    display: inline-flex;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .social-link:hover {
    color: var(--primary);
    transform: translateY(-2px);
  }

  .alert-toast {
    transform: translateY(-12px) scale(0.96);
    opacity: 0;
    border-radius: 0.5rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .alert-toast.is-visible {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
</style>

<script>
  let tuneBossChromeController;

  const initTuneBossChrome = () => {
  tuneBossChromeController?.abort();
  tuneBossChromeController = new AbortController();
  const { signal } = tuneBossChromeController;

  const root = document.documentElement;
  const navbar = document.querySelector("[data-navbar]");
  const menu = document.querySelector("[data-menu]");
  const panel = document.querySelector("[data-menu-panel]");
  const menuItems = document.querySelectorAll("[data-menu-item]");
  const openButtons = document.querySelectorAll("[data-menu-open]");
  const closeButtons = document.querySelectorAll("[data-menu-close]");
  const backTopButton = document.querySelector("[data-back-top]");
  const toastRoot = document.querySelector("[data-toast-root]");
  const cartDrawer = document.querySelector("[data-cart-drawer]");
  const cartPanel = document.querySelector("[data-cart-panel]");
  const cartBadge = document.querySelector("[data-cart-badge]");
  const cartItemsRoot = document.querySelector("[data-cart-items]");
  const cartSummary = document.querySelector("[data-cart-summary]");
  const cartTotal = document.querySelector("[data-cart-total]");
  const authDialogs = {
    login: document.querySelector('[data-auth-dialog="login"]'),
    register: document.querySelector('[data-auth-dialog="register"]'),
  };
  let authScrollY = 0;
  let cart = [];

  const copy = {
    id: {
      "nav.home": "Beranda",
      "nav.products": "Produk",
      "nav.cart": "Keranjang",
      "nav.tracking": "Lacak Pesanan",
      "account.title": "Akun",
      "account.signin": "Masuk",
      "account.create": "Buat Akun",
      "auth.loginTitle": "Masuk",
      "auth.loginCopy": "Masuk untuk melihat akun dan pesanan TuneBoss Anda.",
      "auth.registerTitle": "Buat Akun",
      "auth.registerCopy": "Buat akun untuk menyimpan pesanan dan detail TuneBoss Anda.",
      "auth.name": "Nama",
      "auth.email": "Email",
      "auth.password": "Kata Sandi",
      "auth.remember": "Ingat saya",
      "auth.forgot": "Lupa kata sandi?",
      "auth.signin": "Masuk",
      "auth.createAccount": "Buat Akun",
      "auth.backToSignin": "Kembali Masuk",
      "auth.or": "Atau",
      "auth.namePlaceholder": "Rider TuneBoss",
      "auth.emailPlaceholder": "hello@tuneboss.id",
      "auth.passwordPlaceholder": "Masukkan kata sandi",
      "auth.signinToast": "Masuk berhasil",
      "auth.signinToastCopy": "Anda sudah masuk ke TuneBoss.",
