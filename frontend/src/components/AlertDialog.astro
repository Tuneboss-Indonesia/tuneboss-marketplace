---
type Props = {
  id: string;
  title: string;
  description?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  tone?: "primary" | "danger";
  i18nTitle?: string;
  i18nDesc?: string;
  i18nConfirm?: string;
  i18nCancel?: string;
};

const { id, title, description, confirmLabel = "Confirm", cancelLabel = "Cancel", tone = "primary", i18nTitle, i18nDesc, i18nConfirm, i18nCancel } = Astro.props;
---

<dialog id={id} data-alert-dialog class={`alert-dialog m-auto w-[calc(100vw-2rem)] max-w-md rounded-lg border bg-background p-0 text-foreground shadow-2xl backdrop:bg-black/60 ${tone === "danger" ? "border-red-300 dark:border-red-700" : "border-green-300 dark:border-green-700"}`}>
  <div class="p-6">
    <div class="mb-5 flex items-start justify-between gap-6">
      <div class="flex gap-4">
        <div class={`mt-1 shrink-0 ${tone === "danger" ? "text-red-500" : "text-green-500"}`}>
          {tone === "danger" ? (
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
          ) : (
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.8 10.9a10 10 0 1 1-4.7-7.7" />
              <path d="m9 11 3 3L22 4" />
            </svg>
          )}
        </div>
        <div>
          <h2 class="text-lg font-semibold leading-tight" data-i18n={i18nTitle}>{title}</h2>
          {description && <p class="mt-2 text-sm leading-relaxed opacity-90" data-i18n={i18nDesc}>{description}</p>}
        </div>
      </div>
      <button data-dialog-close class="rounded-full p-1 text-2xl leading-none opacity-70 transition-opacity hover:opacity-100" type="button" aria-label="Close">x</button>
    </div>

    <div class="flex justify-end gap-3">
      <button data-dialog-close class="rounded-md border border-primary/20 px-5 py-3 text-xs font-bold uppercase tracking-widest transition-colors hover:border-primary hover:text-primary" type="button" data-i18n={i18nCancel}>{cancelLabel}</button>
      <button data-dialog-confirm class={`rounded-md px-5 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors ${tone === "danger" ? "bg-red-600 hover:bg-red-700" : "bg-primary hover:bg-[#c95b04]"}`} type="button" data-i18n={i18nConfirm}>{confirmLabel}</button>
    </div>
  </div>
</dialog>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const openButton = event.target.closest("[data-dialog-target]");
    if (openButton instanceof HTMLElement) {
      const dialog = document.getElementById(openButton.dataset.dialogTarget || "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    }

    const closeButton = event.target.closest("[data-dialog-close], [data-dialog-confirm]");
    if (closeButton instanceof HTMLElement) {
      closeButton.closest("dialog")?.close();
    }
  });
</script>

<style>
  .alert-dialog::backdrop {
    backdrop-filter: blur(10px);
  }
</style>
