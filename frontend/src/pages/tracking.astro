---
import TuneBossChrome from "@/components/TuneBossChrome.astro";

import { Search } from "lucide-react";
import "@/styles/global.css";
import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Lacak Pesanan ECU Motor & Tuning | TuneBoss ID"
  description="Lacak status pengiriman pesanan produk ECU motor, flash kit, dan aksesori tuning TuneBoss ID Anda secara real-time."
  titleKey="nav.tracking"
  keywords="lacak pesanan TuneBoss, resi pengiriman ECU, status pesanan TuneBoss"
/>

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-32 pt-32 md:px-12 md:pt-40">
    <section class="mx-auto max-w-2xl text-center">
      <!-- Title -->
      <h1 data-i18n="tracking.title" class="mb-4 font-display text-4xl uppercase md:text-6xl text-foreground">Track Order</h1>
      <p data-i18n="tracking.desc" class="mb-12 text-sm text-foreground/60 md:text-base leading-relaxed">
        Enter your order ID below to check the real-time status of your TuneBoss products.
      </p>

      <!-- Search Form -->
      <form class="relative mx-auto flex max-w-xl flex-col gap-4 sm:flex-row" id="tracking-form" novalidate>
        <div class="relative flex-grow">
          <Search size={18} strokeWidth={1.8} className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-primary" />
          <input 
            type="text" 
            id="order_id" 
            name="order_id" 
            data-i18n-placeholder="tracking.placeholder"
            placeholder="Order ID" 
            autocomplete="off"
            required
            class="h-14 w-full rounded-none border border-primary/20 bg-transparent pl-12 pr-4 text-sm font-medium transition-colors focus:border-primary focus:outline-none"
          />
        </div>
        <button 
          type="submit" 
          id="btn-track"
          class="flex h-14 shrink-0 items-center justify-center rounded-none border border-primary bg-primary px-8 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:border-[#c95b04] hover:bg-[#c95b04] hover:text-white"
        >
          <span data-i18n="tracking.btn">TRACK</span>
        </button>
      </form>

      <div class="mt-8 text-sm text-foreground/80" id="tracking-result">
        <!-- Result will be injected here -->
      </div>
    </section>
  </main>
</TuneBossChrome>

<script>
  import { z } from "zod";
  const apiUrl = (import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api").replace(/\/$/, "");

  document.addEventListener("astro:page-load", () => {
    // Simple client-side script for demonstration
    const form = document.getElementById('tracking-form');
    const input = document.getElementById('order_id') as HTMLInputElement;
    const result = document.getElementById('tracking-result');
    const btn = document.getElementById('btn-track');

    // Define Zod schema for order ID validation
  const orderIdSchema = z.string().min(1, { message: "ID Pesanan diperlukan." }).refine((value) => z.uuid().safeParse(value).success, { message: "tracking.zodError" });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const orderId = input?.value.trim();
    if (orderId !== undefined && result && btn) {
      
      // Validate using Zod
      const validationResult = orderIdSchema.safeParse(orderId);
      
      if (!validationResult.success) {
        // Show validation error
        const isEn = document.documentElement.lang === 'en';
        const errorKey = validationResult.error.issues[0].message;
        
        let errorMsg;
        if (errorKey === "tracking.zodError") {
            errorMsg = isEn ? "Invalid Order ID." : "ID Pesanan tidak valid.";
        } else {
          errorMsg = isEn ? "Order ID is required." : "ID Pesanan diperlukan.";
        }
        
        result.innerHTML = `<div class="animate-fade-in text-red-500 font-medium">${errorMsg}</div>`;
        return; // Stop execution
      }

      // Simulate loading state
      const textSpan = btn.querySelector('span');
      const originalText = textSpan ? textSpan.innerText : btn.innerText;
      const isEn = document.documentElement.lang === 'en';
      
      if (textSpan) textSpan.innerText = isEn ? 'SEARCHING...' : 'MENCARI...';
      btn.classList.add('opacity-80', 'cursor-not-allowed');
      
      try {
        const response = await fetch(`${apiUrl}/tracking/${encodeURIComponent(orderId)}`);
        const data = await response.json().catch(() => ({}));
        if (textSpan) textSpan.innerText = originalText;
        btn.classList.remove('opacity-80', 'cursor-not-allowed');
        if (!response.ok || !data.order) {
          throw new Error(data.message || "Pesanan tidak ditemukan.");
        }

        const orderTitle = isEn ? "Order" : "Pesanan";
        const tbProducts = isEn ? "TuneBoss Products" : "Produk TuneBoss";
        const orderPlaced = isEn ? "Order Placed" : "Pesanan Dibuat";
        const paidText = isEn ? "Payment Confirmed" : "Pembayaran Dikonfirmasi";
        const cancelledText = isEn ? "Order Cancelled / Failed" : "Pesanan Dibatalkan / Gagal";
        const processingText = isEn ? "Preparing Order" : "Pesanan Diproses";
        const doneText = isEn ? "Order Fulfilled" : "Pesanan Selesai";
        const order = data.order as { status: string; createdAt?: string; updatedAt?: string; items?: { name: string; quantity: number }[] };
        const status = order.status;
        const createdAt = order.createdAt ? new Date(order.createdAt).toLocaleString(isEn ? "en-US" : "id-ID") : "-";
        const updatedAt = order.updatedAt ? new Date(order.updatedAt).toLocaleString(isEn ? "en-US" : "id-ID") : "-";
        const products = (order.items || []).map((item) => `${item.quantity}x ${item.name}`).join("<br>") || tbProducts;
        const isPaid = status === "paid" || status === "fulfilled";
        const isCancelled = status === "cancelled";
        const isFulfilled = status === "fulfilled";

        // Shadcn-style Tracker HTML
        const CheckCircleIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>`;
        const XCircleIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`;
        const CircleIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>`;
        
        result.innerHTML = `
        <div class="animate-fade-in mx-auto w-full max-w-md text-left mt-4">
          <div class="flex items-start gap-4 py-6 border-b border-primary/20">
            <div class="flex flex-col">
              <h2 class="text-2xl font-bold text-foreground"><span data-i18n="tracking.order">${orderTitle}</span> ${orderId}</h2>
              <p class="text-sm font-medium uppercase text-muted-foreground mt-1">
                ${products}
              </p>
            </div>
          </div>

          <div class="space-y-6 py-8">
            <ul class="relative space-y-4">
              <li class="flex items-start gap-4 relative">
                <div class="relative flex flex-col items-center">
                  <div class="z-10 mt-1 flex h-8 w-8 items-center justify-center rounded-full bg-background text-green-500">
                    ${CheckCircleIcon}
                  </div>
                  <div class="absolute top-9 h-[calc(100%-1.5rem)] w-0.5 bg-green-500"></div>
                </div>
                <div class="flex-1 pb-6 pt-1.5">
                  <p class="text-sm text-muted-foreground mb-1">${createdAt}</p>
                  <p data-i18n="tracking.placed" class="text-lg font-semibold text-foreground">${orderPlaced}</p>
                </div>
              </li>
              
              <li class="flex items-start gap-4 relative">
                <div class="relative flex flex-col items-center">
                  <div class="z-10 mt-1 flex h-8 w-8 items-center justify-center rounded-full bg-background text-red-500">
                    ${isCancelled ? XCircleIcon : isPaid ? CheckCircleIcon : CircleIcon}
                  </div>
                  <div class="absolute top-9 h-[calc(100%-1.5rem)] w-0.5 bg-border"></div>
                </div>
                <div class="flex-1 pb-6 pt-1.5">
                  <p class="text-sm text-muted-foreground mb-1">${updatedAt}</p>
                  <p class="text-lg font-semibold text-foreground">${isCancelled ? cancelledText : paidText}</p>
                </div>
              </li>

              <li class="flex items-start gap-4 relative">
                <div class="relative flex flex-col items-center">
                  <div class="z-10 flex h-8 w-8 items-center justify-center rounded-full bg-background text-muted-foreground">
                     ${CircleIcon}
                  </div>
                  <div class="absolute top-8 h-[calc(100%-1rem)] w-0.5 bg-border"></div>
                </div>
                <div class="flex-1 pb-6">
                  <div class="flex h-8 items-center">
                    <p class="text-lg font-semibold ${isPaid ? "text-foreground" : "text-muted-foreground"} leading-none">${processingText}</p>
                  </div>
                </div>
              </li>

              <li class="flex items-start gap-4 relative">
                <div class="relative flex flex-col items-center">
                  <div class="z-10 flex h-8 w-8 items-center justify-center rounded-full bg-background text-muted-foreground">
                    ${CircleIcon}
                  </div>
                </div>
                <div class="flex-1 pb-2">
                  <div class="flex h-8 items-center">
                    <p class="text-lg font-semibold ${isFulfilled ? "text-foreground" : "text-muted-foreground"} leading-none">${doneText}</p>
                  </div>
                </div>
              </li>
            </ul>
          </div>
        </div>
        `;
      } catch {
        if (textSpan) textSpan.innerText = originalText;
        btn.classList.remove('opacity-80', 'cursor-not-allowed');
        const notFoundTitle = isEn ? "Order Not Found" : "Pesanan Tidak Ditemukan";
        const notFoundDesc = isEn ? "We couldn't find any active order matching" : "Kami tidak dapat menemukan pesanan aktif yang cocok dengan";
        result.innerHTML = `
          <div class="animate-fade-in mx-auto mt-16 flex max-w-md flex-col items-center justify-center py-10 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mb-6 text-primary/60"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="11" y1="8" x2="11" y2="12"/><line x1="11" y1="16" x2="11.01" y2="16"/></svg>
            <h3 data-i18n="tracking.notFoundTitle" class="mb-4 text-3xl font-bold text-foreground">${notFoundTitle}</h3>
            <p class="text-lg text-muted-foreground leading-relaxed"><span data-i18n="tracking.notFoundDesc">${notFoundDesc}</span> <br><strong class="text-primary mt-2 inline-block text-xl">${orderId}</strong></p>
          </div>`;
      }
    }
  });

  const savedOrderId = sessionStorage.getItem('tuneboss-tracking-id');
  if (savedOrderId && input && form) {
    input.value = savedOrderId;
    sessionStorage.removeItem('tuneboss-tracking-id');
    form.dispatchEvent(new Event('submit'));
  }
  });
</script>
