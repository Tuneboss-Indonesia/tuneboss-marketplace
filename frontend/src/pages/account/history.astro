---
import AccountLayout from "@/components/AccountLayout.astro";
import { Search, Filter, ChevronRight, Package, Clock, CheckCircle, XCircle, ChevronDown, X, Star } from "lucide-react";
import "@/styles/global.css";

export const prerender = false;
---

<AccountLayout title="Purchase History" activePath="/account/history" i18nTitleKey="account.history">
  <div class="w-full">
    
    <!-- Header -->
    <div class="mb-8">
      <h2 data-i18n="account.historyTitle" class="text-xl font-bold text-foreground uppercase tracking-widest">Riwayat Pembelian</h2>
      <p data-i18n="account.historyDesc" class="text-sm text-foreground/70 mt-1">Lacak status pesanan Anda dan lihat detail pembelian sebelumnya.</p>
    </div>

    <!-- Filters and Search -->
    <div class="mb-6 flex flex-col sm:flex-row gap-4 justify-between">
      <div class="relative w-full flex-1">
        <Search size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-foreground/50" />
        <input 
          id="history-search"
          type="text" 
          placeholder="Search by Order ID..."
          data-i18n-placeholder="account.searchOrder"
          class="w-full border border-primary/20 bg-transparent p-3 pl-12 outline-none transition-colors focus:border-primary text-foreground"
        />
      </div>
      
      <div class="w-full sm:w-48 shrink-0">
        <div data-select class="relative">
          <button data-select-button class="flex w-full items-center justify-between border border-primary/20 bg-background p-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:border-primary focus:border-primary focus:outline-none" type="button" aria-expanded="false">
            <span data-select-value data-i18n="history.filterAll">Semua Pesanan</span>
            <ChevronDown size={18} strokeWidth={2} className="text-primary" />
          </button>
          <div data-select-menu class="invisible absolute right-0 top-full z-[60] w-full min-w-48 border border-primary/20 bg-background opacity-0 shadow-xl transition-all duration-200">
            <button data-select-option="all" data-i18n="history.filterAll" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Semua Pesanan</button>
            <button data-select-option="pending" data-i18n="history.filterPending" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Menunggu</button>
            <button data-select-option="shipped" data-i18n="history.filterShipped" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Dikirim</button>
            <button data-select-option="delivered" data-i18n="history.filterDelivered" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Diterima</button>
            <button data-select-option="cancelled" data-i18n="history.filterCancelled" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Dibatalkan</button>
            <button data-select-option="expired" data-i18n="history.filterExpired" class="block w-full px-4 py-3 text-left text-xs font-bold uppercase tracking-widest text-foreground transition-colors hover:bg-primary hover:text-background" type="button">Kedaluwarsa</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Orders List -->
    <div class="space-y-4">
      
      <!-- Order 1: Delivered -->
      <a href="/tracking" data-tracking-id="INV-2610-TB99" class="tracking-link group block border border-primary/20 bg-background p-5 transition-all hover:border-primary hover:shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-foreground">INV-2610-TB99</span>
              <span class="flex items-center gap-1 bg-green-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-green-600 dark:text-green-400">
                <CheckCircle size={12} /> <span data-i18n="history.filterDelivered">Delivered</span>
              </span>
            </div>
            <p class="text-xs text-muted-foreground">10 Jan 2026, 10:40</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-sm text-muted-foreground mb-1" data-i18n="history.totalAmount">Total Amount</p>
            <p class="font-bold text-foreground">Rp 3.500.000</p>
          </div>
        </div>
        <hr class="border-border/50 mb-4" />
        <div class="flex items-center justify-between">
          <div class="flex items-start gap-3">
            <div class="flex shrink-0 items-start pt-0.5 text-muted-foreground">
              <Package size={20} />
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-sm font-medium text-foreground">1x TuneBoss ECU</p>
              <p class="text-sm font-medium text-foreground">1x TuneBoss Quickshifter</p>
              <p class="text-sm font-medium text-foreground">1x TuneBoss Shift Light</p>
              <p class="text-xs text-muted-foreground mt-1" data-i18n="history.deliveredOn">Delivered on 14 Jan 2026</p>
            </div>
          </div>
          <ChevronRight size={20} className="text-muted-foreground group-hover:text-primary transition-colors mt-2" />
        </div>
        <hr class="border-border/50 my-4" />
        <div class="flex items-center justify-end">
          <button onclick="event.preventDefault();" data-order-id="INV-2610-TB99" data-products='["TuneBoss ECU", "TuneBoss Quickshifter", "TuneBoss Shift Light"]' class="btn-review border border-primary bg-transparent px-5 py-2.5 text-xs font-bold uppercase tracking-widest text-primary transition-colors hover:bg-primary hover:text-white" data-i18n="history.giveReview">
            Beri Review
          </button>
        </div>
      </a>

      <!-- Order 2: Shipped -->
      <a href="/tracking" data-tracking-id="INV-2701-TB10" class="tracking-link group block border border-primary/20 bg-background p-5 transition-all hover:border-primary hover:shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-foreground">INV-2701-TB10</span>
              <span class="flex items-center gap-1 bg-blue-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">
                <Package size={12} /> <span data-i18n="history.filterShipped">Shipped</span>
              </span>
            </div>
            <p class="text-xs text-muted-foreground">27 Jan 2026, 14:15</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-sm text-muted-foreground mb-1" data-i18n="history.totalAmount">Total Amount</p>
            <p class="font-bold text-foreground">Rp 1.250.000</p>
          </div>
        </div>
        <hr class="border-border/50 mb-4" />
        <div class="flex items-center justify-between">
          <div class="flex items-start gap-3">
            <div class="flex shrink-0 items-start pt-0.5 text-muted-foreground">
              <Package size={20} />
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-sm font-medium text-foreground">1x TuneBoss Quickshifter</p>
              <p class="text-xs text-muted-foreground mt-1" data-i18n="history.estimatedDelivery">Estimated Delivery: 30 Jan 2026</p>
            </div>
          </div>
          <ChevronRight size={20} className="text-muted-foreground group-hover:text-primary transition-colors mt-2" />
        </div>
        <hr class="border-border/50 my-4" />
        <div class="flex items-center justify-end">
          <button onclick="event.preventDefault();" class="bg-primary px-5 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-primary/90" data-i18n="history.orderReceived">
            Pesanan Diterima
          </button>
        </div>
      </a>

      <!-- Order 3: Pending -->
      <a href="/tracking" data-tracking-id="INV-2805-TB44" class="tracking-link group block border border-primary/20 bg-background p-5 transition-all hover:border-primary hover:shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-foreground">INV-2805-TB44</span>
              <span class="flex items-center gap-1 bg-orange-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-orange-600 dark:text-orange-400">
                <Clock size={12} /> <span data-i18n="history.pendingPayment">Pending Payment</span>
              </span>
            </div>
            <p class="text-xs text-muted-foreground">28 Jan 2026, 09:30</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-sm text-muted-foreground mb-1" data-i18n="history.totalAmount">Total Amount</p>
            <p class="font-bold text-foreground">Rp 850.000</p>
          </div>
        </div>
        <hr class="border-border/50 mb-4" />
        <div class="flex items-center justify-between">
          <div class="flex items-start gap-3">
            <div class="flex shrink-0 items-start pt-0.5 text-muted-foreground">
              <Package size={20} />
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-sm font-medium text-foreground">1x TuneBoss Shift Light</p>
              <p class="text-xs text-muted-foreground text-orange-500 mt-1" data-i18n="history.awaitingPayment">Awaiting your payment</p>
            </div>
          </div>
          <ChevronRight size={20} className="text-muted-foreground group-hover:text-primary transition-colors mt-2" />
        </div>
        <hr class="border-border/50 my-4" />
        <div class="flex items-center justify-end">
          <button onclick="event.preventDefault(); window.location.href='/checkout/INV-2805-TB44?status=pending';" class="bg-primary px-5 py-2.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-primary/90" data-i18n="history.payNow">
            Bayar Sekarang
          </button>
        </div>
      </a>

      <!-- Order 4: Cancelled -->
      <a href="/tracking" data-tracking-id="INV-0101-TB01" class="tracking-link group block border border-primary/20 bg-background p-5 opacity-60 grayscale transition-all hover:border-red-500/50 hover:shadow-md hover:grayscale-0 hover:opacity-100">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-foreground">INV-0101-TB01</span>
              <span class="flex items-center gap-1 bg-red-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-red-600 dark:text-red-400">
                <XCircle size={12} /> <span data-i18n="history.filterCancelled">Cancelled</span>
              </span>
            </div>
            <p class="text-xs text-muted-foreground">1 Jan 2026, 12:00</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-sm text-muted-foreground mb-1" data-i18n="history.totalAmount">Total Amount</p>
            <p class="font-bold text-foreground line-through">Rp 2.100.000</p>
          </div>
        </div>
        <hr class="border-border/50 mb-4" />
        <div class="flex items-center justify-between">
          <div class="flex items-start gap-3">
            <div class="flex shrink-0 items-start pt-0.5 text-muted-foreground">
              <Package size={20} />
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-sm font-medium text-foreground">2x TuneBoss Merch Bundle</p>
              <p class="text-xs text-muted-foreground mt-1" data-i18n="history.cancelledByUser">Cancelled by User</p>
            </div>
          </div>
          <ChevronRight size={20} className="text-muted-foreground group-hover:text-primary transition-colors" />
        </div>
      </a>

      <!-- Order 5: Expired -->
      <a href="/tracking" data-tracking-id="INV-1212-TB55" class="tracking-link group block border border-primary/20 bg-background p-5 opacity-60 grayscale transition-all hover:border-gray-500/50 hover:shadow-md hover:grayscale-0 hover:opacity-100">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-foreground">INV-1212-TB55</span>
              <span class="flex items-center gap-1 bg-gray-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest text-gray-600 dark:text-gray-400">
                <Clock size={12} /> <span data-i18n="history.filterExpired">Expired</span>
              </span>
            </div>
            <p class="text-xs text-muted-foreground">12 Dec 2025, 08:00</p>
          </div>
          <div class="text-left sm:text-right">
            <p class="text-sm text-muted-foreground mb-1" data-i18n="history.totalAmount">Total Amount</p>
            <p class="font-bold text-foreground line-through">Rp 450.000</p>
          </div>
        </div>
        <hr class="border-border/50 mb-4" />
        <div class="flex items-center justify-between">
          <div class="flex items-start gap-3">
            <div class="flex shrink-0 items-start pt-0.5 text-muted-foreground">
              <Package size={20} />
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-sm font-medium text-foreground">1x TuneBoss Diagnostic Cable</p>
              <p class="text-xs text-muted-foreground mt-1" data-i18n="history.paymentExpired">Payment time expired</p>
            </div>
          </div>
          <ChevronRight size={20} className="text-muted-foreground group-hover:text-primary transition-colors" />
        </div>
      </a>

    </div>
  </div>

  <!-- Review Modal -->
  <div id="review-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="w-full max-w-lg bg-background p-6 shadow-xl border border-primary/20 scale-95 transition-transform duration-300 max-h-full flex flex-col" id="review-modal-content">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold font-display" id="review-modal-title" data-i18n="history.giveReview">Beri Review</h3>
        <button id="close-review-modal" class="text-muted-foreground hover:text-primary transition-colors">
          <X size={24} />
        </button>
      </div>
      <p class="text-sm text-muted-foreground mb-4">Order ID: <span id="review-order-id" class="font-bold text-foreground"></span></p>
      
      <div id="review-products-container" class="space-y-6 max-h-[60vh] overflow-y-auto pr-2">
        <!-- Products will be injected here -->
      </div>
      
      <div class="mt-6 flex justify-end gap-3">
        <button id="btn-cancel-review" data-i18n="history.cancelReview" class="px-5 py-2.5 text-sm font-bold uppercase tracking-widest text-foreground hover:bg-black/5 dark:hover:bg-white/5 transition-colors">Batal</button>
        <button id="btn-save-review" data-i18n="history.saveReview" class="bg-primary px-5 py-2.5 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-primary/90">Simpan Review</button>
      </div>
    </div>
  </div>
</AccountLayout>

<script>
  import { z } from "zod";

  document.addEventListener('DOMContentLoaded', () => {
    const lang = document.documentElement.lang || 'id';
    const messages = {
      id: {
        invalidId: "Order ID hanya boleh berisi huruf, angka, dan strip"
      },
      en: {
        invalidId: "Order ID can only contain letters, numbers, and dashes"
      }
    };
    const m = messages[lang] || messages.id;

    const items = document.querySelectorAll('a[href^="/tracking?id="]');
    const searchInput = document.getElementById("history-search") as HTMLInputElement;

    function handleSearch() {
      const q = searchInput?.value.toLowerCase().trim() || "";
      let found = false;
      const errorMsgEl = document.getElementById('search-error-msg');
      
      if (errorMsgEl) errorMsgEl.remove();

      if (q.length > 0 && !z.string().regex(/^[a-zA-Z0-9-]+$/).safeParse(q).success) {
        if(searchInput) {
           const error = document.createElement('p');
           error.id = 'search-error-msg';
           error.className = 'absolute -bottom-6 left-0 text-xs text-red-500 animate-fade-in';
           error.innerText = m.invalidId;
           searchInput.parentNode?.appendChild(error);
        }
        return;
      }

      items.forEach(item => {
        const idText = item.querySelector('.font-bold')?.textContent?.toLowerCase() || "";
        const matches = idText.includes(q);
        if (matches) {
           (item as HTMLElement).style.display = 'block';
           found = true;
        } else {
           (item as HTMLElement).style.display = 'none';
        }
      });
    }

    searchInput?.addEventListener('input', handleSearch);

    // Select dropdown logic
    document.querySelectorAll("[data-select]").forEach((select) => {
      const trigger = select.querySelector("[data-select-button]");
      const menu = select.querySelector("[data-select-menu]");
      const value = select.querySelector("[data-select-value]");
      const setOpen = (open: boolean) => {
        trigger?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("visible", open);
        menu?.classList.toggle("opacity-100", open);
        menu?.classList.toggle("invisible", !open);
        menu?.classList.toggle("opacity-0", !open);
      };

      trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
      select.querySelectorAll("[data-select-option]").forEach((option) => {
        option.addEventListener("click", () => {
          if (value) {
            value.textContent = option.textContent;
            const i18nKey = option.getAttribute("data-i18n");
            if (i18nKey) value.setAttribute("data-i18n", i18nKey);
          }
          setOpen(false);
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || event.target.closest("[data-select]")) return;
      document.querySelectorAll("[data-select-button]").forEach((button) => button.setAttribute("aria-expanded", "false"));
      document.querySelectorAll("[data-select-menu]").forEach((menu) => {
        menu.classList.remove("visible", "opacity-100");
        menu.classList.add("invisible", "opacity-0");
      });
    });

    // Review Modal Logic
    const reviewModal = document.getElementById('review-modal');
    const reviewModalContent = document.getElementById('review-modal-content');
    const closeReviewModalBtn = document.getElementById('close-review-modal');
    const btnCancelReview = document.getElementById('btn-cancel-review');
    const btnSaveReview = document.getElementById('btn-save-review');
    const reviewProductsContainer = document.getElementById('review-products-container');
    const reviewOrderIdEl = document.getElementById('review-order-id');
    const reviewButtons = document.querySelectorAll('.btn-review');
    const isEn = lang === 'en';

    let currentReviewOrderId = '';

    const StarIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;

    function openReviewModal(orderId: string, products: string[]) {
      const currentIsEn = document.documentElement.lang === 'en';
      currentReviewOrderId = orderId;
      if (reviewOrderIdEl) reviewOrderIdEl.textContent = orderId;
      if (reviewProductsContainer) {
        reviewProductsContainer.innerHTML = '';
        
        const savedData = localStorage.getItem('tuneboss-reviews-' + orderId);
        const existingReviews = savedData ? JSON.parse(savedData) : {};
        
        const modalTitleEl = document.getElementById('review-modal-title');
        if (modalTitleEl) {
          if (savedData) {
            modalTitleEl.setAttribute('data-i18n', 'history.viewReview');
            modalTitleEl.textContent = currentIsEn ? 'View Review' : 'Lihat Review';
          } else {
            modalTitleEl.setAttribute('data-i18n', 'history.giveReview');
            modalTitleEl.textContent = currentIsEn ? 'Give Review' : 'Beri Review';
          }
        }

        products.forEach((product, idx) => {
          const prodData = existingReviews[product] || { rating: 5, text: '' };
          
          const prodDiv = document.createElement('div');
          prodDiv.className = 'border-b border-border/50 pb-4 last:border-0 last:pb-0';
          prodDiv.innerHTML = `
            <p class="font-bold text-foreground mb-2">${product}</p>
            <div class="flex gap-2 mb-3 star-rating" data-product="${product}">
              ${[1,2,3,4,5].map(i => `
                <button type="button" data-rating="${i}" class="star-btn transition-colors ${i <= prodData.rating ? 'text-orange-500 fill-orange-500' : 'text-muted-foreground'}">
                  ${StarIcon}
                </button>
              `).join('')}
            </div>
            <textarea class="review-text w-full bg-background border border-primary/20 p-3 text-sm focus:border-primary focus:outline-none transition-colors" rows="3" data-i18n-placeholder="history.reviewPlaceholder" placeholder="${currentIsEn ? 'Write your review here...' : 'Tulis ulasan Anda di sini...'}">${prodData.text}</textarea>
          `;
          reviewProductsContainer.appendChild(prodDiv);
        });

        const starContainers = reviewProductsContainer.querySelectorAll('.star-rating');
        starContainers.forEach(container => {
          const stars = container.querySelectorAll('.star-btn');
          stars.forEach(star => {
            star.addEventListener('click', (e) => {
              const rating = parseInt((e.currentTarget as HTMLButtonElement).dataset.rating || '5');
              container.setAttribute('data-current-rating', rating.toString());
              stars.forEach((s, idx) => {
                if (idx < rating) {
                  s.classList.add('text-orange-500');
                  s.querySelector('svg')?.setAttribute('fill', 'currentColor');
                  s.classList.remove('text-muted-foreground');
                } else {
                  s.classList.remove('text-orange-500');
                  s.querySelector('svg')?.setAttribute('fill', 'none');
                  s.classList.add('text-muted-foreground');
                }
              });
            });
            const isFilled = star.classList.contains('text-orange-500');
            if(isFilled) {
                star.querySelector('svg')?.setAttribute('fill', 'currentColor');
            }
          });
          const initialRating = container.querySelectorAll('.text-orange-500').length;
          container.setAttribute('data-current-rating', initialRating.toString() || '5');
        });
      }

      if (reviewModal && reviewModalContent) {
        reviewModal.classList.remove('opacity-0', 'pointer-events-none');
        reviewModalContent.classList.remove('scale-95');
        reviewModalContent.classList.add('scale-100');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeReviewModal() {
      if (reviewModal && reviewModalContent) {
        reviewModal.classList.add('opacity-0', 'pointer-events-none');
        reviewModalContent.classList.remove('scale-100');
        reviewModalContent.classList.add('scale-95');
        document.body.style.overflow = '';
      }
    }

    reviewButtons.forEach(btn => {
      const orderId = btn.getAttribute('data-order-id');
      if(orderId) {
          const savedData = localStorage.getItem('tuneboss-reviews-' + orderId);
          if (savedData) {
            btn.setAttribute('data-i18n', 'history.viewReview');
            btn.textContent = isEn ? 'View Review' : 'Lihat Review';
          }

          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productsAttr = btn.getAttribute('data-products');
            let products: string[] = [];
            try {
              products = productsAttr ? JSON.parse(productsAttr) : [];
            } catch (err) {}
            openReviewModal(orderId, products);
          });
      }
    });

    closeReviewModalBtn?.addEventListener('click', closeReviewModal);
    btnCancelReview?.addEventListener('click', closeReviewModal);

    btnSaveReview?.addEventListener('click', () => {
      const currentIsEn = document.documentElement.lang === 'en';
      if (!currentReviewOrderId || !reviewProductsContainer) return;
      
      const reviewsData: Record<string, any> = {};
      const prodDivs = reviewProductsContainer.children;
      let hasError = false;
      
      reviewProductsContainer.querySelectorAll('.zod-error').forEach(el => el.remove());
      
      Array.from(prodDivs).forEach(div => {
        const starContainer = div.querySelector('.star-rating');
        const product = starContainer?.getAttribute('data-product') || '';
        const rating = parseInt(starContainer?.getAttribute('data-current-rating') || '5');
        const textarea = div.querySelector('.review-text') as HTMLTextAreaElement;
        const text = textarea?.value.trim() || '';
        
        if (text.length < 10) {
          hasError = true;
          const msg = document.createElement('p');
          msg.className = "zod-error text-[11px] font-medium text-red-500 mt-1.5 px-1";
          msg.textContent = currentIsEn ? "Review is required (min. 10 characters)" : "Ulasan wajib diisi (minimal 10 karakter)";
          msg.setAttribute('data-i18n', 'history.reviewRequired');
          textarea.parentElement?.appendChild(msg);
        }
        
        if (product) {
          reviewsData[product] = { rating, text };
        }
      });

      if (hasError) return;

      localStorage.setItem('tuneboss-reviews-' + currentReviewOrderId, JSON.stringify(reviewsData));
      
      const btn = document.querySelector(`.btn-review[data-order-id="${currentReviewOrderId}"]`);
      if (btn) {
        btn.setAttribute('data-i18n', 'history.viewReview');
        btn.textContent = currentIsEn ? 'View Review' : 'Lihat Review';
      }
      
      closeReviewModal();
    });

    const trackingLinks = document.querySelectorAll('.tracking-link');
    trackingLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        // Only intercept if we didn't click inside a button (like 'Beri Review' or 'Pesanan Diterima')
        const target = e.target as HTMLElement;
        if (target.closest('button')) return;
        
        e.preventDefault();
        const trackingId = link.getAttribute('data-tracking-id');
        if (trackingId) {
          sessionStorage.setItem('tuneboss-tracking-id', trackingId);
          window.location.href = '/tracking';
        }
      });
    });
  });
</script>
