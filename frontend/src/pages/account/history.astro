---
import AccountLayout from "@/components/AccountLayout.astro";
import OrderHistoryWrapper from "@/components/OrderHistoryList.tsx";
import "@/styles/global.css";

export const prerender = false;
---

<AccountLayout title="Purchase History" activePath="/account/history" i18nTitleKey="account.history">
  <div class="w-full">
    
    <!-- Header -->
    <div class="mb-8">
      <h2 data-i18n="account.historyTitle" class="text-xl font-bold text-foreground uppercase tracking-widest">Riwayat Pembelian</h2>
      <p data-i18n="account.historyDesc" class="text-sm text-foreground/70 mt-1">Lacak status pesanan Anda dan lihat detail pembelian sebelumnya.</p>
    </div>

    <!-- Orders List -->
    <div class="space-y-4">
      <OrderHistoryWrapper client:load />
    </div>
  </div>
</AccountLayout>
