---
import AccountLayout from "@/components/AccountLayout.astro";
import AlertDialog from "@/components/AlertDialog.astro";
import { Plus } from "lucide-react";
import "@/styles/global.css";

export const prerender = false;
---

<AccountLayout title="Addresses" activePath="/account/address" i18nTitleKey="account.address">
  <div class="w-full">
    
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div>
        <h2 data-i18n="account.addressTitle" class="text-xl font-bold text-foreground uppercase tracking-widest">Alamat Tersimpan</h2>
        <p data-i18n="account.addressDesc" class="text-sm text-foreground/70 mt-1">Kelola alamat pengiriman dan penagihan Anda.</p>
      </div>
      <button id="btn-add-address" class="flex items-center justify-center gap-3 bg-primary px-6 py-3 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-[#c95b04]">
        <Plus size={16} />
        <span data-i18n="account.addAddress">Tambah Alamat</span>
      </button>
    </div>

    <!-- Address List -->
    <div class="grid gap-4">
      <!-- Primary Address -->
      <div class="border border-primary/20 bg-background p-6">
        <div class="flex-1 text-sm text-foreground/80">
          <div class="flex flex-wrap items-center justify-between mb-3 gap-2">
            <div class="font-bold text-foreground flex items-center flex-wrap gap-y-2">
              <h3 class="font-bold uppercase tracking-widest text-sm text-foreground">TuneBoss User</h3>
              <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2">(+62) 817-5792-805</span>
            </div>
            <div class="flex gap-4">
              <button type="button" class="btn-edit-address text-primary font-bold hover:underline shrink-0 uppercase tracking-widest text-xs" data-i18n="account.editBtn">Ubah</button>
              <button type="button" data-dialog-target="delete-address-dialog" class="btn-delete-address text-red-500 font-bold hover:underline shrink-0 uppercase tracking-widest text-xs" data-i18n="account.deleteBtn">Hapus</button>
            </div>
          </div>
          <p class="leading-relaxed">Jl. Ringroad Timur, Plumbon, Banguntapan, Kec. Banguntapan<br/>Kabupaten Bantul, Daerah Istimewa Yogyakarta 55281, Indonesia</p>
        </div>
      </div>

      <!-- Secondary Address -->
      <div class="border border-primary/20 bg-background p-6">
        <div class="flex-1 text-sm text-foreground/80">
          <div class="flex flex-wrap items-center justify-between mb-3 gap-2">
            <div class="font-bold text-foreground flex items-center flex-wrap gap-y-2">
              <h3 class="font-bold uppercase tracking-widest text-sm text-foreground">TuneBoss Office</h3>
              <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2">(+62) 812-3456-7890</span>
            </div>
            <div class="flex gap-4">
              <button type="button" class="btn-edit-address text-primary font-bold hover:underline shrink-0 uppercase tracking-widest text-xs" data-i18n="account.editBtn">Ubah</button>
              <button type="button" data-dialog-target="delete-address-dialog" class="btn-delete-address text-red-500 font-bold hover:underline shrink-0 uppercase tracking-widest text-xs" data-i18n="account.deleteBtn">Hapus</button>
            </div>
          </div>
          <p class="leading-relaxed">Gedung TuneBoss Lt. 2, Jl. Jend. Sudirman No. 123<br/>Jakarta Selatan 12190, Indonesia</p>
        </div>
      </div>

    </div>

  </div>

  <AlertDialog 
    id="delete-address-dialog"
    title="Konfirmasi Hapus"
    description="Apakah Anda yakin ingin menghapus alamat ini?"
    confirmLabel="Hapus"
    cancelLabel="Batal"
    tone="danger"
    i18nTitle="account.deleteConfirmTitle"
    i18nDesc="account.deleteConfirmDesc"
    i18nConfirm="account.deleteConfirmBtn"
    i18nCancel="account.deleteCancelBtn"
  />

</AccountLayout>

<!-- Address Form Modal -->
<div id="address-form-modal" class="fixed inset-0 z-[110] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
  <div class="bg-background border border-primary/20 max-w-2xl w-full max-h-[calc(100dvh-2rem)] overflow-y-auto p-6 md:p-8 relative scale-95 transition-transform duration-300 shadow-2xl">
    <button type="button" id="address-form-close" class="absolute right-4 top-4 text-foreground/50 hover:text-primary transition-colors" aria-label="Tutup">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <h3 id="address-form-title" class="mb-7 text-2xl font-bold text-foreground" data-i18n="address.newAddress">Alamat Baru</h3>
    <form class="space-y-5" onsubmit="return false;">
      <div class="grid gap-5 md:grid-cols-2">
        <div class="flex flex-col gap-1.5 w-full">
          <input id="address-form-name" class="w-full border border-primary/20 bg-transparent p-4 outline-none transition-colors focus:border-primary text-foreground" data-i18n-placeholder="account.name" placeholder="Nama Lengkap" />
        </div>
        <div class="flex flex-col gap-1.5 w-full">
          <input id="address-form-phone" class="w-full border border-primary/20 bg-transparent p-4 outline-none transition-colors focus:border-primary text-foreground" inputmode="numeric" pattern="[0-9]*" data-i18n-placeholder="account.phone" placeholder="Nomor Telepon" />
        </div>
      </div>
      <div class="flex flex-col gap-1.5 w-full">
        <div class="relative" id="address-region-picker">
          <button type="button" class="w-full border border-primary/20 bg-transparent p-4 flex items-center justify-between text-left text-foreground/60">
            <span data-i18n="address.region">Kecamatan / Kelurahan, Provinsi, Kode Pos</span>
            <svg class="h-4 w-4 shrink-0 text-foreground/60" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 w-full">
        <div class="relative" id="address-street-picker">
          <button type="button" class="w-full border border-primary/20 bg-transparent p-4 flex items-center justify-between text-left text-foreground/60 opacity-50 cursor-not-allowed" disabled>
            <span class="truncate mr-2" data-i18n="address.street">Pilih Jalan, Gedung, Perumahan</span>
            <svg class="h-4 w-4 shrink-0 text-foreground/60" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 w-full">
        <input class="w-full border border-primary/20 bg-transparent p-4 outline-none transition-colors focus:border-primary text-foreground" data-i18n-placeholder="address.details" placeholder="Detail Lainnya (Cth: Blok / Unit No., Patokan)" />
      </div>
      <div id="address-map-preview" class="relative flex min-h-64 items-center justify-center overflow-hidden border border-primary/10 bg-primary/5 text-foreground/40">
        <button type="button" class="z-10 border-2 px-5 py-3 font-bold flex items-center gap-2 shadow-sm transition-all border-primary bg-background text-primary opacity-50 cursor-not-allowed" disabled>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span data-i18n="address.detectLocation">Deteksi Lokasi</span>
        </button>
      </div>
      <button type="submit" id="btn-save-address" data-i18n="address.saveBtn" class="w-full bg-primary px-6 py-3 font-bold uppercase tracking-widest text-white hover:bg-[#c95b04]">Simpan Alamat</button>
    </form>
  </div>
</div>

<script>
  import { z } from "zod";
  
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('address-form-modal');
    const closeBtn = document.getElementById('address-form-close');
    const title = document.getElementById('address-form-title');
    const saveBtn = document.getElementById('btn-save-address');
    
    const openModal = (isEdit: boolean) => {
      if (modal) {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const inner = modal.firstElementChild;
        if (inner) inner.classList.remove('scale-95');
        if (title) {
          title.setAttribute('data-i18n', isEdit ? 'address.editAddress' : 'address.newAddress');
          const lang = document.documentElement.lang || 'id';
          if (isEdit) {
            title.textContent = lang === 'en' ? 'Edit Address' : 'Ubah Alamat';
          } else {
            title.textContent = lang === 'en' ? 'New Address' : 'Alamat Baru';
          }
        }
        document.body.style.overflow = 'hidden';
      }
    };

    const closeModal = () => {
      if (modal) {
        modal.classList.add('opacity-0', 'pointer-events-none');
        const inner = modal.firstElementChild;
        if (inner) inner.classList.add('scale-95');
        document.body.style.overflow = '';
      }
    };

    const btnAdd = document.getElementById('btn-add-address');
    if (btnAdd) {
      btnAdd.addEventListener('click', () => openModal(false));
    }

    const btnsEdit = document.querySelectorAll('.btn-edit-address');
    btnsEdit.forEach(btn => {
      btn.addEventListener('click', () => openModal(true));
    });

    const deleteDialog = document.getElementById('delete-address-dialog');
    if (deleteDialog) {
      const confirmBtn = deleteDialog.querySelector('[data-dialog-confirm]');
      if (confirmBtn) {
        confirmBtn.addEventListener('click', () => {
          const lang = document.documentElement.lang || 'id';
          const successMsg = lang === 'en' ? 'Address deleted successfully! (Simulation)' : 'Alamat berhasil dihapus! (Hanya simulasi)';
          alert(successMsg);
        });
      }
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    
    if (saveBtn) {
      const lang = document.documentElement.lang || 'id';
      const messages = {
        id: {
          nameMin: "Nama minimal 3 karakter",
          phoneMin: "Nomor telepon tidak valid",
          provReq: "Pilih wilayah pengiriman",
          streetMin: "Alamat/nama jalan terlalu pendek",
          mapReq: "Wajib Deteksi Lokasi di peta"
        },
        en: {
          nameMin: "Name must be at least 3 characters",
          phoneMin: "Invalid phone number",
          provReq: "Select delivery region",
          streetMin: "Street address is too short",
          mapReq: "Location detection on map is required"
        }
      };
      const m = messages[lang as keyof typeof messages] || messages.id;

      const addressSchema = z.object({
        name: z.string().min(3, { message: m.nameMin }),
        phone: z.string().min(9, { message: m.phoneMin }),
        province: z.string().min(1, { message: m.provReq }),
        street: z.string().min(5, { message: m.streetMin }),
        lat: z.string().min(1, { message: m.mapReq }),
        lon: z.string().min(1, { message: m.mapReq }),
      });

      saveBtn.addEventListener('click', () => {
        document.querySelectorAll(".zod-error").forEach(el => el.remove());
        
        const nameInput = document.getElementById("address-form-name") as HTMLInputElement;
        const phoneInput = document.getElementById("address-form-phone") as HTMLInputElement;
        
        const data = {
          name: nameInput?.value.trim() || "",
          phone: phoneInput?.value.trim() || "",
          province: "",
          street: "",
          lat: "",
          lon: "",
        };
        
        const result = addressSchema.safeParse(data);
        if (!result.success) {
          result.error.issues.forEach(issue => {
            const msg = document.createElement("p");
            msg.className = "zod-error text-[11px] font-medium text-red-500 mt-1.5 px-1";
            msg.textContent = issue.message;
            if (issue.path[0] === "name" && nameInput) nameInput.parentElement?.appendChild(msg);
            if (issue.path[0] === "phone" && phoneInput) phoneInput.parentElement?.appendChild(msg);
            if (issue.path[0] === "province") {
              const picker = document.getElementById("address-region-picker");
              if (picker) picker.parentElement?.appendChild(msg);
            }
            if (issue.path[0] === "street") {
              const picker = document.getElementById("address-street-picker");
              if (picker) picker.parentElement?.appendChild(msg);
            }
            if (issue.path[0] === "lat" || issue.path[0] === "lon") {
              const mapPreview = document.getElementById("address-map-preview");
              if (mapPreview && !document.getElementById("map-error-msg")) {
                msg.id = "map-error-msg";
                msg.classList.add("text-center", "w-full", "mb-2");
                mapPreview.insertAdjacentElement("afterend", msg);
              }
            }
          });
          return;
        }

        closeModal();
        alert('Data alamat berhasil disimpan! (Hanya simulasi)');
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
  });
</script>
