---
import { Image } from "astro:assets";

import { ChevronDown, ChevronLeft, ChevronRight, Share2, ShoppingCart, Star, Tag, X } from "lucide-react";
import ProductCard from "@/components/ProductCard.astro";
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import ecuImage from "../../../public/images/tuneboss-motorcycle-ecu.png";
import "@/styles/global.css";

export function getStaticPaths() {
  const slugify = (value: string) =>
    String(value)
      .toLowerCase()
      .replace(/&/g, "and")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const products = [
  {
    id: 1,
    brand: "Honda",
    name: "Motorcycle ECU",
    price: "Rp. 599.000",
    stock: 14,
    shipping: "Rp. 25.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description:
      "TuneBoss Motorcycle ECU dibuat untuk tuning mesin yang lebih presisi, respons gas lebih tajam, dan kontrol performa yang aman untuk harian maupun track day.",
    tags: ["ECU", "Plug-and-play", "Street & track", "Real-time data"],
  },
  {
    id: 2,
    brand: "Yamaha",
    name: "ECU Flash Kit",
    price: "Rp. 299.000",
    stock: 20,
    shipping: "Rp. 20.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Kit flash untuk update map ECU dengan proses yang rapi, cepat, dan cocok untuk kebutuhan bengkel maupun pengguna rumahan.",
    tags: ["Flash kit", "Fast setup", "USB ready", "Stable map"],
  },
  {
    id: 3,
    brand: "Kawasaki",
    name: "Race Tuning Pack",
    price: "Rp. 449.000",
    stock: 8,
    shipping: "Rp. 25.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Paket tuning untuk setup balap dengan fokus pada akselerasi, kontrol limiter, dan data performa yang mudah dipantau.",
    tags: ["Race", "Track-ready", "Limiter", "Performance"],
  },
  {
    id: 4,
    brand: "Suzuki",
    name: "Street Tune Pack",
    price: "Rp. 349.000",
    stock: 16,
    shipping: "Rp. 20.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Setup tuning harian yang menjaga motor tetap nyaman dipakai, lebih responsif, dan aman setelah modifikasi ringan.",
    tags: ["Street", "Daily", "Smooth response", "Safe tune"],
  },
  {
    id: 5,
    brand: "Honda",
    name: "Quickshifter Module",
    price: "Rp. 249.000",
    stock: 11,
    shipping: "Rp. 18.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Modul quickshifter untuk perpindahan gigi lebih cepat dengan feel mekanis yang konsisten.",
    tags: ["Quickshift", "Sport", "Precision", "Module"],
  },
  {
    id: 6,
    brand: "Yamaha",
    name: "Launch Control",
    price: "Rp. 399.000",
    stock: 7,
    shipping: "Rp. 22.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Kontrol start untuk menjaga rpm tetap stabil dan membantu akselerasi awal lebih konsisten.",
    tags: ["Launch", "RPM hold", "Race start", "Control"],
  },
  {
    id: 7,
    brand: "Kawasaki",
    name: "Data Logger",
    price: "Rp. 199.000",
    stock: 18,
    shipping: "Rp. 15.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Pencatat data performa untuk membaca kebiasaan mesin dan membantu proses tuning berikutnya.",
    tags: ["Logger", "Telemetry", "Data", "Tuning"],
  },
  {
    id: 8,
    brand: "Suzuki",
    name: "Wiring Harness",
    price: "Rp. 149.000",
    stock: 25,
    shipping: "Rp. 15.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Harness rapi untuk instalasi modul TuneBoss dengan koneksi yang aman dan mudah dirawat.",
    tags: ["Harness", "Install", "Cable", "Clean fit"],
  },
  {
    id: 9,
    brand: "Honda",
    name: "Fuel Controller",
    price: "Rp. 329.000",
    stock: 12,
    shipping: "Rp. 20.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Kontrol suplai bahan bakar untuk menjaga pembakaran lebih optimal setelah upgrade komponen.",
    tags: ["Fuel", "Controller", "AFR", "Response"],
  },
  {
    id: 10,
    brand: "Yamaha",
    name: "Ignition Module",
    price: "Rp. 279.000",
    stock: 13,
    shipping: "Rp. 18.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Modul pengapian untuk membantu karakter tenaga lebih tajam dan stabil di berbagai putaran mesin.",
    tags: ["Ignition", "Timing", "Spark", "Stable"],
  },
  {
    id: 11,
    brand: "Kawasaki",
    name: "Pit Limiter",
    price: "Rp. 189.000",
    stock: 9,
    shipping: "Rp. 15.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Limiter kecepatan pit yang praktis untuk kebutuhan track day dan paddock setup.",
    tags: ["Limiter", "Track", "Paddock", "Control"],
  },
  {
    id: 12,
    brand: "Suzuki",
    name: "Race Harness",
    price: "Rp. 229.000",
    stock: 10,
    shipping: "Rp. 18.000",
    image: "/images/tuneboss-motorcycle-ecu.png",
    description: "Harness balap yang lebih ringkas untuk instalasi cepat dan jalur kabel yang mudah dilacak.",
    tags: ["Race", "Harness", "Lightweight", "Serviceable"],
  },
  ];
  const productList = products.map((product) => ({ ...product, slug: slugify(product.name), apiSlug: slugify(`${product.brand} ${product.name}`), images: (product as { images?: string[] }).images ?? [product.image, product.image, product.image] }));

  return productList.flatMap((product) => [product.slug, product.apiSlug].map((slug) => ({
    params: { slug },
    props: { product, products: productList },
  })));
}

const { product, products } = Astro.props;
const relatedProducts = products.filter((item) => item.id !== product.id).slice(0, 4);
const gallery = Array.isArray(product.images) && product.images.length ? product.images : [product.image];
const productImageUrl = new URL(product.image, Astro.url).toString();
const productShareImageUrl = `${productImageUrl}?v=20260629-ecu`;
const reviews = [
  { name: "Fajar", timeKey: "detail.reviewDate1", quote: "Pemasangan mudah, hasil tuning terasa langsung dari putaran bawah." },
  { name: "Rizky", timeKey: "detail.reviewDate2", quote: "Respons gas lebih halus dan motor tetap enak dipakai harian." },
  { name: "Medy", timeKey: "detail.reviewDate3", quote: "Data tuning jelas, cocok buat setup bengkel dan track day." },
  { name: "Dimas", timeKey: "detail.reviewDate4", quote: "Instalasi rapi, motor lebih responsif tanpa bikin harian jadi kasar." },
  { name: "Ari", timeKey: "detail.reviewDate5", quote: "Cocok buat upgrade ringan, setting terasa lebih presisi." },
  { name: "Bayu", timeKey: "detail.reviewDate6", quote: "Packing aman dan hasil tuning langsung terasa di tarikan tengah." },
  { name: "Nanda", timeKey: "detail.reviewDate7", quote: "Dipakai touring tetap stabil, data logger juga gampang dibaca." },
  { name: "Putra", timeKey: "detail.reviewDate8", quote: "Bengkel saya jadi lebih cepat set map untuk beberapa motor." },
];
import SEO from "@/components/SEO.astro";

const productSchema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": productShareImageUrl,
    "description": product.description,
    "brand": {
      "@type": "Brand",
      "name": product.brand
    },
    "offers": {
      "@type": "Offer",
      "url": Astro.url.href,
      "priceCurrency": "IDR",
      "price": product.price.replace(/[^0-9]/g, ""),
      "availability": product.stock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "itemCondition": "https://schema.org/NewCondition"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "8"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://dev.fe-marketplace.panjiihsanudinfajri.my.id/" },
      { "@type": "ListItem", "position": 2, "name": "Produk", "item": "https://dev.fe-marketplace.panjiihsanudinfajri.my.id/products" },
      { "@type": "ListItem", "position": 3, "name": product.name }
    ]
  }
]);
---

<SEO 
  title={`${product.name} | TuneBoss ID`}
  description={product.description}
  image={productShareImageUrl}
  type="product"
  schema={productSchema}
  keywords={`${product.name}, ${product.brand} TuneBoss, ECU ${product.brand}, tuning motor ${product.brand}`}
/>

<TuneBossChrome>
  <main class="min-h-screen bg-background pt-24">
    <section data-loadable data-load-delay="700" class="is-loaded mx-auto max-w-[1500px] px-6 pb-24 md:px-12">
      <div data-skeleton class="grid gap-10 lg:grid-cols-2">
        <div class="space-y-5">
          <div class="skeleton-block h-4 w-56"></div>
          <div class="skeleton-block aspect-[4/5] w-full"></div>
          <div class="flex gap-3">
            <div class="skeleton-block h-3 w-10"></div>
            <div class="skeleton-block h-3 w-10"></div>
            <div class="skeleton-block h-3 w-10"></div>
          </div>
        </div>
        <div class="space-y-7 pt-10">
          <div class="skeleton-block h-5 w-32"></div>
          <div class="skeleton-block h-20 w-4/5"></div>
          <div class="skeleton-block h-12 w-52"></div>
          <div class="grid grid-cols-2 gap-3">
            <div class="skeleton-block h-14"></div>
            <div class="skeleton-block h-14"></div>
          </div>
          <div class="skeleton-block h-24 w-full"></div>
        </div>
      </div>

      <div data-loaded-content>
        <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-foreground/55">
          <a href="/" class="group inline-flex items-center gap-2 transition-colors hover:!text-primary focus-visible:!text-primary">
            <span>Home</span>
            <ChevronRight size={14} strokeWidth={1.8} className="transition-colors group-hover:!text-primary" aria-hidden="true" />
          </a>
          <a href="/products" class="group inline-flex items-center gap-2 transition-colors hover:!text-primary focus-visible:!text-primary">
            <span>Products</span>
            <ChevronRight size={14} strokeWidth={1.8} className="transition-colors group-hover:!text-primary" aria-hidden="true" />
          </a>
          <span class="text-primary">{product.name}</span>
        </nav>

        <div class="mb-6 flex items-center justify-between gap-4">
          <a href="/products" class="product-view-link inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em]">
            <ChevronLeft size={17} strokeWidth={1.8} aria-hidden="true" />
            <span data-i18n="detail.backProducts">Kembali ke Produk</span>
          </a>
          <div class="flex items-center gap-2">
            <button data-share-button class="flex h-11 w-11 items-center justify-center border border-primary/15 transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button" aria-label="Bagikan produk">
              <Share2 size={18} strokeWidth={1.8} aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.02fr)_minmax(420px,0.98fr)] lg:gap-16">
          <section aria-label="Galeri produk" class="space-y-4">
            <div data-gallery-zoom-container class="gallery-zoom-container relative flex aspect-[4/5] items-center justify-center overflow-hidden border border-primary/10 bg-primary/[0.03] p-8 md:p-14">
              <button data-gallery-prev class="absolute left-4 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-primary/15 bg-background/80 transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button" aria-label="Gambar sebelumnya">
                <ChevronLeft size={18} strokeWidth={1.8} aria-hidden="true" />
              </button>
              <Image data-gallery-main src={ecuImage} alt={product.name} loading="eager" class="gallery-main-image h-full w-full object-contain transition-transform duration-300" />
              <button data-gallery-next class="absolute right-4 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-primary/15 bg-background/80 transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button" aria-label="Gambar berikutnya">
                <ChevronRight size={18} strokeWidth={1.8} aria-hidden="true" />
              </button>
            </div>
            <div class="flex gap-2" aria-label="Pilihan gambar produk">
              {gallery.map((image: string, index: number) => (
                <button data-gallery-dot={index} data-gallery-src={image} class:list={["h-2.5 w-12 border transition-colors", index === 0 ? "border-primary bg-primary" : "border-primary/25 hover:bg-primary/40"]} type="button" aria-label={`Lihat gambar ${index + 1}`}></button>
                ))}
            </div>
          </section>

          <section aria-labelledby="product-title" class="flex flex-col justify-center">
            <div class="mb-5 flex flex-wrap gap-3">
              <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                <Tag size={17} strokeWidth={1.8} aria-hidden="true" />
                <span data-product-brand>{product.brand}</span>
              </span>
            </div>
            <h1 id="product-title" data-product-name class="max-w-4xl text-5xl font-black uppercase leading-[0.9] tracking-wide md:text-7xl">{product.name}</h1>

            <div class="mt-6 flex flex-wrap items-end gap-3">
              <span data-product-price class="text-3xl font-light md:text-4xl">{product.price}</span>
            </div>
            <p class="mt-4 text-sm font-bold uppercase tracking-[0.18em] text-primary">
              <span data-i18n="detail.stock">Stok</span>: <span data-product-stock>{product.stock}</span> <span data-i18n="detail.units">unit</span>
            </p>

            <div data-cart-form class="my-8 flex flex-col gap-4 sm:flex-row sm:items-stretch">
              <label class="flex w-full border border-primary/20 sm:w-36">
                <span data-i18n="detail.quantity" class="sr-only">Jumlah</span>
                <input
                  data-cart-qty
                  class="w-full bg-transparent px-4 py-4 text-center text-sm font-bold uppercase tracking-[0.18em] outline-none focus:border-primary"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  autocomplete="off"
                  data-max={product.stock}
                  value="1"
                  aria-label="Jumlah produk"
                />
              </label>
              <button
                data-add-cart
                data-product-id={product.id}
                data-product-name={product.name}
                data-product-price={product.price}
                data-product-image={product.image}
                data-product-brand={product.brand}
                class="inline-flex flex-1 items-center justify-center gap-3 border border-primary bg-primary px-6 py-4 text-sm font-bold uppercase tracking-[0.18em] text-white transition-colors hover:bg-[#c95b04]"
                type="button"
              >
                <ShoppingCart size={19} strokeWidth={1.9} aria-hidden="true" />
                <span data-i18n="detail.addCart">Tambah Keranjang</span>
              </button>
            </div>

            <p data-product-description class="max-w-2xl text-base leading-8 text-primary md:text-lg">{product.description}</p>

            <div class="mt-10 border-t border-primary/10 pt-8">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p data-i18n="detail.officialStore" class="text-xs font-bold uppercase tracking-[0.24em] text-primary">Toko Resmi</p>
                  <div class="mt-2 flex items-center gap-1 text-primary" aria-label="Rating 4.9 dari 5">
                    {Array.from({ length: 5 }).map(() => (
                      <Star size={16} strokeWidth={1.8} fill="currentColor" aria-hidden="true" />
                    ))}
                    <span class="ml-2 text-sm font-bold text-foreground">4.9 (128 <span data-i18n="detail.rating">rating</span>)</span>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>

        <section aria-labelledby="reviews-title" class="mt-24 border-t border-primary/10 pt-12">
          <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p data-i18n="detail.reviewEyebrow" class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-primary">Komentar Produk</p>
              <h2 data-i18n="detail.reviewTitle" id="reviews-title" class="text-3xl font-black uppercase tracking-wide md:text-5xl">Ulasan Pembeli</h2>
            </div>
            <div class="flex flex-col gap-3 text-sm text-primary sm:flex-row sm:items-center">
              <p class="flex flex-wrap items-center gap-1">
                <span>1-<span data-review-shown>{Math.min(6, reviews.length)}</span></span>
                <span data-i18n="detail.reviewFrom">dari</span>
                <span>{reviews.length}</span>
                <span data-i18n="detail.reviews">ulasan</span>
              </p>
              <div data-review-sort class="relative min-w-40">
                <button data-review-sort-button class="flex w-full items-center justify-between border border-primary/20 bg-background px-4 py-2 text-left text-foreground transition-colors hover:border-primary" type="button" aria-label="Urutkan ulasan" aria-expanded="false">
                  <span data-review-sort-value data-i18n="detail.sortHelpful">Paling Membantu</span>
                  <ChevronDown size={16} strokeWidth={1.8} className="text-primary" aria-hidden="true" />
                </button>
                <div data-review-sort-menu class="invisible absolute right-0 top-full z-20 w-full border border-primary/20 bg-background opacity-0 shadow-xl transition-all duration-200">
                  {[
                    ["detail.sortRecent", "Terbaru"],
                    ["detail.sortHelpful", "Paling Membantu"],
                  ].map(([key, option]) => (
                    <button data-review-sort-option data-i18n={key} class="block w-full px-4 py-2 text-left text-sm text-foreground transition-colors hover:bg-primary hover:text-background" type="button">{option}</button>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="mb-10 grid gap-6 border border-primary/10 bg-background/70 p-6 md:grid-cols-[0.8fr_1.2fr] md:p-8">
            <div class="flex flex-col items-center justify-center text-center">
              <strong class="text-5xl font-black">4.8</strong>
              <div class="mt-3 flex gap-1 text-primary" aria-label="Rating 4.8 dari 5">
                {Array.from({ length: 5 }).map(() => <Star size={20} strokeWidth={1.8} fill="currentColor" aria-hidden="true" />)}
              </div>
              <p class="mt-2 text-sm text-primary"><span data-i18n="detail.basedOn">Berdasarkan</span> {reviews.length} <span data-i18n="detail.reviews">ulasan</span></p>
            </div>
            <div class="space-y-3">
              {[
                ["5 star", "83%"],
                ["4 star", "17%"],
                ["3 star", "0%"],
                ["2 star", "0%"],
                ["1 star", "0%"],
              ].map(([label, value]) => (
                <div class="grid grid-cols-[64px_1fr_42px] items-center gap-3 text-sm">
                  <span>{label}</span>
                  <div class="h-3 border border-primary/20 bg-primary/5">
                    <div class="h-full bg-primary" style={`width: ${value}`}></div>
                  </div>
                  <span>{value}</span>
                </div>
              ))}
            </div>
          </div>

          <div data-review-list class="grid gap-6 md:grid-cols-3">
            {reviews.map((review, index) => (
              <figure data-review-item class:list={["border border-primary/10 bg-background/70 p-6 shadow-sm transition-transform duration-300 hover:scale-[1.02]", index >= 6 && "hidden"]}>
                <div class="mb-5 flex gap-1 text-primary" aria-label="5 stars">
                  {Array.from({ length: 5 }).map(() => <span class="text-base leading-none">&#9733;</span>)}
                </div>
                <figcaption class="mb-3 text-xs font-bold uppercase tracking-[0.25em] text-primary">{review.name}</figcaption>
                <time data-i18n={review.timeKey} class="mb-4 block text-xs font-bold uppercase tracking-[0.16em] text-foreground/50"></time>
                <blockquote class="text-lg font-light leading-relaxed md:text-xl">"{review.quote}"</blockquote>
              </figure>
            ))}
          </div>
          {reviews.length > 6 && (
            <div class="mt-8 flex justify-center">
              <button data-load-more-reviews class="border border-primary/20 px-8 py-4 text-xs font-bold uppercase tracking-[0.2em] transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button">
                <span data-i18n="detail.loadMore">Muat Lagi</span>
              </button>
            </div>
          )}
        </section>

        <section aria-labelledby="related-title" class="mt-24 border-t border-primary/10 pt-12">
          <div class="mb-10 flex items-end justify-between gap-5">
            <div>
              <p data-i18n="detail.relatedEyebrow" class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-primary">Produk Lainnya</p>
              <h2 data-i18n="detail.relatedTitle" id="related-title" class="text-3xl font-black uppercase tracking-wide md:text-5xl">Produk Terkait</h2>
            </div>
            <a data-i18n="home.viewAllProducts" href="/products" class="product-view-link hidden text-xs font-bold uppercase tracking-[0.18em] text-foreground sm:inline-flex">Lihat Semua Produk</a>
          </div>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {relatedProducts.map((item) => (
              <ProductCard item={item} />
            ))}
          </div>
        </section>

        <div data-image-lightbox class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 opacity-0 transition-opacity duration-300" aria-hidden="true">
          <button data-image-lightbox-backdrop class="absolute inset-0" type="button" aria-label="Tutup popup gambar"></button>
          <figure class="relative z-10 m-0 w-full max-w-5xl">
            <button data-image-lightbox-close class="absolute right-2 top-2 z-20 inline-flex h-11 w-11 items-center justify-center border border-primary bg-primary text-white transition-colors hover:border-[#c95b04] hover:bg-[#c95b04]" type="button" aria-label="Tutup gambar">
              <X size={18} strokeWidth={1.8} aria-hidden="true" />
            </button>
            <Image data-image-lightbox-image class="max-h-[90svh] w-full object-contain" src={ecuImage} alt={product.name} loading="eager" />
          </figure>
        </div>

      </div>
    </section>
  </main>
</TuneBossChrome>

<script>
  const apiUrl = (import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api").replace(/\/$/, "");

  const closeReviewSorts = () => {
    document.querySelectorAll("[data-review-sort-button]").forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
    document.querySelectorAll("[data-review-sort-menu]").forEach((menu) => {
      menu.classList.add("invisible", "opacity-0");
      menu.classList.remove("visible", "opacity-100");
    });
  };

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("[data-review-sort]")) return;
    closeReviewSorts();
  });

  const loadApiProduct = async () => {
    const slug = window.location.pathname.split("/").filter(Boolean).at(-1);
    if (!slug) return;
    try {
      const response = await fetch(`${apiUrl}/products/${encodeURIComponent(slug)}`);
      const data = await response.json();
      const item = data.product as { id: string; brand: string; name: string; price: string; stock: number; description: string; image: string } | undefined;
      if (!response.ok || !item) return;

      document.querySelectorAll("[data-product-brand]").forEach((node) => { node.textContent = item.brand; });
      document.querySelectorAll("[data-product-name]").forEach((node) => { node.textContent = item.name; });
      document.querySelectorAll("[data-product-price]").forEach((node) => { node.textContent = item.price; });
      document.querySelectorAll("[data-product-stock]").forEach((node) => { node.textContent = String(item.stock); });
      document.querySelectorAll("[data-product-description]").forEach((node) => { node.textContent = item.description; });
      document.querySelectorAll("[data-add-cart]").forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        node.dataset.productId = item.id;
        node.dataset.productName = item.name;
        node.dataset.productPrice = item.price;
        node.dataset.productImage = item.image;
        node.dataset.productBrand = item.brand;
        node.dataset.productMax = String(item.stock || 99);
      });
      document.querySelectorAll("[data-cart-qty]").forEach((node) => {
        if (node instanceof HTMLInputElement) node.dataset.max = String(item.stock || 99);
      });
      document.title = `${item.name} | TuneBoss ID`;
    } catch {
      // Static product content stays visible when the API is unavailable.
    }
  };

  const initProductPage = () => {
    loadApiProduct();
    document.querySelectorAll("[data-loadable]").forEach((section) => {
      section.classList.remove("is-loaded");
      window.setTimeout(() => section.classList.add("is-loaded"), Number(section.getAttribute("data-load-delay") || 600));
    });

    document.querySelectorAll("[data-loaded-content]").forEach((root) => {
      const main = root.querySelector("[data-gallery-main]");
      const zoomContainer = root.querySelector("[data-gallery-zoom-container]");
      const lightbox = root.querySelector("[data-image-lightbox]");
      const lightboxImage = root.querySelector("[data-image-lightbox-image]");
      const lightboxCloseButton = root.querySelector("[data-image-lightbox-close]");
      const lightboxBackdrop = root.querySelector("[data-image-lightbox-backdrop]");
      const dots = Array.from(root.querySelectorAll("[data-gallery-dot]"));
      const qtyInput = root.querySelector("[data-cart-qty]");
      let active = 0;

      const resetZoom = () => {
        if (!(zoomContainer instanceof HTMLElement) || !(main instanceof HTMLImageElement)) return;
        zoomContainer.classList.remove("is-zooming");
        main.style.transformOrigin = "50% 50%";
      };

      const show = (index: number) => {
        if (!(main instanceof HTMLImageElement) || !dots.length) return;
        active = (index + dots.length) % dots.length;
        const button = dots[active];
        const src = button?.getAttribute("data-gallery-src");
        if (src) main.src = src;
        if (src && lightboxImage instanceof HTMLImageElement && lightbox instanceof HTMLElement && lightbox.getAttribute("aria-hidden") === "false") {
          lightboxImage.src = src;
          lightboxImage.alt = main.alt || "Product image";
        }
        resetZoom();
        if (zoomContainer instanceof HTMLElement && zoomContainer.matches(":hover")) {
          zoomContainer.classList.add("is-zooming");
        }
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle("bg-primary", dotIndex === active);
          dot.classList.toggle("border-primary", dotIndex === active);
          dot.classList.toggle("border-primary/25", dotIndex !== active);
          dot.classList.toggle("hover:bg-primary/40", dotIndex !== active);
        });
      };

      dots.forEach((dot, index) => dot.addEventListener("click", () => show(index)));
      root.querySelector("[data-gallery-prev]")?.addEventListener("click", () => show(active - 1));
      root.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(active + 1));

      if (zoomContainer instanceof HTMLElement && main instanceof HTMLImageElement) {
        const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

        const onPointerMove = (event: PointerEvent) => {
          if (!canHover.matches) return;
          zoomContainer.classList.add("is-zooming");
          const rect = zoomContainer.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width) * 100;
          const y = ((event.clientY - rect.top) / rect.height) * 100;
          const clampedX = Math.max(0, Math.min(100, x));
          const clampedY = Math.max(0, Math.min(100, y));
          main.style.transformOrigin = `${clampedX}% ${clampedY}%`;
        };

        zoomContainer.addEventListener("pointerenter", () => {
          if (!canHover.matches) return;
          zoomContainer.classList.add("is-zooming");
        });
        zoomContainer.addEventListener("pointermove", onPointerMove);
        zoomContainer.addEventListener("pointerleave", resetZoom);
        canHover.addEventListener("change", () => {
          if (!canHover.matches) resetZoom();
        });
      }

      const setLightboxOpen = (open: boolean) => {
        if (!(lightbox instanceof HTMLElement)) return;
        lightbox.classList.toggle("pointer-events-none", !open);
        lightbox.classList.toggle("opacity-0", !open);
        lightbox.classList.toggle("opacity-100", open);
        lightbox.setAttribute("aria-hidden", String(!open));
        document.body.classList.toggle("is-lightbox-open", open);
      };

      const openLightbox = () => {
        if (!(main instanceof HTMLImageElement) || !(lightboxImage instanceof HTMLImageElement)) return;
        lightboxImage.src = main.currentSrc || main.src;
        lightboxImage.alt = main.alt || "Product image";
        setLightboxOpen(true);
      };

      const closeLightbox = () => setLightboxOpen(false);

      if (zoomContainer instanceof HTMLElement) {
        zoomContainer.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("[data-gallery-prev], [data-gallery-next]")) return;
          openLightbox();
        });
      }

      lightboxCloseButton?.addEventListener("click", closeLightbox);
      lightboxBackdrop?.addEventListener("click", closeLightbox);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeLightbox();
      });

      if (qtyInput instanceof HTMLInputElement) {
        const clampQuantity = () => {
          const max = Number(qtyInput.dataset.max || 99) || 99;
          const value = Number(qtyInput.value.replace(/\D/g, ""));
          qtyInput.value = String(Math.max(1, Math.min(value || 1, max)));
        };
        qtyInput.addEventListener("input", clampQuantity);
        qtyInput.addEventListener("blur", clampQuantity);
      }
    });

    document.querySelectorAll("[data-review-sort]").forEach((select) => {
      const button = select.querySelector("[data-review-sort-button]");
      const menu = select.querySelector("[data-review-sort-menu]");
      const value = select.querySelector("[data-review-sort-value]");
      const options = select.querySelectorAll("[data-review-sort-option]");

      const setOpen = (open: boolean) => {
        button?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("invisible", !open);
        menu?.classList.toggle("opacity-0", !open);
        menu?.classList.toggle("visible", open);
        menu?.classList.toggle("opacity-100", open);
      };

      button?.addEventListener("click", (event) => {
        event.stopPropagation();
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });

      options.forEach((option) => {
        option.addEventListener("click", () => {
          if (value) {
            value.setAttribute("data-i18n", option.getAttribute("data-i18n") || "");
            value.textContent = option.textContent;
          }
          setOpen(false);
        });
      });
    });

    document.querySelectorAll("[data-load-more-reviews]").forEach((button) => {
      button.addEventListener("click", () => {
        const section = button.closest("section");
        const items = Array.from(section?.querySelectorAll("[data-review-item]") || []);
        const hidden = items.filter((item) => item.classList.contains("hidden"));
        hidden.slice(0, 6).forEach((item) => item.classList.remove("hidden"));

        const shown = items.filter((item) => !item.classList.contains("hidden")).length;
        const shownText = section?.querySelector("[data-review-shown]");
        if (shownText) shownText.textContent = String(shown);
        if (shown >= items.length) button.remove();
      });
    });

    document.querySelectorAll("[data-share-button]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          if (navigator.share) {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } else {
            await navigator.clipboard.writeText(window.location.href);
            const lang = document.documentElement.lang === "en" ? "en" : "id";
            const title = lang === "en" ? "Link Copied" : "Tautan Disalin";
            const desc = lang === "en" ? "Product link copied to clipboard." : "Tautan produk disalin ke papan klip.";
            if (typeof window.showToast === "function") window.showToast(title, desc);
            else alert(title + ": " + desc);
          }
        } catch (err: unknown) {
          if ((err as Error).name !== "AbortError") {
            console.error("Error sharing:", err);
          }
        }
      });
    });
  };

  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll("[data-loadable]").forEach((section) => {
      section.classList.remove("is-loaded");
    });
  });

  document.addEventListener("astro:page-load", initProductPage);
</script>

<style>
  .gallery-main-image {
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .gallery-zoom-container.is-zooming .gallery-main-image {
    transform: scale(1.85);
    cursor: zoom-in;
  }

  .gallery-main-image {
    cursor: zoom-in;
  }

  @media (hover: none), (pointer: coarse) {
    .gallery-zoom-container.is-zooming .gallery-main-image {
      transform: none;
    }
  }

  :global(body.is-lightbox-open) {
    overflow: hidden;
  }

</style>
