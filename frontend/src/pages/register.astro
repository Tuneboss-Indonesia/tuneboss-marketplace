---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import { Eye, EyeOff, LogIn, User, Mail, Lock } from "lucide-react";

import "@/styles/global.css";

export const prerender = false;
import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Buat Akun | TuneBoss ID"
  description="Buat akun TuneBoss ID untuk menyimpan detail pesanan dan mempercepat proses checkout."
  titleKey="page.register.title"
  noindex={true}
/>

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-24 pt-24 md:px-12 md:pt-32">
    <section class="mx-auto max-w-2xl">
      <div class="mb-10">
        <p data-i18n="account.title" class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-primary">Account</p>
        <h1 data-i18n="auth.registerTitle" class="font-display text-4xl uppercase md:text-6xl">Create Account</h1>
        <p data-i18n="auth.registerCopy" class="mt-6 max-w-lg text-base leading-relaxed text-primary md:text-lg">Create an account to save your TuneBoss orders and details.</p>
      </div>

      <form class="w-full space-y-6" novalidate>
        <label class="block">
          <span data-i18n="auth.name" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Name</span>
          <span class="relative block">
            <User size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-foreground/50" />
            <input name="name" data-i18n-placeholder="auth.namePlaceholder" class="auth-page-input !pl-12" type="text" autocomplete="name" placeholder="Nama Anda" />
          </span>
          <span class="auth-error mt-1 hidden text-xs text-red-500"></span>
        </label>

        <label class="block">
          <span data-i18n="auth.email" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Email</span>
          <span class="relative block">
            <Mail size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-foreground/50" />
            <input name="email" data-i18n-placeholder="auth.emailPlaceholder" class="auth-page-input !pl-12" type="email" autocomplete="username" placeholder="Email Anda" />
          </span>
          <span class="auth-error mt-1 hidden text-xs text-red-500"></span>
        </label>

        <label class="block">
          <span data-i18n="auth.password" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Password</span>
          <span class="relative block">
            <Lock size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-foreground/50" />
            <input name="password" data-auth-password data-i18n-placeholder="auth.passwordPlaceholder" class="auth-page-input !pl-12 !pr-12" type="password" autocomplete="new-password" placeholder="Kata sandi Anda" />
            <button data-password-toggle class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-foreground/60 transition-colors hover:text-primary" type="button" aria-label="Show password">
              <Eye data-eye-show size={20} strokeWidth={1.8} />
              <EyeOff data-eye-hide size={20} strokeWidth={1.8} className="hidden" />
            </button>
          </span>
          <span class="auth-error mt-1 hidden text-xs text-red-500"></span>
        </label>

        <label class="block">
          <span data-i18n="auth.confirmPassword" class="mb-2 block text-sm font-bold uppercase tracking-widest text-primary">Confirm Password</span>
          <span class="relative block">
            <Lock size={18} className="absolute left-4 top-1/2 -translate-y-1/2 text-foreground/50" />
            <input name="confirmPassword" data-auth-password data-i18n-placeholder="auth.confirmPasswordPlaceholder" class="auth-page-input !pl-12 !pr-12" type="password" autocomplete="new-password" placeholder="Konfirmasi sandi Anda" />
            <button data-password-toggle class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-foreground/60 transition-colors hover:text-primary" type="button" aria-label="Show password">
              <Eye data-eye-show size={20} strokeWidth={1.8} />
              <EyeOff data-eye-hide size={20} strokeWidth={1.8} className="hidden" />
            </button>
          </span>
          <span class="auth-error mt-1 hidden text-xs text-red-500"></span>
        </label>

        <label class="mb-6 mt-4 flex cursor-pointer items-start gap-3">
          <input type="checkbox" name="termsAgreed" required class="mt-1 h-4 w-4 shrink-0 rounded border-primary/20 bg-transparent text-primary focus:ring-primary focus:ring-offset-0" />
          <span class="text-sm leading-relaxed text-foreground/80">
            <span data-i18n="auth.termsPrefix">Dengan ini saya menyetujui </span><a href="/privacy" target="_blank" class="font-bold !text-primary hover:underline" style="color: var(--primary) !important;" data-i18n="auth.privacyLink">kebijakan privasi</a><span data-i18n="auth.termsAnd"> dan </span><a href="/terms" target="_blank" class="font-bold !text-primary hover:underline" style="color: var(--primary) !important;" data-i18n="auth.termsLink">ketentuan layanan</a>
          </span>
        </label>

        <button data-i18n="auth.createAccount" class="w-full bg-primary px-5 py-4 text-base font-bold uppercase tracking-[0.22em] text-white transition-colors hover:bg-[#c95b04] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-primary" type="submit" disabled>Create Account</button>

        <a href="/login" class="flex items-center justify-center gap-3 border border-primary/20 px-5 py-4 text-sm font-bold uppercase tracking-[0.22em] transition-colors hover:border-primary hover:text-primary">
          <LogIn size={17} strokeWidth={1.7} />
          <span data-i18n="auth.backToSignin">Back to Sign In</span>
        </a>
      </form>
    </section>
  </main>
</TuneBossChrome>

<style>
  .auth-page-input {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    background: transparent;
    padding: 1rem;
    font-size: 1rem;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .auth-page-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 12%, transparent);
  }
</style>

<script>
  import { z } from "zod";
  import { navigate } from "astro:transitions/client";

  const apiUrl = import.meta.env.PUBLIC_API_URL.replace(/\/$/, "");

  const bindRegisterPage = () => {
    const form = document.querySelector("form");
    if (form instanceof HTMLFormElement && form.dataset.bound !== "true") {
      form.dataset.bound = "true";
      const termsInput = form.elements.namedItem("termsAgreed");
      const submitButton = form.querySelector('button[type="submit"]');
      const syncSubmitButton = () => {
        if (termsInput instanceof HTMLInputElement && submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = !termsInput.checked;
        }
      };
      if (termsInput instanceof HTMLInputElement) {
        termsInput.addEventListener("change", syncSubmitButton);
      }
      syncSubmitButton();

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const nameInput = form.elements.namedItem("name");
        const emailInput = form.elements.namedItem("email");
        const passwordInput = form.elements.namedItem("password");
        const termsInput = form.elements.namedItem("termsAgreed");

        form.querySelectorAll(".auth-error").forEach(el => {
          el.textContent = "";
          el.classList.add("hidden");
        });

        const lang = document.documentElement.lang === "en" ? "en" : "id";
        const schema = z.object({
          name: z.string().min(1, lang === "en" ? "Name is required" : "Nama wajib diisi"),
          email: z.string().min(1, { message: lang === "en" ? "Email is required" : "Email wajib diisi" }).regex(/^[^\s@]+@[^\s@]+\.[^\s@]+$/, { message: lang === "en" ? "Invalid email format" : "Format email tidak valid" }),
          password: z.string().min(8, lang === "en" ? "Password must be at least 8 characters" : "Password minimal 8 karakter"),
          confirmPassword: z.string().min(1, lang === "en" ? "Confirm password is required" : "Konfirmasi password wajib diisi"),
          termsAgreed: z.literal(true, { message: lang === "en" ? "Please accept the terms" : "Wajib menyetujui ketentuan layanan" }),
        }).refine((data) => data.password === data.confirmPassword, {
          message: lang === "en" ? "Passwords do not match" : "Password tidak sama",
          path: ["confirmPassword"],
        });

        const confirmPasswordInput = form.elements.namedItem("confirmPassword");
        
        const formData = {
          name: nameInput instanceof HTMLInputElement ? nameInput.value : "",
          email: emailInput instanceof HTMLInputElement ? emailInput.value : "",
          password: passwordInput instanceof HTMLInputElement ? passwordInput.value : "",
          confirmPassword: confirmPasswordInput instanceof HTMLInputElement ? confirmPasswordInput.value : "",
          termsAgreed: termsInput instanceof HTMLInputElement ? termsInput.checked : false,
        };

        const result = schema.safeParse(formData);

        if (!result.success) {
          result.error.issues.forEach(issue => {
            const field = String(issue.path[0]);
            const input = form.elements.namedItem(field);
            if (input instanceof HTMLElement) {
              const errorContainer = input.closest("label")?.querySelector(".auth-error");
              if (errorContainer) {
                errorContainer.textContent = issue.message;
                errorContainer.classList.remove("hidden");
              }
            }
          });
          return;
        }

        const email = formData.email.trim().toLowerCase();
        const redirect = new URLSearchParams(window.location.search).get("redirect");
        const submit = form.querySelector('button[type="submit"]');
        if (submit instanceof HTMLButtonElement) submit.disabled = true;

        try {
          const response = await fetch(`${apiUrl}/auth/register`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({ email, name: formData.name, password: formData.password }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.message || data.error || "Register gagal");
          navigate(redirect || "/account/settings");
        } catch (error) {
          if (typeof window.showToast === "function") {
            window.showToast(lang === "en" ? "Register failed" : "Register gagal", error instanceof Error ? error.message : "Request failed");
          }
        } finally {
          syncSubmitButton();
        }
      });
    }
  };

  bindRegisterPage();
  document.addEventListener("astro:page-load", bindRegisterPage);
</script>
