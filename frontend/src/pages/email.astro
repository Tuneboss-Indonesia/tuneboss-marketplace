---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import "@/styles/global.css";
---

<TuneBossChrome title="Email Templates">
  <main class="mx-auto min-h-screen max-w-3xl px-6 py-32">
    <h1 class="text-2xl font-bold text-foreground">Email Templates</h1>
    <p class="mt-3 text-sm text-foreground/70">
      Template email dikelola oleh backend dan hanya dirender dengan data pesanan nyata.
    </p>
  </main>
</TuneBossChrome>
