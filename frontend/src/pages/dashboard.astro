---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

export const prerender = false;
---

<head>
  <title data-i18n-title="account.dashboard">Dashboard | TuneBoss ID</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/tuneboss-logo.png" />
  <ClientRouter />
</head>

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-24 pt-36 md:px-12">
    <section class="mx-auto max-w-2xl text-center">
        <h1 data-i18n="account.dashboard" class="font-display text-4xl uppercase md:text-6xl">Dashboard</h1>
    </section>
  </main>
</TuneBossChrome>

