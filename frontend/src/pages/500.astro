---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<head>
  <title data-i18n="page.500.title">500 - Terjadi Kesalahan | TuneBoss ID</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/tuneboss-logo.png" />
  <ClientRouter />
</head>

<TuneBossChrome>
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-background pt-24">
    <div class="relative z-10 flex flex-col items-center justify-center px-6 text-center">
      <h1 data-i18n="error.500" data-reveal class="mb-4 font-display font-black uppercase leading-none tracking-tighter text-red-500/80" style="font-size: clamp(5rem, 12vw, 10rem);">
        500
      </h1>
      <h2 data-i18n="error.serverError" data-reveal class="mb-6 font-display text-2xl font-light uppercase tracking-widest text-foreground/80 md:text-3xl">
        Terjadi Kesalahan Server
      </h2>
      <p data-i18n="error.serverErrorCopy" data-reveal class="mx-auto mb-10 max-w-md text-sm font-light leading-relaxed text-foreground/60 md:text-base">
        Maaf, sistem kami mengalami kendala teknis saat memproses permintaan Anda. Tim kami telah diberitahu.
      </p>
      
      {import.meta.env.DEV && error instanceof Error && (
        <div class="mx-auto mb-10 w-full max-w-2xl overflow-hidden rounded-lg border border-red-500/20 bg-red-500/5 text-left text-sm backdrop-blur-sm" data-reveal>
          <div class="border-b border-red-500/20 bg-red-500/10 px-4 py-2 font-mono font-bold text-red-400">
            {error.name}: {error.message}
          </div>
          <div class="overflow-x-auto p-4 text-xs font-mono text-red-400/80">
            <pre><code>{error.stack}</code></pre>
          </div>
        </div>
      )}

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center" data-reveal>
        <button onclick="window.location.reload()" class="group flex items-center justify-center border border-primary bg-primary px-10 py-4 text-xs font-bold uppercase tracking-[0.2em] text-background transition-all duration-300 hover:bg-background hover:text-primary">
          <span data-i18n="error.tryAgain" class="mr-2">Coba Lagi</span>
        </button>
        <a href="/" class="group flex items-center justify-center border border-primary bg-background px-10 py-4 text-xs font-bold uppercase tracking-[0.2em] text-foreground transition-all duration-300 hover:bg-primary hover:text-background">
          <span data-i18n="error.backHome" class="mr-2">Kembali ke Beranda</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1">&rsaquo;</span>
        </a>
      </div>
    </div>

    <!-- Decorative background elements -->
    <div class="absolute left-1/2 top-1/2 -z-10 -translate-x-1/2 -translate-y-1/2">
      <div class="h-[600px] w-[600px] rounded-full bg-red-500/5 blur-[100px] filter"></div>
    </div>
  </main>
</TuneBossChrome>
