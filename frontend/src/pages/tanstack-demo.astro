---
import TuneBossChrome from '@/components/TuneBossChrome.astro'
import { QueryProvider } from '../components/QueryProvider'
import { ProductsTable } from '../components/ProductsTable'
import { ProductForm } from '../components/ProductForm'
---

<TuneBossChrome>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">TanStack Demo - Product Management</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <h2 class="text-2xl font-semibold mb-4">Product List</h2>
        <p class="text-gray-600 mb-4">
          Menggunakan TanStack Query untuk fetch data dan TanStack Table untuk menampilkan dengan sorting dan filtering.
        </p>
        <div class="border rounded-lg p-4">
          <QueryProvider client:only="react">
            <ProductsTable client:only="react" />
          </QueryProvider>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-4">Add New Product</h2>
        <p class="text-gray-600 mb-4">
          Menggunakan TanStack Form untuk form management dengan validasi real-time.
        </p>
        <div class="border rounded-lg p-4">
          <QueryProvider client:only="react">
            <ProductForm client:only="react" />
          </QueryProvider>
        </div>
      </div>
    </div>

    <div class="mt-8 p-4 bg-gray-100 rounded-lg">
      <h3 class="font-semibold mb-2">Teknologi yang digunakan:</h3>
      <ul class="list-disc list-inside space-y-1 text-sm">
        <li><strong>TanStack Query</strong> - Data fetching dan caching</li>
        <li><strong>TanStack Table</strong> - Table dengan sorting, filtering, dan pagination</li>
        <li><strong>TanStack Form</strong> - Form management dengan validasi</li>
      </ul>
    </div>
  </div>
</TuneBossChrome>
