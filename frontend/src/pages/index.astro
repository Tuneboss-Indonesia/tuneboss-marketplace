---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import PageHero from "@/components/PageHero.astro";
import ProductCard from "@/components/ProductCard.astro";
import TestimonialsCarousel from "@/components/TestimonialsCarousel.astro";

import SEO from "@/components/SEO.astro";
import "@/styles/global.css";

const apiUrl = (import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api").replace(/\/$/, "");
const fetchJson = (path: string) => fetch(`${apiUrl}${path}`, { signal: AbortSignal.timeout(8000) }).then((response) => response.ok ? response.json() : Promise.reject());
const [{ products = [] } = {}, contentData] = await Promise.all([
  fetchJson("/products").catch(() => ({ products: [] })),
  fetchJson("/content").catch(() => null),
]);
const storeContent = contentData?.content || {};
const homeHeroMedia = typeof storeContent.homeHero === "string" ? storeContent.homeHero : "";
const homeTestimonials = Array.isArray(storeContent.testimonials)
  ? storeContent.testimonials.map((review: { name: string; comment: string }) => ({ name: review.name, quote: review.comment }))
  : [];
const homeHeroIsVideo = /\.(mp4|webm)(\?|$)/i.test(homeHeroMedia);
const organizationSchema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "TuneBoss ID",
    "alternateName": "TuneBoss Indonesia",
    "url": "https://marketplace.tuneboss.id",
    "logo": "https://marketplace.tuneboss.id/tuneboss-logo.png",
    "image": "https://marketplace.tuneboss.id/images/og-image.png",
    "description": "Distributor resmi produk ECU TuneBoss di Indonesia. Menyediakan ECU racing, flash kit, quickshifter, data logger, dan aksesori tuning performa motor Honda, Yamaha, Kawasaki, Suzuki.",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+62-817-5792-805",
      "contactType": "customer service",
      "areaServed": "ID",
      "availableLanguage": ["Indonesian", "English"]
    },
    "sameAs": [
      "https://www.instagram.com/tuneboss.id",
      "https://www.facebook.com/tuneboss.id",
      "https://www.tiktok.com/@tuneboss.id"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "TuneBoss ID",
    "url": "https://marketplace.tuneboss.id",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://marketplace.tuneboss.id/products?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
]);
---

<SEO 
  title="TuneBoss ID - ECU Motor, Tuning & Aksesori Performa Racing"
  description="Beli ECU motor TuneBoss original, flash kit, quickshifter, data logger & aksesori tuning performa untuk Honda, Yamaha, Kawasaki, Suzuki. Gratis ongkir & garansi resmi Indonesia."
  schema={organizationSchema}
  keywords="ECU motor, ECU racing, tuning motor, flash ECU, ECU Honda, ECU Yamaha, ECU Kawasaki, ECU Suzuki, quickshifter motor, data logger motor, TuneBoss Indonesia, jual ECU motor, beli ECU motor, aksesori performa motor, piggyback ECU, remapping ECU, fuel injection tuning"
/>

<TuneBossChrome>
  <main class="min-h-screen w-full bg-background">
    <PageHero
      imageUrl={homeHeroMedia && !homeHeroIsVideo ? homeHeroMedia : "/tuneboss-logo.png"}
      videoUrl={homeHeroMedia && homeHeroIsVideo ? homeHeroMedia : "/videos/motorcycle-ecu-tuneboss.mp4"}
      title="Performance"
      subtitle="At Your Finger Tips."
      titleKey="home.heroTitle"
      subtitleKey="home.heroSubtitle"
      heightClass="h-screen"
      overlayClass="bg-black/35"
      imageClass="object-cover object-top scale-[2] -translate-y-28 md:scale-150 md:-translate-y-24"
      titleClass="text-primary"
    />

    <section class="mx-auto max-w-[1600px] overflow-hidden border-b border-primary/5 px-6 py-14 pb-20 md:px-12 md:py-24 md:pb-32">
      <div class="flex flex-col gap-10 lg:flex-row lg:gap-32">
        <div class="w-full shrink-0 lg:w-[38%]" data-reveal>
          <h2 data-i18n="home.differenceEyebrow" class="mb-4 flex items-center text-xs font-bold uppercase tracking-[0.3em] text-primary">The TUNEBOSS Difference</h2>
          <h3 class="mb-8 font-display text-3xl font-light uppercase leading-tight tracking-normal md:text-5xl">
            <span data-i18n="home.beyond">Beyond</span> <br /><span data-i18n="home.ordinary" class="font-bold">Ordinary</span>
          </h3>
          <p data-i18n="home.differenceCopy" class="mb-10 text-sm font-light leading-relaxed text-primary">
            We curate premium products with the same luxury retail rhythm: sharp visuals, deliberate motion, and a focused buying path.
          </p>
        </div>

        <div class="grid w-full grid-cols-1 gap-x-16 gap-y-12 md:grid-cols-2 md:gap-y-20 lg:w-[62%]">
          {[
            ["home.feature1", "ECU Precision"],
            ["home.feature2", "Real-Time Data"],
            ["home.feature3", "Track-Ready Setup"],
            ["home.feature4", "Reliable Control"],
          ].map(([key, title]) => (
            <div class="group" data-reveal>
              <h4 data-i18n={key} class="mb-5 text-base font-bold uppercase tracking-widest md:text-lg">{title}</h4>
              <p data-i18n="home.featureCopy" class="text-sm font-light leading-relaxed text-primary md:text-base">
                A minimal, premium shopping surface with sharp visuals, deliberate motion, and a focused buying path.
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1600px] px-6 py-24 md:px-12">
      <div class="mb-16 flex items-end justify-between border-b border-primary/10 pb-6">
        <h2 data-i18n="home.ourProducts" class="font-display text-3xl font-light uppercase tracking-normal md:text-5xl" aria-label="Our Products">Our Products</h2>
        <a data-i18n="home.viewAllProducts" href="/products" class="product-view-link hidden text-sm font-bold uppercase tracking-widest md:block">View All Products</a>
      </div>
      <div data-loadable data-load-delay="700">
        <div data-skeleton class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 md:gap-12" aria-label="Loading products">
          {Array.from({ length: 8 }).map(() => (
            <div class="border border-primary/5 bg-background p-2 md:p-4">
              <div class="skeleton-block aspect-[4/3] md:aspect-[16/10]"></div>
              <div class="mt-8 space-y-4">
                <div class="skeleton-block h-3 w-20"></div>
                <div class="skeleton-block h-8 w-3/4"></div>
                <div class="mt-10 flex items-end justify-between">
                  <div class="space-y-3">
                    <div class="skeleton-block h-3 w-10"></div>
                    <div class="skeleton-block h-6 w-24"></div>
                  </div>
                  <div class="skeleton-block h-9 w-9"></div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div data-loaded-content data-home-products-grid class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 md:gap-12">
          {products.slice(0, 8).map((item) => <ProductCard item={item} />)}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1600px] border-t border-primary/5 bg-secondary/10 py-24 dark:bg-black/20">
      <div class="mb-16 flex flex-col items-center justify-center text-center">
        <h2 data-i18n="home.partners" class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-primary" aria-label="Testimonials">Testimonials</h2>
        <h3 class="font-display text-3xl font-light uppercase tracking-normal md:text-5xl" aria-label="Rider Stories"><span data-i18n="home.worldClass">Rider</span> <strong data-i18n="home.engineering" class="font-bold">Stories</strong></h3>
      </div>
      <div data-loadable data-load-delay="900">
        <div data-skeleton class="overflow-hidden border-y border-primary/10 py-4" aria-label="Loading testimonials">
          {Array.from({ length: 2 }).map(() => (
            <div class="flex w-max gap-6 px-6 py-3">
              {Array.from({ length: 5 }).map(() => (
                <div class="w-[320px] flex-none border border-primary/10 bg-background/70 p-6 md:w-[420px]">
                  <div class="mb-5 flex gap-1">
                    {Array.from({ length: 5 }).map(() => <div class="skeleton-block h-4 w-4"></div>)}
                  </div>
                  <div class="skeleton-block mb-4 h-3 w-24"></div>
                  <div class="space-y-3">
                    <div class="skeleton-block h-5 w-full"></div>
                    <div class="skeleton-block h-5 w-4/5"></div>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
        <div data-loaded-content>
          <TestimonialsCarousel testimonials={homeTestimonials} />
        </div>
      </div>
    </section>
  </main>
</TuneBossChrome>

<script>
  document.addEventListener("astro:page-load", () => {

    document.querySelectorAll("[data-loadable]").forEach((section) => {
      section.classList.remove("is-loaded");
      window.setTimeout(() => section.classList.add("is-loaded"), Number(section.getAttribute("data-load-delay") || 600));
    });
  });
</script>
