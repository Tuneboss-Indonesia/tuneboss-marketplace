---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import PageHero from "@/components/PageHero.astro";
import ProductCard from "@/components/ProductCard.astro";
import { ChevronDown, Search } from "lucide-react";

import "@/styles/global.css";

const products = [
  { id: 1, brand: "Honda", name: "Motorcycle ECU", price: "Rp. 599.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 14 },
  { id: 2, brand: "Yamaha", name: "ECU Flash Kit", price: "Rp. 299.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 20 },
  { id: 3, brand: "Kawasaki", name: "Race Tuning Pack", price: "Rp. 449.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 8 },
  { id: 4, brand: "Suzuki", name: "Street Tune Pack", price: "Rp. 349.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 16 },
  { id: 5, brand: "Honda", name: "Quickshifter Module", price: "Rp. 249.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 11 },
  { id: 6, brand: "Yamaha", name: "Launch Control", price: "Rp. 399.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 7 },
  { id: 7, brand: "Kawasaki", name: "Data Logger", price: "Rp. 199.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 18 },
  { id: 8, brand: "Suzuki", name: "Wiring Harness", price: "Rp. 149.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 25 },
  { id: 9, brand: "Honda", name: "Fuel Controller", price: "Rp. 329.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 12 },
  { id: 10, brand: "Yamaha", name: "Ignition Module", price: "Rp. 279.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 13 },
  { id: 11, brand: "Kawasaki", name: "Pit Limiter", price: "Rp. 189.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 9 },
  { id: 12, brand: "Suzuki", name: "Race Harness", price: "Rp. 229.000", image: "/images/tuneboss-motorcycle-ecu.png", stock: 10 },
];

const pageSize = 9;
const pageCount = Math.ceil(products.length / pageSize);
const filters: [string, string, string[]][] = [
  ["products.brand", "Filter by Brand", ["All Brands", "Honda", "Kawasaki", "Suzuki", "Yamaha"]],
  ["products.year", "Sort by Add", ["Default", "Oldest to Newest", "Newest to Oldest"]],
  ["products.price", "Sort by Price", ["Default", "Lowest to Highest", "Highest to Lowest"]],
];

import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Produk ECU Motor & Tuning TuneBoss - Harga Terbaik Indonesia"
  description="Jual ECU motor TuneBoss untuk Honda, Yamaha, Kawasaki, Suzuki. Flash kit, quickshifter, data logger, wiring harness. Harga terbaik, garansi resmi, pengiriman seluruh Indonesia."
  titleKey="page.products.title"
  keywords="jual ECU motor, harga ECU motor, ECU motor murah, ECU motor Honda, ECU motor Yamaha, ECU Kawasaki, ECU Suzuki, flash kit motor, quickshifter motor, data logger motor, tuning motor Indonesia, piggyback ECU, ECU aftermarket, fuel controller motor"
/>

<TuneBossChrome>
  <main class="min-h-screen w-full bg-background pb-32">
    <div class="mb-16">
      <PageHero
        imageUrl="/tuneboss-logo.png"
        videoUrl="/videos/motorcycle-ecu-tuneboss.mp4"
        pretext="The Collection"
        title="Product"
        subtitleHighlight="Overview"
        pretextKey="products.heroPretext"
        titleKey="products.heroTitle"
        subtitleHighlightKey="products.heroHighlight"
        titleLayout="center"
        heightClass="h-screen"
        overlayClass="bg-black/35"
        imageClass="object-cover object-top scale-[2] -translate-y-28 md:scale-150 md:-translate-y-24"
      />
    </div>

    <section class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="flex flex-col gap-12 lg:gap-20 md:flex-row">
        <aside class="w-full shrink-0 md:w-1/4 lg:w-1/5">
          <div class="sticky top-32">
            <h5 data-i18n="products.refine" class="mb-8 border-b border-primary/10 pb-4 text-xs font-bold uppercase tracking-[0.2em] text-primary">Filter Search</h5>

            <div class="mb-8">
              <p data-i18n="products.search" class="mb-3 block text-sm font-light tracking-wide">Search</p>
              <div class="relative">
                <Search size={18} strokeWidth={1.8} className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-primary" />
                <input
                  type="text"
                  autocomplete="off"
                  aria-label="Search product"
                  data-i18n-placeholder="products.searchPlaceholder"
                  placeholder="Search product..."
                  class="w-full rounded-none border border-primary/20 bg-transparent py-4 pl-12 pr-4 text-sm font-medium transition-colors focus:border-primary focus:outline-none"
                />
              </div>
            </div>

            {filters.map(([key, label, options]) => (
              <div class="mb-8">
                <p data-i18n={key} class="mb-3 block text-sm font-light tracking-wide">{label}</p>
                <div data-select class="relative">
                  <button data-select-button class="flex w-full items-center justify-between border border-primary/20 bg-background p-4 text-left text-sm font-medium text-foreground transition-colors hover:border-primary focus:border-primary focus:outline-none" type="button" aria-label={label} aria-expanded="false">
                    <span data-select-value>{options[0]}</span>
                    <ChevronDown size={18} strokeWidth={2} className="text-primary" />
                  </button>
                  <div data-select-menu class="invisible absolute left-0 top-full z-[60] w-full border border-primary/20 bg-background opacity-0 shadow-xl transition-all duration-200">
                    {options.map((option) => (
                      <button data-select-option={option} class="block w-full px-4 py-2 text-left text-sm font-medium text-foreground transition-colors hover:bg-primary hover:text-background" type="button">{option}</button>
                    ))}
                  </div>
                </div>
              </div>
            ))}

            <button data-reset-filters data-i18n="products.reset" class="w-full border border-primary/20 py-4 text-xs font-bold uppercase tracking-widest transition-all duration-300 hover:bg-primary hover:text-background" type="button">
              Reset Filters
            </button>
          </div>
        </aside>

        <div class="w-full md:w-3/4 lg:w-4/5">
          <div data-loadable data-load-delay="800">
            <div data-skeleton class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 md:gap-12" aria-label="Loading products">
              {Array.from({ length: pageSize }).map(() => (
                <div class="border border-primary/5 bg-background p-2 md:p-4">
                  <div class="skeleton-block aspect-[4/3] md:aspect-[16/10]"></div>
                  <div class="mt-8 space-y-4">
                    <div class="skeleton-block h-3 w-20"></div>
                    <div class="skeleton-block h-8 w-3/4"></div>
                    <div class="mt-10 flex items-end justify-between">
                      <div class="space-y-3">
                        <div class="skeleton-block h-3 w-10"></div>
                        <div class="skeleton-block h-6 w-24"></div>
                      </div>
                      <div class="skeleton-block h-9 w-9"></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div data-loaded-content>
              <div data-products-grid class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 md:gap-12">
                {products.map((item, index) => (
                  <div data-product-card data-page={Math.floor(index / pageSize) + 1}>
                    <ProductCard item={item} />
                  </div>
                ))}
              </div>
              <div data-pagination class="mt-16 flex items-center justify-center gap-3">
                {Array.from({ length: pageCount }, (_, index) => (
                  <button
                    data-page-button={index + 1}
                    class="h-10 min-w-10 border border-primary/20 px-4 text-sm font-bold transition-colors hover:border-primary hover:bg-primary hover:text-background"
                    type="button"
                  >
                    {index + 1}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</TuneBossChrome>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL.replace(/\/$/, "");

  document.addEventListener("astro:page-load", () => {
    let cards = document.querySelectorAll("[data-product-card]");
    let buttons = document.querySelectorAll("[data-page-button]");
    const searchInput = document.querySelector("[data-i18n-placeholder='products.searchPlaceholder']");

    const showPage = (page: string) => {
      cards.forEach((card) => card.classList.toggle("hidden", card.getAttribute("data-page") !== page));
      buttons.forEach((button) => {
        const active = button.getAttribute("data-page-button") === page;
        button.classList.toggle("bg-primary", active);
        button.classList.toggle("text-background", active);
        button.classList.toggle("border-primary", active);
      });
    };

    const bindPagination = () => {
      buttons.forEach((button) => button.addEventListener("click", () => showPage(button.getAttribute("data-page-button") || "1")));
    };

    const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char] || char));
    const renderCard = (item: { id: string; slug: string; image: string; name: string; brand: string; price: string; stock: number }, page: number) => `
      <div data-product-card data-page="${page}">
        <div class="group relative h-full cursor-pointer" data-reveal>
          <a href="/products/${escapeHtml(item.slug)}" aria-label="${escapeHtml(item.name)}" class="relative block h-full">
            <div class="flex h-full flex-col overflow-hidden border border-transparent bg-background transition-all duration-500 hover:border-primary/10 group-hover:shadow-lg">
              <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden bg-transparent p-2 md:aspect-[16/10] md:p-4">
                <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" class="relative z-0 h-full w-full object-contain transition-all duration-700 group-hover:-translate-y-2 group-hover:scale-110" />
              </div>
              <div class="relative flex flex-grow flex-col justify-between border-b border-primary/5 bg-background px-4 pb-4 pt-6 transition-colors duration-500 group-hover:border-primary/30 md:px-5">
                <div class="flex flex-col space-y-1">
                  <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">${escapeHtml(item.brand)}</p>
                  <p class="text-xl font-bold uppercase leading-none tracking-wide md:text-2xl">${escapeHtml(item.name)}</p>
                </div>
                <div class="mt-6 flex items-end justify-between pr-12">
                  <div><p class="mb-1 text-xs font-light text-primary">From</p><span class="text-lg font-light md:text-xl">${escapeHtml(item.price)}</span></div>
                  <span class="text-[10px] font-bold uppercase tracking-widest transition-colors group-hover:text-primary">EXPLORE &rsaquo;</span>
                </div>
              </div>
            </div>
          </a>
          <button data-add-cart data-product-id="${escapeHtml(item.id)}" data-product-name="${escapeHtml(item.name)}" data-product-price="${escapeHtml(item.price)}" data-product-image="${escapeHtml(item.image)}" data-product-max="${item.stock || 99}" data-product-brand="${escapeHtml(item.brand)}" class="absolute bottom-4 right-4 z-20 flex h-9 w-9 items-center justify-center border border-primary/20 bg-background text-foreground transition-all duration-300 hover:border-primary hover:bg-primary hover:text-background md:right-5" type="button" aria-label="Tambah ${escapeHtml(item.name)} ke keranjang">
            <svg viewBox="0 0 24 24" class="h-[17px] w-[17px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          </button>
        </div>
      </div>`;

    const loadProducts = async () => {
      const grid = document.querySelector("[data-products-grid]");
      const pagination = document.querySelector("[data-pagination]");
      if (!grid || !pagination) return;
      try {
        const response = await fetch(`${apiUrl}/products`);
        const data = await response.json();
        const apiProducts = Array.isArray(data.products) ? data.products : [];
        if (!response.ok || apiProducts.length === 0) return;
        grid.innerHTML = apiProducts.map((item, index) => renderCard(item, Math.floor(index / 9) + 1)).join("");
        const pages = Math.ceil(apiProducts.length / 9);
        pagination.innerHTML = Array.from({ length: pages }, (_, index) => `<button data-page-button="${index + 1}" class="h-10 min-w-10 border border-primary/20 px-4 text-sm font-bold transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button">${index + 1}</button>`).join("");
        cards = document.querySelectorAll("[data-product-card]");
        buttons = document.querySelectorAll("[data-page-button]");
        bindPagination();
        showPage("1");
      } catch {
        // Static products stay visible when the API is unavailable.
      }
    };

    bindPagination();
    document.querySelectorAll("[data-select]").forEach((select) => {
      const trigger = select.querySelector("[data-select-button]");
      const menu = select.querySelector("[data-select-menu]");
      const value = select.querySelector("[data-select-value]");
      const setOpen = (open: boolean) => {
        trigger?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("visible", open);
        menu?.classList.toggle("opacity-100", open);
        menu?.classList.toggle("invisible", !open);
        menu?.classList.toggle("opacity-0", !open);
      };

      trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
      select.querySelectorAll("[data-select-option]").forEach((option) => {
        option.addEventListener("click", () => {
          if (value) value.textContent = option.textContent;
          setOpen(false);
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || event.target.closest("[data-select]")) return;
      document.querySelectorAll("[data-select-button]").forEach((button) => button.setAttribute("aria-expanded", "false"));
      document.querySelectorAll("[data-select-menu]").forEach((menu) => {
        menu.classList.remove("visible", "opacity-100");
        menu.classList.add("invisible", "opacity-0");
      });
    });

    document.querySelector("[data-reset-filters]")?.addEventListener("click", () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
      document.querySelectorAll("[data-select]").forEach((select) => {
        const first = select.querySelector("[data-select-option]");
        const value = select.querySelector("[data-select-value]");
        if (value && first) value.textContent = first.textContent;
      });
      showPage("1");
    });
    loadProducts();
    showPage("1");

    document.querySelectorAll("[data-loadable]").forEach((section) => {
      section.classList.remove("is-loaded");
      window.setTimeout(() => section.classList.add("is-loaded"), Number(section.getAttribute("data-load-delay") || 600));
    });
  });
</script>
