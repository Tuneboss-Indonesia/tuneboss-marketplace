---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import PageHero from "@/components/PageHero.astro";
import ProductCard from "@/components/ProductCard.astro";
import { fallbackProducts, type ProductSummary } from "@/lib/fallbackProducts";
import { ChevronDown, Search } from "lucide-react";

import "@/styles/global.css";

export const prerender = false;

const apiUrl = (import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api").replace(/\/$/, "");
const products = await fetch(`${apiUrl}/products`)
  .then((response) => response.ok ? response.json() : Promise.reject())
  .then((data): ProductSummary[] => Array.isArray(data.products) && data.products.length ? data.products : fallbackProducts)
  .catch(() => fallbackProducts);
const contentData = await fetch(`${apiUrl}/content`)
  .then((response) => response.ok ? response.json() : Promise.reject())
  .catch(() => null);
const productsHeroMedia = typeof contentData?.content?.productsHero === "string" ? contentData.content.productsHero : "";
const productsHeroIsVideo = /\.(mp4|webm)(\?|$)/i.test(productsHeroMedia);

const pageSize = 9;
const pageCount = Math.ceil(products.length / pageSize);
const filters: [string, string, string[]][] = [
  ["products.brand", "Filter by Brand", ["All Brands", "Honda", "Kawasaki", "Suzuki", "Yamaha"]],
  ["products.year", "Sort by Add", ["Default", "Oldest to Newest", "Newest to Oldest"]],
  ["products.price", "Sort by Price", ["Default", "Lowest to Highest", "Highest to Lowest"]],
];

import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Produk ECU Motor & Tuning TuneBoss - Harga Terbaik Indonesia"
  description="Jual ECU motor TuneBoss untuk Honda, Yamaha, Kawasaki, Suzuki. Flash kit, quickshifter, data logger, wiring harness. Harga terbaik, garansi resmi, pengiriman seluruh Indonesia."
  titleKey="page.products.title"
  keywords="jual ECU motor, harga ECU motor, ECU motor murah, ECU motor Honda, ECU motor Yamaha, ECU Kawasaki, ECU Suzuki, flash kit motor, quickshifter motor, data logger motor, tuning motor Indonesia, piggyback ECU, ECU aftermarket, fuel controller motor"
/>

<TuneBossChrome>
  <main class="min-h-screen w-full bg-background pb-32">
    <div class="mb-16">
      <PageHero
        imageUrl={productsHeroMedia && !productsHeroIsVideo ? productsHeroMedia : "/tuneboss-logo.png"}
        videoUrl={productsHeroMedia && productsHeroIsVideo ? productsHeroMedia : "/videos/motorcycle-ecu-tuneboss.mp4"}
        pretext="The Collection"
        title="Product"
        subtitleHighlight="Overview"
        pretextKey="products.heroPretext"
        titleKey="products.heroTitle"
        subtitleHighlightKey="products.heroHighlight"
        titleLayout="center"
        heightClass="h-screen"
        overlayClass="bg-black/35"
        imageClass="object-cover object-top scale-[2] -translate-y-28 md:scale-150 md:-translate-y-24"
      />
    </div>

    <section class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="flex flex-col gap-12 lg:gap-20 md:flex-row">
        <aside class="w-full shrink-0 md:w-1/4 lg:w-1/5">
          <div class="sticky top-32">
            <h5 data-i18n="products.refine" class="mb-8 border-b border-primary/10 pb-4 text-xs font-bold uppercase tracking-[0.2em] text-primary">Filter Search</h5>

            <div class="mb-8">
              <p data-i18n="products.search" class="mb-3 block text-sm font-light tracking-wide">Search</p>
              <div class="relative">
                <Search size={18} strokeWidth={1.8} className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-primary" />
                <input
                  type="text"
                  autocomplete="off"
                  aria-label="Search product"
                  data-product-search
                  data-i18n-placeholder="products.searchPlaceholder"
                  placeholder="Search product..."
                  class="w-full rounded-none border border-primary/20 bg-transparent py-4 pl-12 pr-4 text-sm font-medium transition-colors focus:border-primary focus:outline-none"
                />
              </div>
            </div>

            {filters.map(([key, label, options]) => (
              <div class="mb-8">
                <p data-i18n={key} class="mb-3 block text-sm font-light tracking-wide">{label}</p>
                <div data-select data-filter-key={key} class="relative">
                  <button data-select-button class="flex w-full items-center justify-between border border-primary/20 bg-background p-4 text-left text-sm font-medium text-foreground transition-colors hover:border-primary focus:border-primary focus:outline-none" type="button" aria-label={label} aria-expanded="false">
                    <span data-select-value>{options[0]}</span>
                    <ChevronDown size={18} strokeWidth={2} className="text-primary" />
                  </button>
                  <div data-select-menu class="invisible absolute left-0 top-full z-[60] w-full border border-primary/20 bg-background opacity-0 shadow-xl transition-all duration-200">
                    {options.map((option) => (
                      <button data-select-option={option} class="block w-full px-4 py-2 text-left text-sm font-medium text-foreground transition-colors hover:bg-primary hover:text-background" type="button">{option}</button>
                    ))}
                  </div>
                </div>
              </div>
            ))}

            <button data-reset-filters data-i18n="products.reset" class="w-full border border-primary/20 py-4 text-xs font-bold uppercase tracking-widest transition-all duration-300 hover:bg-primary hover:text-background" type="button">
              Reset Filters
            </button>
          </div>
        </aside>

        <div class="w-full md:w-3/4 lg:w-4/5">
          <div data-loadable data-load-delay="800">
            <div data-skeleton class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 md:gap-12" aria-label="Loading products">
              {Array.from({ length: pageSize }).map(() => (
                <div class="border border-primary/5 bg-background p-2 md:p-4">
                  <div class="skeleton-block aspect-[4/3] md:aspect-[16/10]"></div>
                  <div class="mt-8 space-y-4">
                    <div class="skeleton-block h-3 w-20"></div>
                    <div class="skeleton-block h-8 w-3/4"></div>
                    <div class="mt-10 flex items-end justify-between">
                      <div class="space-y-3">
                        <div class="skeleton-block h-3 w-10"></div>
                        <div class="skeleton-block h-6 w-24"></div>
                      </div>
                      <div class="skeleton-block h-9 w-9"></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div data-loaded-content>
              <div data-products-grid class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 md:gap-12">
                {products.map((item, index) => (
                  <div
                    data-product-card
                    data-brand={item.brand}
                    data-index={index}
                    data-name={item.name}
                    data-page={Math.floor(index / pageSize) + 1}
                    data-price={item.priceValue ?? Number(String(item.price).replace(/[^0-9]/g, ""))}
                  >
                    <ProductCard item={item} />
                  </div>
                ))}
              </div>
              <div data-products-empty class="hidden border border-primary/20 p-10 text-center text-sm text-foreground/60">Produk tidak ditemukan.</div>
              <div data-pagination class="mt-16 flex items-center justify-center gap-3">
                {Array.from({ length: pageCount }, (_, index) => (
                  <button
                    data-page-button={index + 1}
                    class="h-10 min-w-10 border border-primary/20 px-4 text-sm font-bold transition-colors hover:border-primary hover:bg-primary hover:text-background"
                    type="button"
                  >
                    {index + 1}
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</TuneBossChrome>

<script>
  document.addEventListener("astro:page-load", () => {
    const pageSize = 9;
    const grid = document.querySelector("[data-products-grid]");
    const empty = document.querySelector("[data-products-empty]");
    const pagination = document.querySelector("[data-pagination]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
    const searchInput = document.querySelector<HTMLInputElement>("[data-product-search]");
    let filteredCards = [...cards];
    let currentPage = 1;

    const showPage = (page: number) => {
      currentPage = page;
      cards.forEach((card) => card.classList.add("hidden"));
      filteredCards.slice((page - 1) * pageSize, page * pageSize).forEach((card) => card.classList.remove("hidden"));
      document.querySelectorAll("[data-page-button]").forEach((button) => {
        const active = button.getAttribute("data-page-button") === String(page);
        button.classList.toggle("bg-primary", active);
        button.classList.toggle("text-background", active);
        button.classList.toggle("border-primary", active);
      });
    };

    const renderPagination = () => {
      if (!pagination) return;
      const pageCount = Math.ceil(filteredCards.length / pageSize);
      pagination.innerHTML = Array.from({ length: pageCount }, (_, index) => `<button data-page-button="${index + 1}" class="h-10 min-w-10 border border-primary/20 px-4 text-sm font-bold transition-colors hover:border-primary hover:bg-primary hover:text-background" type="button">${index + 1}</button>`).join("");
      pagination.classList.toggle("hidden", pageCount <= 1);
    };

    const filterValue = (key: string) => document.querySelector(`[data-filter-key='${key}'] [data-select-value]`)?.textContent?.trim() || "Default";

    const applyFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() || "";
      const brand = filterValue("products.brand");
      const addSort = filterValue("products.year");
      const priceSort = filterValue("products.price");

      filteredCards = cards.filter((card) => {
        const matchesBrand = brand === "All Brands" || card.dataset.brand === brand;
        const matchesQuery = !query || `${card.dataset.name || ""} ${card.dataset.brand || ""}`.toLowerCase().includes(query);
        return matchesBrand && matchesQuery;
      });

      filteredCards.sort((left, right) => {
        if (priceSort === "Lowest to Highest") return Number(left.dataset.price || 0) - Number(right.dataset.price || 0);
        if (priceSort === "Highest to Lowest") return Number(right.dataset.price || 0) - Number(left.dataset.price || 0);
        if (addSort === "Oldest to Newest") return Number(right.dataset.index || 0) - Number(left.dataset.index || 0);
        return Number(left.dataset.index || 0) - Number(right.dataset.index || 0);
      });

      filteredCards.forEach((card) => grid?.appendChild(card));
      empty?.classList.toggle("hidden", filteredCards.length > 0);
      renderPagination();
      showPage(Math.min(currentPage, Math.max(1, Math.ceil(filteredCards.length / pageSize))));
    };

    searchInput?.addEventListener("input", () => { currentPage = 1; applyFilters(); });
    document.querySelectorAll("[data-select]").forEach((select) => {
      const trigger = select.querySelector("[data-select-button]");
      const menu = select.querySelector("[data-select-menu]");
      const value = select.querySelector("[data-select-value]");
      const setOpen = (open: boolean) => {
        trigger?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("visible", open);
        menu?.classList.toggle("opacity-100", open);
        menu?.classList.toggle("invisible", !open);
        menu?.classList.toggle("opacity-0", !open);
      };

      trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"));
      select.querySelectorAll("[data-select-option]").forEach((option) => {
        option.addEventListener("click", () => {
          if (value) value.textContent = option.textContent;
          setOpen(false);
          currentPage = 1;
          applyFilters();
        });
      });
    });

    pagination?.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-page-button]") : null;
      if (button) showPage(Number(button.dataset.pageButton || 1));
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element) || event.target.closest("[data-select]")) return;
      document.querySelectorAll("[data-select-button]").forEach((button) => button.setAttribute("aria-expanded", "false"));
      document.querySelectorAll("[data-select-menu]").forEach((menu) => {
        menu.classList.remove("visible", "opacity-100");
        menu.classList.add("invisible", "opacity-0");
      });
    });

    document.querySelector("[data-reset-filters]")?.addEventListener("click", () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
      document.querySelectorAll("[data-select]").forEach((select) => {
        const first = select.querySelector("[data-select-option]");
        const value = select.querySelector("[data-select-value]");
        if (value && first) value.textContent = first.textContent;
      });
      currentPage = 1;
      applyFilters();
    });
    applyFilters();

    document.querySelectorAll("[data-loadable]").forEach((section) => {
      section.classList.remove("is-loaded");
      window.setTimeout(() => section.classList.add("is-loaded"), Number(section.getAttribute("data-load-delay") || 600));
    });
  });
</script>
