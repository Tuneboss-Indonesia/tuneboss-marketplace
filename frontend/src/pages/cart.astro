---
import TuneBossChrome from "@/components/TuneBossChrome.astro";

import { ShoppingCart, CreditCard } from "lucide-react";
import "@/styles/global.css";

export const prerender = false;
import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Keranjang | TuneBoss ID"
  description="Periksa keranjang TuneBoss ID dan lanjutkan checkout untuk produk tuning motor pilihan Anda."
  titleKey="nav.cart"
  noindex={true}
/>

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-24 pt-24 md:px-12 md:pt-32">
    <div id="cart-container" class="mx-auto max-w-5xl opacity-0 transition-opacity duration-300">
      
      <!-- Empty State -->
      <div id="cart-empty" class="hidden w-full max-w-2xl mx-auto text-center py-24">
        <ShoppingCart size={64} className="text-primary/40 mx-auto mb-6" aria-hidden="true" />
        <h2 data-i18n="cart.emptyTitle" class="text-2xl font-bold uppercase tracking-widest text-foreground">Keranjang Kosong</h2>
        <p data-i18n="cart.emptyDesc" class="mt-3 text-primary mb-8">Anda belum menambahkan produk TuneBoss apapun ke dalam keranjang.</p>
        <a href="/products" class="inline-flex items-center justify-center h-11 px-8 bg-primary text-white hover:bg-[#c95b04] font-bold uppercase tracking-widest transition-colors" style="color: white !important;">
          <span data-i18n="cart.startShopping">Mulai Belanja</span>
        </a>
      </div>

      <!-- Filled State -->
      <div id="cart-filled" class="hidden flex-col md:flex-row gap-8 text-left">
        <div class="flex-1 space-y-4">
          <div class="flex items-center gap-2 mb-6">
            <ShoppingCart size={20} className="text-primary" aria-hidden="true" />
            <h2 class="text-lg font-bold text-foreground uppercase tracking-widest flex-1">
              <span data-i18n="cart.itemsTitle">Item Keranjang</span> (<span id="cart-total-products-header">0</span> <span data-i18n="cart.products">produk</span>, <span id="cart-total-items-header">0</span> <span data-i18n="cart.items">item</span>)
            </h2>
          </div>

          <div class="flex items-center gap-3 px-4 py-3 bg-background border border-primary/20 shadow-sm mb-3">
            <input type="checkbox" id="cart-select-all" onchange="window.toggleAllCartItems(this.checked)" class="h-5 w-5 shrink-0 accent-primary cursor-pointer" />
            <label for="cart-select-all" class="text-sm font-bold uppercase tracking-widest cursor-pointer select-none">Pilih Semua</label>
          </div>

          <div id="cart-items-list" class="space-y-3">
            <!-- Items injected by JS -->
          </div>
        </div>

        <div class="w-full md:w-80 flex flex-col p-6 bg-background border border-primary/20 sticky top-24 h-fit shadow-xl transition-all">
          <h2 data-i18n="cart.orderSummary" class="text-lg font-bold text-foreground uppercase tracking-widest mb-6">
            Ringkasan Pesanan
          </h2>
          
          <div class="space-y-4 mb-6">
            <div class="flex items-center justify-between text-sm">
              <span data-i18n="cart.totalItemsLabel" class="text-foreground/70">Total Item</span>
              <span class="font-medium">
                <span id="cart-summary-products-count">0</span> <span data-i18n="cart.products">produk</span>, <span id="cart-summary-items-count">0</span> <span data-i18n="cart.items">item</span>
              </span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span data-i18n="cart.subtotalLabel" class="text-foreground/70">Subtotal</span>
              <span id="cart-summary-subtotal" class="font-medium">Rp. 0</span>
            </div>
          </div>

          <div class="pt-4 mt-2 border-t border-primary/20 bg-background">
            <div class="flex items-center justify-between mb-6">
              <span data-i18n="cart.totalLabel" class="text-base font-bold uppercase tracking-widest">
                Total
              </span>
              <span id="cart-summary-total" class="text-lg font-bold text-primary">
                Rp. 0
              </span>
            </div>

            <button id="cart-page-checkout-btn" class="flex items-center justify-center w-full h-12 gap-2 bg-primary text-white hover:bg-[#c95b04] font-bold uppercase tracking-widest transition-all opacity-50 pointer-events-none" style="color: white !important;">
              <CreditCard size={20} aria-hidden="true" />
              <span data-i18n="cart.checkoutBtn">Lanjut Checkout</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>


</TuneBossChrome>

<script>
  import { gsap } from "gsap";
  import { navigate } from "astro:transitions/client";

  const initCartPage = () => {
    const container = document.getElementById("cart-container");
    const emptyState = document.getElementById("cart-empty");
    const filledState = document.getElementById("cart-filled");
    const listRoot = document.getElementById("cart-items-list");
    
    if (!container || !emptyState || !filledState || !listRoot) return;

    let cart: CartItem[];
    try {
      cart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
    } catch {
      cart = [];
    }

    const formatRupiah = (value: number) => `Rp. ${new Intl.NumberFormat("id-ID").format(value)}`;
    
    const saveCart = (newCart: CartItem[]) => {
      localStorage.setItem("tuneboss-cart", JSON.stringify(newCart));
      window.dispatchEvent(new CustomEvent("tuneboss-cart-updated"));
      render(newCart);
    };

    const animateNumber = (element: HTMLElement, newValue: number, isCurrency = false) => {
      if (!element) return;
      const currentVal = Number(element.dataset.value || 0);
      element.dataset.value = String(newValue);
      gsap.to({ val: currentVal }, {
        val: newValue,
        duration: 0.5,
        ease: "power2.out",
        onUpdate: function () {
          element.textContent = isCurrency ? formatRupiah(Math.round(this.targets()[0].val)) : String(Math.round(this.targets()[0].val));
        }
      });
    };

    window.updateCartItemQuantity = (id: string, delta: number) => {
      let currentCart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
      currentCart = currentCart.map((item: CartItem) => {
        if (item.id === id) {
          const max = Number(item.max || 99) || 99;
          const newQty = Math.max(1, Math.min(item.quantity + delta, max));
          return { ...item, quantity: newQty };
        }
        return item;
      });
      saveCart(currentCart);
    };

    window.setCartItemQuantity = (id: string, qtyStr: string) => {
      const val = parseInt(qtyStr, 10);
      if (isNaN(val) || val < 1) return;
      
      let currentCart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
      currentCart = currentCart.map((item: CartItem) => {
        if (item.id === id) {
          const max = Number(item.max || 99) || 99;
          const newQty = Math.max(1, Math.min(val, max));
          return { ...item, quantity: newQty };
        }
        return item;
      });
      saveCart(currentCart);
    };

    window.toggleAllCartItems = (selected: boolean) => {
      let currentCart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
      currentCart = currentCart.map((item: CartItem) => ({ ...item, selected }));
      saveCart(currentCart);
    };

    window.removeCartItem = (id: string) => {
      const itemEl = document.getElementById(`cart-item-${id}`);
      if (itemEl) {
        gsap.to(itemEl, {
          opacity: 0,
          scale: 0.95,
          height: 0,
          marginBottom: 0,
          paddingTop: 0,
          paddingBottom: 0,
          borderWidth: 0,
          duration: 0.3,
          ease: "power2.inOut",
          onComplete: () => {
            let currentCart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
            currentCart = currentCart.filter((item: CartItem) => item.id !== id);
            saveCart(currentCart);
          }
        });
      }
    };

    const render = (currentCart: CartItem[]) => {
      const selectedItems = currentCart.filter((i: CartItem) => i.selected !== false);
      const totalProducts = selectedItems.length;
      const totalItems = selectedItems.reduce((sum: number, item: CartItem) => sum + item.quantity, 0);
      const totalPrice = selectedItems.reduce((sum: number, item: CartItem) => sum + (item.price * item.quantity), 0);
      const allSelected = currentCart.length > 0 && currentCart.every((i: CartItem) => i.selected !== false);
      
      const selectAllCheckbox = document.getElementById("cart-select-all") as HTMLInputElement;
      if (selectAllCheckbox) selectAllCheckbox.checked = allSelected;

      if (typeof window.updateCheckoutBtn === 'function') {
        window.updateCheckoutBtn();
      }
      
      const headerProducts = document.getElementById("cart-total-products-header");
      const headerItems = document.getElementById("cart-total-items-header");
      const summaryProducts = document.getElementById("cart-summary-products-count");
      const summaryItems = document.getElementById("cart-summary-items-count");
      
      const summarySub = document.getElementById("cart-summary-subtotal");
      const summaryTotal = document.getElementById("cart-summary-total");

      if (headerProducts) headerProducts.textContent = String(totalProducts);
      if (headerItems) headerItems.textContent = String(totalItems);
      
      if (summaryProducts) summaryProducts.textContent = String(totalProducts);
      if (summaryItems) summaryItems.textContent = String(totalItems);
      
      if (summarySub) animateNumber(summarySub, Number(totalPrice), true);
      if (summaryTotal) animateNumber(summaryTotal, Number(totalPrice), true);

      if (currentCart.length === 0) {
        filledState.classList.add("hidden");
        filledState.classList.remove("flex");
        emptyState.classList.remove("hidden");
        emptyState.classList.add("block");
        container.style.opacity = "1";
        return;
      }

      emptyState.classList.add("hidden");
      emptyState.classList.remove("block");
      filledState.classList.remove("hidden");
      filledState.classList.add("flex");

      const iconMinus = `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;
      const iconPlus = `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;
      const iconTrash = `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg>`;

      // Determine items that are already in DOM
      // const existingIds = Array.from(listRoot.children).map(el => el.id.replace('cart-item-', ''));
      // const newIds = currentCart.map(item => String(item.id));
      
      currentCart.forEach(item => {
        const itemId = String(item.id);
        const existingEl = document.getElementById(`cart-item-${itemId}`);
        
        if (existingEl) {
          // Update quantity and price safely without re-rendering entire HTML
          const qtyInput = existingEl.querySelector('.item-qty') as HTMLInputElement;
          const priceSpan = existingEl.querySelector('.item-total-price') as HTMLElement;
          const checkbox = existingEl.querySelector('.cart-item-checkbox') as HTMLInputElement;
          
          if (checkbox && checkbox.checked !== (item.selected !== false)) {
            checkbox.checked = (item.selected !== false);
          }
          if (qtyInput && qtyInput.value != String(item.quantity)) {
             qtyInput.value = String(item.quantity);
             // Animate pop
             gsap.fromTo(qtyInput, { scale: 1.2, color: "#eb6c00" }, { scale: 1, color: "inherit", duration: 0.3 });
          }
          if (priceSpan && Number(priceSpan.dataset.value) != (item.price * item.quantity)) {
             animateNumber(priceSpan, item.price * item.quantity, true);
          }
        } else {
          // Create new element
          const article = document.createElement("article");
          article.id = `cart-item-${itemId}`;
          article.className = "flex items-start gap-3 p-3 bg-background border border-primary/20 mb-3 shadow-sm overflow-hidden sm:gap-4 sm:p-4";
          article.innerHTML = `
            <input type="checkbox" class="cart-item-checkbox h-5 w-5 shrink-0 accent-primary cursor-pointer" onchange="window.toggleCartItemSelection('${itemId}')" ${item.selected !== false ? 'checked' : ''} />
            <div class="w-16 h-16 shrink-0 bg-background flex items-center justify-center p-2 sm:w-20 sm:h-20">
                <div class="w-full h-full bg-contain bg-center bg-no-repeat" style="background-image: url('${item.image || "/images/tuneboss-motorcycle-ecu.png"}');" aria-label="${item.name}" role="img"></div>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">${item.brand || "TuneBoss"}</p>
                        <h3 class="text-base font-bold text-foreground uppercase tracking-wide mt-1">${item.name}</h3>
                    </div>
                    <button type="button" onclick="window.removeCartItem('${itemId}')" class="p-2 hover:bg-primary hover:text-white text-foreground/50 transition-colors">
                        ${iconTrash}
                    </button>
                </div>
                <div class="flex flex-col gap-3 mt-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex w-fit shrink-0 items-center border border-primary/20">
                        <button type="button" onclick="window.updateCartItemQuantity('${itemId}', -1)" class="flex h-9 w-9 items-center justify-center transition-colors hover:bg-primary hover:text-white">
                            ${iconMinus}
                        </button>
                        <input type="number" min="1" max="99" value="${item.quantity}" onchange="window.setCartItemQuantity('${itemId}', this.value)" class="item-qty w-12 h-9 text-center text-sm font-medium bg-transparent border-x border-primary/20 focus:outline-none" style="-moz-appearance: textfield;" />
                        <button type="button" onclick="window.updateCartItemQuantity('${itemId}', 1)" class="flex h-9 w-9 items-center justify-center transition-colors hover:bg-primary hover:text-white">
                            ${iconPlus}
                        </button>
                    </div>
                    <span class="item-total-price block whitespace-nowrap text-right text-sm font-bold text-primary sm:text-left" data-value="${item.price * item.quantity}">
                        ${formatRupiah(item.price * item.quantity)}
                    </span>
                </div>
            </div>
          `;
          listRoot.appendChild(article);
          gsap.fromTo(article, { opacity: 0, scale: 0.95, y: 10 }, { opacity: 1, scale: 1, y: 0, duration: 0.3, ease: "power2.out" });
        }
      });

      // Synchronize language for injected items
      if (typeof window.scheduleBrowserLanguageSync === "function") {
        window.scheduleBrowserLanguageSync?.();
      }

      // Show container
      gsap.to(container, { opacity: 1, duration: 0.3 });
    };

    const checkoutBtn = document.getElementById("cart-page-checkout-btn");
    
    if (checkoutBtn) {
      window.updateCheckoutBtn = () => {
        const btn = document.getElementById("cart-page-checkout-btn");
        if (!btn) return;
        const currentCart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
        const hasSelectedItems = currentCart.some((i: CartItem) => i.selected !== false);
        const label = btn.querySelector("[data-i18n]");
        const isLoggedIn = document.cookie.includes("tuneboss-auth=true");
        if (label) {
          const isEnglish = document.documentElement.lang === "en";
          label.setAttribute("data-i18n", isLoggedIn ? "cart.checkoutBtn" : "cart.loginToCheckout");
          label.textContent = isLoggedIn ? (isEnglish ? "Proceed to Checkout" : "Lanjut Checkout") : (isEnglish ? "Login to Checkout" : "Login untuk Checkout");
        }
        if (hasSelectedItems) {
          btn.classList.remove("opacity-50", "pointer-events-none");
        } else {
          btn.classList.add("opacity-50", "pointer-events-none");
        }
      };
      
      window.updateCheckoutBtn();

      checkoutBtn.addEventListener("click", () => {
        const isLoggedIn = document.cookie.includes("tuneboss-auth=true");
        if (isLoggedIn) {
          navigate("/checkout");
        } else {
          if (typeof window.openAuthDialog === "function") {
            window.openAuthDialog("login");
          }
        }
      });
    }

    // Listen to changes from other tabs or sidebar
    const onExternalUpdate = () => {
      try {
        const saved = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
        render(Array.isArray(saved) ? saved : []);
      } catch {
        // ignore
      }
    };

    window.addEventListener("tuneboss-cart-updated", onExternalUpdate);
    
    // Initial Render
    render(cart);
    
    return () => {
      window.removeEventListener("tuneboss-cart-updated", onExternalUpdate);
    };
  };

  // Run on page load and View Transitions
  document.addEventListener("astro:page-load", () => {
    // Only init if we are on the cart page
    if (document.getElementById("cart-container")) {
      initCartPage();
    }
  });

</script>

<style is:global>
  /* Hide spinner arrows for input number */
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
  }
  
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: hsl(var(--primary) / 0.3);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: hsl(var(--primary) / 0.5);
  }
</style>
