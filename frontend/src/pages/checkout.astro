    const formatRupiah = (value: number) => `Rp. ${new Intl.NumberFormat("id-ID").format(value)}`;
    const lang = () => document.documentElement.lang === "en" ? "en" : "id";
    let addresses: Address[] = [];
    let selectedAddressId = "";
    let shippingCost = 0;
    const readCart = () => {
      try {
        const cart = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
        return Array.isArray(cart) ? cart.filter((item) => item.selected !== false) : [];
      } catch {
        return [];
      }
    };
    const removeOrderedItemsFromCart = (orderedItems: CartItem[]) => {
      const orderedIds = new Set(orderedItems.map((item) => String(item.id)));
      const allItems = JSON.parse(localStorage.getItem("tuneboss-cart") || "[]");
      const next = Array.isArray(allItems) ? allItems.filter((item) => item.selected === false || !orderedIds.has(String(item.id))) : [];
      localStorage.setItem("tuneboss-cart", JSON.stringify(next));
      window.dispatchEvent(new CustomEvent("tuneboss-cart-updated"));
    };

    const updateLanguage = () => {
      const current = copy[lang()];
      document.querySelectorAll("[data-checkout-i18n]").forEach((node) => {
        const key = node.getAttribute("data-checkout-i18n");
        if (key && current[key as keyof typeof current]) node.textContent = current[key as keyof typeof current];
      });
      document.title = `${current.eyebrow} | TuneBoss ID`;
    };

    const setText = (selector: string, value: string) => {
      document.querySelectorAll(selector).forEach((node) => { node.textContent = String(value); });
    };

    const addressText = (address: Address) => [address.addressLine, address.city, address.province, address.postalCode].filter(Boolean).join(", ");

    const refreshShippingQuote = async () => {
      const items: CartItem[] = readCart();
      if (!selectedAddressId || items.length === 0) {
        shippingCost = 0;
        render(true);
        return;
      }
      try {
        const response = await fetch(`${apiUrl}/shipping/quote`, {
          body: JSON.stringify({ addressId: selectedAddressId, items: items.map((item) => ({ id: String(item.id), quantity: Number(item.quantity || 1) })), shippingMethod: "REGULAR" }),
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          method: "POST",
        });
        const data = await response.json().catch(() => ({}));
        shippingCost = response.ok ? Number(data.quote?.cost || 0) : 0;
      } catch {
        shippingCost = 0;
      }
      render(true);
    };

    const selectAddress = (address: Address) => {
      selectedAddressId = address.id;
      const sumName = document.querySelector("[data-summary-address-name]");
      const sumPhone = document.querySelector("[data-summary-address-phone]");
      const sumFull = document.querySelector("[data-summary-address-full]");

      if (sumName) sumName.textContent = address.recipientName;
      if (sumPhone) sumPhone.textContent = address.phone;
      if (sumFull) sumFull.textContent = addressText(address);

      const badge = document.getElementById("checkout-address-primary-badge");
      badge?.classList.toggle("hidden", !address.isDefault);

      const addressSummary = document.getElementById("checkout-address-summary");
      const addressEmpty = document.getElementById("checkout-address-empty");
      addressEmpty?.classList.add("hidden");
      addressSummary?.classList.remove("hidden");
      addressSummary?.classList.add("flex");
      void refreshShippingQuote();
    };

    const renderAddressOptions = () => {
      const list = document.getElementById("modal-address-list");
      const empty = document.getElementById("modal-address-empty-msg");
      if (!list || !empty) return;

      empty.classList.toggle("hidden", addresses.length > 0);
      empty.classList.toggle("flex", addresses.length === 0);
      list.innerHTML = addresses.map((address, index) => `
        <label class="flex items-start gap-4 cursor-pointer group ${index > 0 ? "pt-6 border-t border-primary/10" : ""}">
          <input type="radio" name="address-option" value="${address.id}" class="mt-1 shrink-0 h-5 w-5 accent-primary" ${address.id === selectedAddressId ? "checked" : ""} />
          <div class="flex-1 text-sm text-foreground/80">
            <div class="flex flex-wrap items-center justify-between mb-1 gap-2">
              <div class="font-bold text-foreground">
                <span>${address.recipientName}</span>
                <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2">${address.phone}</span>
              </div>
            </div>
            <p>${addressText(address)}</p>
          </div>
        </label>
      `).join("");
    };

    const loadAddresses = async () => {
      try {
        const response = await fetch(`${apiUrl}/addresses`, { credentials: "include" });
        const data = await response.json().catch(() => ({}));
        addresses = response.ok && Array.isArray(data.addresses) ? data.addresses : [];
        if (addresses.length > 0) selectAddress(addresses.find((address) => address.isDefault) || addresses[0]);
      } catch {
        addresses = [];
      }
      renderAddressOptions();
    };

    const render = (skipListRebuild = false) => {
      const items: CartItem[] = readCart();
      const productCount = items.length;
      const itemCount = items.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
      const subtotal = items.reduce((sum, item) => sum + Number(item.price || 0) * Number(item.quantity || 0), 0);
      
      const summaryShipping = document.querySelector("[data-summary-shipping]");
      const summaryTotal = document.querySelector("[data-summary-total]");

      setText("[data-checkout-products], [data-summary-products]", String(productCount));
      setText("[data-checkout-items], [data-summary-items]", String(itemCount));
      setText("[data-summary-subtotal]", formatRupiah(subtotal));
      
      const finalTotal = subtotal + shippingCost;
      
      if (summaryShipping) summaryShipping.textContent = formatRupiah(shippingCost);
      if (summaryTotal) summaryTotal.textContent = formatRupiah(finalTotal);

      emptyRoot.classList.toggle("hidden", productCount > 0);
      listRoot.classList.toggle("hidden", productCount === 0);
      
      if (!skipListRebuild) {
        listRoot.innerHTML = items.map((item) => `
        <article class="flex gap-3 border border-primary/20 bg-background p-3 md:gap-4 md:p-4">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center bg-background md:h-20 md:w-20">
              <div class="h-full w-full bg-contain bg-center bg-no-repeat" style="background-image: url('${item.image || "/images/tuneboss-motorcycle-ecu.png"}');" aria-label="${item.name || ''}" role="img"></div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">${item.brand || "TuneBoss"}</p>
              <h3 class="mt-1 font-bold uppercase tracking-wide">${item.name || ""}</h3>
            <div class="mt-3 flex flex-col gap-3 md:mt-4 md:flex-row md:items-center md:justify-between md:gap-4">
                <div class="h-10 min-w-16 px-4 border border-primary/20 bg-transparent flex items-center justify-center text-sm font-bold">
                  ${item.quantity || 1}x
                </div>
                <span class="block whitespace-nowrap text-right font-bold text-primary md:text-left">${formatRupiah(Number(item.price || 0) * Number(item.quantity || 0))}</span>
              </div>
            </div>
          </article>
        `).join("");
        updateLanguage();
      } else {
        // Quantities are now readonly, no need to update inputs
      }
    };


    document.querySelector("[data-create-order]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const items: CartItem[] = readCart();
      // const shippingVal = sumName === "Ambil di Tempat" ? "AMBIL_DI_TEMPAT" : "JNE";
       
      if (!selectedAddressId || items.length === 0) {
        errorRoot.textContent = (copy as Record<string, Record<string, string>>)[lang()]?.required || "Mohon lengkapi alamat dan pesanan Anda.";
        errorRoot.classList.remove("hidden");
        return;
      }
       
      try {
        btn.disabled = true;
        errorRoot.classList.add("hidden");
        
        btn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memproses...`;
        const orderRes = await fetch(`${apiUrl}/orders`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({
            addressId: selectedAddressId,
            items: items.map((item) => ({ id: String(item.id), quantity: Number(item.quantity || 1) })),
            shippingMethod: "REGULAR",
          }),
        });
        const orderData = await orderRes.json().catch(() => ({}));
        if (!orderRes.ok || !orderData.order) throw new Error(orderData.message || "Gagal membuat pesanan.");
        const order = orderData.order as { id: string; items: { name: string; quantity: number; price: number }[] };
        
        const res = await fetch(`${apiUrl}/payments/xendit/invoice`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ orderId: order.id })
        });
        
        const responseText = await res.text();
        const data = responseText ? JSON.parse(responseText) : {};
        
        if (!res.ok || data.error) {
          throw new Error(data.error || "Gagal membuat tagihan Xendit.");
        }
        
         if (data.invoice_url) {
            sessionStorage.setItem("tuneboss-last-order", JSON.stringify({ id: order.id, items: order.items }));
            sessionStorage.setItem(`tuneboss-order-status-${order.id}`, "pending");
            removeOrderedItemsFromCart(items);
            window.location.href = data.invoice_url; // Redirect ke Xendit
         }
      } catch (err: unknown) {
        errorRoot.textContent = (err as Error).message || "Terjadi kesalahan saat membuat tagihan.";
        errorRoot.classList.remove("hidden");
        btn.disabled = false;
        btn.innerHTML = lang() === "en" ? "Create Order" : "Buat Pesanan";
      }
    });

