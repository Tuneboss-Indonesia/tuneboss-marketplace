    const phoneInput = document.getElementById("address-form-phone") as HTMLInputElement | null;
    const streetOptions = document.getElementById("address-street-options");
    const mapPreview = document.getElementById("address-map-preview");
    const regionState = { tab: "province", province: null as unknown, city: null as unknown, district: null as unknown, postal: "" };
    /* const regionFallback = [
      { province: "JAWA BARAT", city: "KAB. BOGOR", district: "CIBINONG", postal: "16911" },
      { province: "JAWA BARAT", city: "KOTA BEKASI", district: "BEKASI UTARA", postal: "17124" },
      { province: "BANTEN", city: "KOTA TANGERANG SELATAN", district: "PONDOK AREN", postal: "15224" },
    ]; */
    const fetchJson = async (url: string) => {
      const response = await fetch(url);
      if (!response.ok) throw new Error("API gagal");
      return response.json();
    };
    let regionSearchTimer: unknown;
    const regionSearchInput = document.getElementById("address-region-search-input") as HTMLInputElement | null;
    
    if (regionSearchInput) {
      regionSearchInput.addEventListener("input", () => {
        const val = regionSearchInput.value.trim();
        clearTimeout(regionSearchTimer as number | undefined);
        if (val.length < 3) {
          if (regionOptions) regionOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Ketik minimal 3 karakter untuk mencari.</p>`;
          return;
        }
        if (regionOptions) regionOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Mencari...</p>`;
        regionSearchTimer = setTimeout(async () => {
          try {
            const res = await fetchJson(`https://kodepos.vercel.app/search?q=${encodeURIComponent(val)}`);
            if (res && res.data && res.data.length > 0) {
              if (regionOptions) {
                const unique = Array.from(new Map(res.data.map((item: { code: string, regency: string, province: string, village: string, district: string }) => [item.code + item.village, item])).values()) as { code: string, regency: string, province: string, village: string, district: string }[];
                regionOptions.innerHTML = unique.map((item: { code: string, regency: string, province: string, village: string, district: string }) => `
                  <button type="button" class="block w-full px-4 py-3 text-left hover:bg-primary/5 transition-colors border-b border-primary/10 last:border-0" data-region-value='${JSON.stringify(item).replace(/'/g, "&apos;")}'>
                    <div class="font-bold text-foreground text-sm">${item.village}, ${item.district}</div>
                    <div class="text-[10px] text-foreground/70 uppercase tracking-[0.1em] mt-1.5">${item.regency}, ${item.province} • ${item.code}</div>
                  </button>
                `).join("");
              }
            } else {
              if (regionOptions) regionOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Wilayah tidak ditemukan.</p>`;
            }
          } catch {
            if (regionOptions) regionOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Gagal mencari data wilayah.</p>`;
          }
        }, 600);
      });
    }

    const updateRegionLabel = () => {
      const parts = [(regionState.district as { name?: string } | null)?.name, (regionState.city as { name?: string } | null)?.name, (regionState.province as { name?: string } | null)?.name, regionState.postal].filter(Boolean);
      if (regionLabel) regionLabel.textContent = parts.length ? parts.join(", ") : "Kecamatan / Kelurahan, Provinsi, Kode Pos";
      
      if (streetButton) {
        if (regionState.city) {
          streetButton.removeAttribute("disabled");
          streetButton.classList.remove("opacity-50", "cursor-not-allowed");
          
          if (locationBtn) {
            locationBtn.removeAttribute("disabled");
            locationBtn.classList.remove("opacity-50", "cursor-not-allowed");
            locationBtn.classList.add("hover:scale-105", "hover:bg-primary/5");
          }
        } else {
          streetButton.setAttribute("disabled", "true");
          streetButton.classList.add("opacity-50", "cursor-not-allowed");
          
          if (locationBtn) {
            locationBtn.setAttribute("disabled", "true");
            locationBtn.classList.add("opacity-50", "cursor-not-allowed");
            locationBtn.classList.remove("hover:scale-105", "hover:bg-primary/5");
          }
        }
      }
    };
    
    let leafletMap: LeafletMap | undefined = undefined;
    let leafletMarker: LeafletMarker | undefined = undefined;
    const mapContainer = document.getElementById("leaflet-map-container");
    const locationBtn = document.getElementById("address-location-btn");

    const showMap = async (lat?: number, lon?: number) => {
      if (!mapPreview || !mapContainer) return;
      
      let finalLat = lat;
      let finalLon = lon;
      
      if (!finalLat || !finalLon) {
        const query = [streetInput?.value, (regionState.district as { name?: string } | null)?.name, (regionState.city as { name?: string } | null)?.name, (regionState.province as { name?: string } | null)?.name, regionState.postal, "Indonesia"].filter(Boolean).join(", ");
        if (!query.trim()) return;
        try {
          const result = await fetchJson(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`);
          const place = result?.[0];
          if (!place) return;
          finalLat = Number(place.lat);
          finalLon = Number(place.lon);
        } catch {
          return;
        }
      }
      
      if (finalLat && finalLon) {
        mapContainer.classList.remove("hidden");
        if (locationBtn) locationBtn.classList.add("hidden");
        
        const latDisplay = document.getElementById("address-lat-val");
        const lonDisplay = document.getElementById("address-lon-val");
        const displayContainer = document.getElementById("address-latlon-display");
        
        const updateDisplay = (lat: number, lon: number) => {
          if (latDisplay) latDisplay.textContent = lat.toFixed(6);
          if (lonDisplay) lonDisplay.textContent = lon.toFixed(6);
          if (displayContainer) displayContainer.classList.remove("hidden");
        };
        
        updateDisplay(finalLat, finalLon);
        
        if (!leafletMap && L) {
          leafletMap = (L.map(mapContainer) as LeafletMap).setView([finalLat, finalLon], 15);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
          }).addTo(leafletMap);
          
          leafletMarker = L.marker([finalLat, finalLon], { draggable: true }).addTo(leafletMap);
          
          leafletMarker?.on('dragend', (e: LeafletEvent) => {
            const pos = e.target.getLatLng();
            updateDisplay(pos.lat, pos.lng);
          });
        } else if (leafletMap) {
          leafletMap?.setView([finalLat, finalLon], 15);
          leafletMarker?.setLatLng([finalLat, finalLon]);
          setTimeout(() => leafletMap?.invalidateSize(), 300);
        }
      }
    };

    locationBtn?.addEventListener("click", () => {
      if (navigator.geolocation) {
        locationBtn.innerHTML = "Mendeteksi...";
        navigator.geolocation.getCurrentPosition(
          async (pos) => {
            const lat = pos.coords.latitude;
            const lon = pos.coords.longitude;
            await showMap(lat, lon);
            try {
              const res = await fetchJson(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
              if (res && res.address && streetInput) {
                streetInput.value = [res.address.road, res.address.house_number].filter(Boolean).join(" ") || res.display_name.split(",")[0];
              }
            } catch { console.error("error");}
          },
          () => {
            alert("Gagal mendapatkan lokasi. Pastikan izin lokasi aktif.");
            locationBtn.innerHTML = "Deteksi Lokasi";
          },
          { enableHighAccuracy: true }
        );
      } else {
        alert("Geolocation tidak didukung browser ini.");
      }
    });
