    const checkoutBtn = document.querySelector("[data-create-order]");
    const modal = document.getElementById("checkout-terms-modal");
    const openBtn = document.getElementById("checkout-terms-open");
    const closeBtn = document.getElementById("checkout-terms-close-btn");
    const closeIcon = document.getElementById("checkout-terms-close-icon");

    if (checkbox && checkoutBtn) {
      const updateCheckoutBtn = () => {
        if (checkbox.checked) {
          checkoutBtn.classList.remove("opacity-50", "pointer-events-none");
        } else {
          checkoutBtn.classList.add("opacity-50", "pointer-events-none");
        }
      };
      checkbox.addEventListener("change", updateCheckoutBtn);
      updateCheckoutBtn();
    }

    if (modal) {
      const openModal = () => {
        document.body.style.overflow = "hidden";
        modal.classList.remove("opacity-0", "pointer-events-none");
        const inner = modal.firstElementChild as HTMLElement;
        if (inner) {
          inner.style.transform = "scale(1)";
        }
      };

      const closeModal = () => {
        document.body.style.overflow = "";
        modal.classList.add("opacity-0", "pointer-events-none");
        const inner = modal.firstElementChild as HTMLElement;
        if (inner) {
          inner.style.transform = "scale(0.95)";
        }
      };

      if (openBtn) openBtn.addEventListener("click", openModal);
      if (closeBtn) closeBtn.addEventListener("click", closeModal);
      if (closeIcon) closeIcon.addEventListener("click", closeModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
