        addressFormModal.classList.remove("opacity-0", "pointer-events-none");
        const inner = addressFormModal.firstElementChild as HTMLElement;
        if (inner) inner.style.transform = "scale(1)";
        
        // Refresh map if data exists (for Edit mode)
        if (container) {
          setTimeout(() => showMap(), 300);
        }
      };
      const closeAddressForm = () => {
        if (!addressFormModal) return;
        document.body.style.overflow = "";
        addressFormModal.classList.add("opacity-0", "pointer-events-none");
        const inner = addressFormModal.firstElementChild as HTMLElement;
        if (inner) inner.style.transform = "scale(0.95)";
        openAddressModal();
      };

      if (addressChangeBtn) addressChangeBtn.addEventListener("click", openAddressModal);
      if (addressSelectBtn) addressSelectBtn.addEventListener("click", openAddressModal);
      if (addressAddBtn) addressAddBtn.addEventListener("click", () => openAddressForm("Alamat Baru"));
      if (addressCloseIcon) addressCloseIcon.addEventListener("click", closeAddressModal);
      if (addressFormClose) addressFormClose.addEventListener("click", closeAddressForm);
      addressModal.querySelectorAll("[data-address-edit]").forEach((button) => {
        button.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          openAddressForm("Ubah Alamat", button.closest("label"));
        });
      });

      addressModal.addEventListener("click", (e) => {
        if (e.target === addressModal) closeAddressModal();
      });
      if (addressFormModal) {
        addressFormModal.addEventListener("click", (e) => {
          if (e.target === addressFormModal) closeAddressForm();
        });
        const addressSchema = z.object({
          name: z.string().min(3, { message: "Nama minimal 3 karakter" }),
          phone: z.string().min(9, { message: "Nomor telepon tidak valid" }),
          province: z.string().min(1, { message: "Pilih wilayah pengiriman" }),
          street: z.string().min(5, { message: "Alamat/nama jalan terlalu pendek" }),
          lat: z.string().min(1, { message: "Wajib Deteksi Lokasi di peta" }),
          lon: z.string().min(1, { message: "Wajib Deteksi Lokasi di peta" }),
        });

        addressFormModal.querySelector("form")?.addEventListener("submit", (e) => {
          e.preventDefault();
          
          document.querySelectorAll(".zod-error").forEach(el => el.remove());
          
          const nameInput = document.getElementById("address-form-name") as HTMLInputElement;
          const phoneInput = document.getElementById("address-form-phone") as HTMLInputElement;
          const streetInput = document.getElementById("address-form-street") as HTMLInputElement;
          
          const data = {
            name: nameInput?.value.trim() || "",
            phone: phoneInput?.value.trim() || "",
            province: (regionState.province as { name?: string } | null)?.name || "",
            street: streetInput?.value.trim() || "",
            lat: document.getElementById("address-lat-val")?.textContent?.replace("-", "").trim() || "",
            lon: document.getElementById("address-lon-val")?.textContent?.replace("-", "").trim() || "",
          };
          
          const result = addressSchema.safeParse(data);
          if (!result.success) {
            result.error.issues.forEach(issue => {
              const msg = document.createElement("p");
              msg.className = "zod-error text-[11px] font-medium text-red-500 mt-1.5 px-1";
              msg.textContent = issue.message;
              if (issue.path[0] === "name" && nameInput) nameInput.parentElement?.appendChild(msg);
              if (issue.path[0] === "phone" && phoneInput) phoneInput.parentElement?.appendChild(msg);
              if (issue.path[0] === "province") {
                const picker = document.getElementById("address-region-picker");
                if (picker) picker.parentElement?.appendChild(msg);
              }
              if (issue.path[0] === "street") {
                const picker = document.getElementById("address-street-picker");
                if (picker) picker.parentElement?.appendChild(msg);
              }
              if (issue.path[0] === "lat" || issue.path[0] === "lon") {
                const mapPreview = document.getElementById("address-map-preview");
                if (mapPreview && !document.getElementById("map-error-msg")) {
                  msg.id = "map-error-msg";
                  msg.classList.add("text-center", "w-full", "mb-2");
                  mapPreview.insertAdjacentElement("afterend", msg);
                }
              }
            });
            return;
          }
          
          const detailInput = document.getElementById("address-form-detail") as HTMLInputElement | null;
          fetch(`${apiUrl}/addresses`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({
              addressLine: [data.street, detailInput?.value.trim()].filter(Boolean).join(", "),
              city: (regionState.city as { name?: string } | null)?.name || "",
              isDefault: addresses.length === 0,
              label: "Rumah",
              phone: data.phone,
              postalCode: regionState.postal,
              province: data.province,
              recipientName: data.name,
            }),
          })
            .then(async (response) => {
              const payload = await response.json().catch(() => ({}));
              if (!response.ok || !payload.address) throw new Error(payload.message || "Gagal menyimpan alamat.");
              addresses = [payload.address, ...addresses.filter((address) => address.id !== payload.address.id)];
              selectAddress(payload.address);
              renderAddressOptions();
              closeAddressForm();
            })
            .catch((error: Error) => {
              const msg = document.createElement("p");
              msg.className = "zod-error text-[11px] font-medium text-red-500 mt-1.5 px-1";
              msg.textContent = error.message;
              nameInput.parentElement?.appendChild(msg);
            });
        });
      }
      regionButton?.addEventListener("click", () => {
        regionMenu?.classList.toggle("hidden");
        if (!regionMenu?.classList.contains("hidden")) {
          setTimeout(() => regionSearchInput?.focus(), 50);
        }
      });
      
      regionOptions?.addEventListener("click", async (e) => {
        const button = (e.target as Element).closest("[data-region-value]");
        if (!(button instanceof HTMLElement)) return;
        const item = JSON.parse(button.dataset.regionValue || "{}");
        
        regionState.province = { name: item.province };
        regionState.city = { name: item.regency };
        regionState.district = { name: item.district };
        regionState.postal = item.code;
        
        updateRegionLabel();
        regionMenu?.classList.add("hidden");
        if (regionSearchInput) regionSearchInput.value = "";
        if (regionOptions) regionOptions.innerHTML = "";
      });
      const renderStreetSuggestions = async () => {
        if (!streetSearchInput || !streetOptions) return;
        const val = streetSearchInput.value.trim();
        if (val.length > 0 && val.length < 3) {
          streetOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Ketik minimal 3 karakter untuk mencari.</p>`;
          return;
        }
        
        streetOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Memuat daftar jalan...</p>`;
        
        try {
          // Jika kosong, cari default "Jalan" agar memunculkan daftar jalan terdekat di kota tersebut
          const queryVal = val.length === 0 ? "Jalan" : val;
          const cityClean = (regionState.city as { name?: string } | null)?.name?.replace(/KABUPATEN |KOTA /i, "");
          // Jika masih mencari default, tambahkan kecamatan agar lebih akurat (jika ada)
          const parts = val.length === 0 
            ? [queryVal, (regionState.district as { name?: string } | null)?.name, cityClean, "Indonesia"].filter(Boolean).join(", ")
            : [queryVal, cityClean, "Indonesia"].filter(Boolean).join(", ");
          
          const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=5&q=${encodeURIComponent(parts)}`).then(r => r.json());
          
          let html = "";
          
          if (res && res.length > 0) {
            html += res.map((place: unknown) => `
              <button type="button" class="block w-full p-4 text-left hover:bg-primary/5 border-b border-primary/5 last:border-0" data-street="${(place as LocationItem).display_name.split(",")[0].replace(/"/g, '&quot;')}">
                <div class="font-bold text-sm text-foreground">${(place as LocationItem).display_name.split(",")[0]}</div>
                <div class="text-[11px] text-foreground/60 mt-1 line-clamp-1">${(place as LocationItem).display_name}</div>
              </button>
            `).join("");
          }
          
          if (val.length > 0) {
            html += `
              <button type="button" class="block w-full p-4 text-left hover:bg-primary/5 bg-primary/5 text-primary border-t border-primary/10" data-street="${val.replace(/"/g, '&quot;')}">
                <div class="font-bold text-sm">Gunakan "${val}"</div>
                <div class="text-[11px] opacity-80 mt-1">Lanjutkan dengan nama yang Anda ketik</div>
              </button>
            `;
          }
          
          streetOptions.innerHTML = html;
        } catch {
          streetOptions.innerHTML = `<p class="px-5 py-4 text-sm text-foreground/50 text-center">Gagal mencari jalan.</p>`;
        }
      };
      
      streetButton?.addEventListener("click", () => {
        streetMenu?.classList.toggle("hidden");
        if (!streetMenu?.classList.contains("hidden")) {
          setTimeout(() => streetSearchInput?.focus(), 50);
          if (streetSearchInput && streetSearchInput.value.trim().length === 0) {
             renderStreetSuggestions();
          }
        }
      });
      
      streetSearchInput?.addEventListener("input", () => {
        window.clearTimeout(Number(streetSearchInput.dataset.timer || 0));
        streetSearchInput.dataset.timer = String(window.setTimeout(renderStreetSuggestions, 350));
      });
      phoneInput?.addEventListener("input", () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, "");
      });
      streetOptions?.addEventListener("click", async (e) => {
        const button = (e.target as Element).closest("[data-street]");
        if (!(button instanceof HTMLElement) || !streetInput || !streetLabel) return;
        streetInput.value = button.dataset.street || "";
        streetLabel.textContent = streetInput.value;
        streetLabel.classList.remove("text-foreground/60");
        streetMenu?.classList.add("hidden");
      });
      mapPreview?.addEventListener("click", async (e) => {
        if ((e.target as Element).closest("#address-location-btn")) await showMap();
      });
      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element)) return;
        const path = e.composedPath();
        const isRegion = path.some((n) => (n as Element).id === "address-region-picker");
        const isStreet = path.some((n) => (n as Element).id === "address-street-picker");
        
        if (!isRegion) regionMenu?.classList.add("hidden");
        if (!isStreet) streetMenu?.classList.add("hidden");
      });

      addressModal.addEventListener("change", (e) => {
        if ((e.target as HTMLInputElement).name === "address-option") {
          const target = e.target as HTMLInputElement;
          if (target.checked) {
            const address = addresses.find((item) => item.id === target.value);
            if (address) selectAddress(address);
            closeAddressModal();
          }
        }
      });
    }


    
    // Check saved language
    const savedLang = localStorage.getItem("tuneboss-lang");
    if (savedLang) document.documentElement.lang = savedLang;

    updateLanguage();
    render();
    void loadAddresses();
    new MutationObserver(updateLanguage).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
  };

  document.addEventListener("astro:page-load", initCheckoutPage);
</script>

<style>
  .checkout-input {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
    background: transparent;
    padding: 1rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .checkout-input:focus {
    border-color: var(--primary);
  }

  .address-region-tab {
    padding: 0.9rem 0.5rem;
    border-bottom: 2px solid transparent;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    font-weight: 600;
  }

  .address-region-tab.active {
    border-color: var(--primary);
    color: var(--primary);
  }

  .address-region-tab:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }
</style>
