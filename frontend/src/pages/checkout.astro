---
import TuneBossChrome from "@/components/TuneBossChrome.astro";

import { CreditCard, MapPin, PackageCheck, ShoppingBag } from "lucide-react";
import "@/styles/global.css";
import "leaflet/dist/leaflet.css";

export const prerender = false;
import SEO from "@/components/SEO.astro";
---

<SEO 
  title="Checkout | TuneBoss ID"
  description="Lengkapi alamat dan buat pesanan TuneBoss ID."
  noindex={true}
/>

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-16 pt-24 md:px-12 md:pb-24 md:pt-32">
    <section class="mx-auto grid max-w-6xl gap-5 md:gap-8 lg:grid-cols-[1fr_360px]">
      <div class="space-y-5 md:space-y-8">
        <header>
          <h1 class="text-2xl font-bold uppercase tracking-widest md:text-5xl">Checkout</h1>
        </header>

        <section>
          <div class="mb-4 flex items-center gap-3">
            <MapPin size={20} className="text-primary" aria-hidden="true" />
            <h2 data-checkout-i18n="addressTitle" class="text-lg font-bold uppercase tracking-widest">Alamat Pengiriman</h2>
          </div>
          <div id="checkout-address-empty" class="flex flex-col items-center justify-center gap-4 border border-dashed border-primary/40 bg-primary/5 p-8 text-center">
            <p data-checkout-i18n="addressEmpty" class="text-sm text-foreground/80">Belum ada alamat pengiriman yang ditambahkan.</p>
            <button type="button" id="checkout-address-select-btn" data-checkout-i18n="addressSelect" class="bg-primary px-6 py-2 text-sm font-bold tracking-widest text-white hover:bg-primary/90 transition-colors uppercase">PILIH ALAMAT PENGIRIMAN</button>
          </div>

          <div id="checkout-address-summary" class="hidden flex-col gap-4 border border-primary/20 bg-background p-4 text-sm text-foreground md:flex-row md:items-start md:p-6">
            <div class="font-bold shrink-0">
              <span data-summary-address-name></span> 
              <span data-summary-address-phone></span>
            </div>
            <div class="flex-1 text-foreground/80 leading-relaxed">
              <span data-summary-address-full></span>
              <span id="checkout-address-primary-badge" class="hidden ml-2 px-2 py-0.5 border border-primary text-primary text-[10px] uppercase">Utama</span>
            </div>
            <button type="button" id="checkout-address-change-btn" data-checkout-i18n="addressChange" class="font-bold text-primary hover:underline self-start shrink-0">Ubah</button>
          </div>
        </section>

        <section>
          <div class="mb-4 flex items-center gap-3 md:mb-6">
            <ShoppingBag size={20} className="text-primary" aria-hidden="true" />
            <h2 class="text-lg font-bold uppercase tracking-widest">
              <span data-checkout-i18n="orderedTitle">Produk Dipesan</span>
              <span class="text-primary">(<span data-checkout-products>0</span> <span data-checkout-i18n="products">produk</span>, <span data-checkout-items>0</span> <span data-checkout-i18n="items">item</span>)</span>
            </h2>
          </div>
          <div data-checkout-empty class="hidden py-10 text-center">
            <PackageCheck size={48} className="mx-auto mb-5 text-primary/40" aria-hidden="true" />
            <p data-checkout-i18n="empty" class="font-bold uppercase tracking-widest">Belum ada produk dipilih.</p>
            <a data-checkout-i18n="backProducts" href="/products" class="mt-5 inline-flex border border-primary/20 px-6 py-3 text-xs font-bold uppercase tracking-widest transition-colors hover:border-primary hover:text-primary">Pilih Produk</a>
          </div>
          <div data-checkout-list class="space-y-3 md:space-y-4"></div>


        </section>
      </div>

      <aside class="h-fit border border-primary/20 bg-background p-4 shadow-xl md:p-6 lg:sticky lg:top-28">
        <h2 data-checkout-i18n="summary" class="mb-4 text-lg font-bold uppercase tracking-widest md:mb-6">Ringkasan Pesanan</h2>
        <div class="space-y-4 text-sm">
          <div class="flex justify-between gap-4">
            <span data-checkout-i18n="totalItems" class="text-foreground/70">Total Item</span>
            <span><span data-summary-products>0</span> <span data-checkout-i18n="products">produk</span>, <span data-summary-items>0</span> <span data-checkout-i18n="items">item</span></span>
          </div>
          <div class="flex justify-between gap-4">
            <span data-checkout-i18n="subtotal" class="text-foreground/70">Subtotal</span>
            <span data-summary-subtotal>Rp. 0</span>
          </div>
          <div class="flex justify-between gap-4 hidden" aria-hidden="true">
            <span data-checkout-i18n="shippingCost" class="text-foreground/70">Ongkos Kirim</span>
            <span data-summary-shipping>Rp. 0</span>
          </div>
          <div class="border-t border-primary/20 pt-5">
            <div class="flex items-center justify-between gap-4">
              <span data-checkout-i18n="total" class="font-bold uppercase tracking-widest">Total</span>
              <span data-summary-total class="text-lg font-bold text-primary">Rp. 0</span>
            </div>
          </div>
        </div>
        <div class="mt-6 flex items-start gap-3">
          <input type="checkbox" id="checkout-terms-checkbox" class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-primary" />
          <label for="checkout-terms-checkbox" class="text-xs text-foreground/80 leading-relaxed cursor-pointer select-none">
            <span data-checkout-i18n="agreeLabel">Saya menyetujui </span>
            <button type="button" id="checkout-terms-open" class="text-primary hover:underline font-semibold" data-checkout-i18n="agreeLink">
              Syarat & Ketentuan Pengiriman
            </button>
          </label>
        </div>
        <button data-create-order class="mt-6 flex h-12 w-full opacity-50 pointer-events-none items-center justify-center gap-3 bg-primary px-5 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-[#c95b04]" type="button" style="color: white !important;">
          <CreditCard size={18} aria-hidden="true" />
          <span data-checkout-i18n="createOrder">Buat Pesanan</span>
        </button>
        <p data-checkout-error class="mt-4 hidden text-sm text-red-500"></p>
      </aside>
    </section>
  </main>

  <!-- Address Modal -->
  <div id="checkout-address-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="bg-background border border-primary/20 max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col relative scale-95 transition-transform duration-300 shadow-2xl rounded-lg">
      
      <div class="flex items-center justify-between p-6 border-b border-primary/10 shrink-0">
        <h3 data-checkout-i18n="addressModalTitle" class="text-xl font-bold uppercase tracking-widest text-foreground">Alamat Saya</h3>
        <button type="button" id="checkout-address-close-icon" class="text-foreground/50 hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="overflow-y-auto p-6 custom-scrollbar space-y-6 flex-1">
        
        <!-- Empty Modal State -->
        <div id="modal-address-empty-msg" class="hidden flex-col items-center justify-center py-10 text-center">
          <p data-checkout-i18n="addressEmpty" class="text-sm text-foreground/80">Belum ada alamat pengiriman yang ditambahkan.</p>
        </div>

        <div id="modal-address-list" class="space-y-6">
          <label class="flex items-start gap-4 cursor-pointer group">
          <input type="radio" name="address-option" value="1" class="mt-1 shrink-0 h-5 w-5 accent-primary" />
          <div class="flex-1 text-sm text-foreground/80">
            <div class="flex flex-wrap items-center justify-between mb-1 gap-2">
              <div class="font-bold text-foreground">
                <span data-address-opt-name>Budi Santoso</span>
                <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2" data-address-opt-phone>(+62) 812 3456 7890</span>
              </div>
              <button type="button" data-address-edit data-checkout-i18n="addressChange" class="text-primary font-bold hover:underline shrink-0">Ubah</button>
            </div>
            <p data-address-opt-full data-address-opt-district="Cibinong">Jl. Merdeka No. 17, Sukamaju, Kec. Cibinong<br/>KAB. BOGOR, JAWA BARAT, ID 16911</p>
          </div>
        </label>

        <label class="flex items-start gap-4 cursor-pointer group pt-6 border-t border-primary/10">
          <input type="radio" name="address-option" value="2" class="mt-1 shrink-0 h-5 w-5 accent-primary" />
          <div class="flex-1 text-sm text-foreground/80">
            <div class="flex flex-wrap items-center justify-between mb-1 gap-2">
              <div class="font-bold text-foreground">
                <span data-address-opt-name>Siti Aminah</span>
                <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2" data-address-opt-phone>(+62) 813 2222 3344</span>
              </div>
              <button type="button" data-address-edit data-checkout-i18n="addressChange" class="text-primary font-bold hover:underline shrink-0">Ubah</button>
            </div>
            <p data-address-opt-full data-address-opt-district="Bekasi Utara">Jl. Melati Raya No. 8, Harapan Jaya<br/>KOTA BEKASI, JAWA BARAT, ID 17124</p>
          </div>
        </label>

        <label class="flex items-start gap-4 cursor-pointer group pt-6 border-t border-primary/10">
          <input type="radio" name="address-option" value="3" class="mt-1 shrink-0 h-5 w-5 accent-primary" />
          <div class="flex-1 text-sm text-foreground/80">
            <div class="flex flex-wrap items-center justify-between mb-1 gap-2">
              <div class="font-bold text-foreground">
                <span data-address-opt-name>Ambil di Tempat</span>
                <span class="font-normal text-foreground/60 ml-2 border-l border-foreground/20 pl-2" data-address-opt-phone>TuneBoss ID</span>
              </div>
            </div>
            <p data-address-opt-full>Datang langsung ke bengkel/toko TuneBoss ID.<br/>Tunjukkan ID Pesanan Anda saat pengambilan.</p>
          </div>
        </label>
        </div>
      </div>

      <div class="p-6 border-t border-primary/10 flex justify-end bg-background shrink-0">
        <button type="button" id="checkout-address-add-btn" class="flex items-center justify-center gap-2 px-6 py-3 bg-primary text-white font-bold tracking-widest hover:bg-[#c95b04] transition-colors text-sm w-full md:w-auto" style="color: white !important;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span data-checkout-i18n="addressAddBtn">Tambah Alamat Baru</span>
        </button>
      </div>

    </div>
  </div>

  <div id="checkout-address-form-modal" class="fixed inset-0 z-[110] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="bg-background border border-primary/20 max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 md:p-8 relative scale-95 transition-transform duration-300 shadow-2xl">
      <button type="button" id="checkout-address-form-close" class="absolute right-4 top-4 text-foreground/50 hover:text-primary transition-colors" aria-label="Tutup">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <h3 id="checkout-address-form-title" class="mb-7 text-2xl font-bold text-foreground">Alamat Baru</h3>
      <form class="space-y-5">
        <div class="grid gap-5 md:grid-cols-2">
          <div class="flex flex-col gap-1.5 w-full">
            <input id="address-form-name" class="checkout-input" placeholder="Nama Lengkap" />
          </div>
          <div class="flex flex-col gap-1.5 w-full">
            <input id="address-form-phone" class="checkout-input" inputmode="numeric" pattern="[0-9]*" placeholder="Nomor Telepon" />
          </div>
        </div>
        <div class="flex flex-col gap-1.5 w-full">
          <div class="relative" id="address-region-picker">
            <button type="button" id="address-region-button" class="checkout-input flex items-center justify-between text-left text-foreground/60">
              <span id="address-region-label">Kecamatan / Kelurahan, Provinsi, Kode Pos</span>
              <svg class="h-4 w-4 shrink-0 text-foreground/60" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div id="address-region-menu" class="hidden absolute left-0 top-full z-[130] w-full border border-primary/30 bg-background shadow-xl p-3">
              <input type="text" id="address-region-search-input" class="w-full text-sm px-4 py-3 border border-primary/20 outline-none focus:border-primary mb-2 bg-transparent text-foreground" placeholder="Ketik kecamatan atau kelurahan..." autocomplete="off">
              <div id="address-region-options" class="max-h-[50vh] overflow-y-auto custom-scrollbar"></div>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-1.5 w-full">
          <div class="relative" id="address-street-picker">
            <input type="hidden" id="address-form-street" />
            <button type="button" id="address-street-button" class="checkout-input flex items-center justify-between text-left text-foreground/60 opacity-50 cursor-not-allowed" disabled>
              <span id="address-street-label" class="truncate mr-2">Pilih Jalan, Gedung, Perumahan</span>
              <svg class="h-4 w-4 shrink-0 text-foreground/60" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div id="address-street-menu" class="hidden absolute left-0 top-full z-[120] w-full border border-primary/30 bg-background shadow-xl p-3">
              <input type="text" id="address-street-search-input" class="w-full text-sm px-4 py-3 border border-primary/20 outline-none focus:border-primary mb-2 bg-transparent text-foreground" placeholder="Ketik nama jalan atau gedung..." autocomplete="off">
              <div id="address-street-options" class="max-h-[40vh] overflow-y-auto custom-scrollbar"></div>
            </div>
          </div>
        </div>
        <div class="flex flex-col gap-1.5 w-full">
          <input id="address-form-detail" class="checkout-input" placeholder="Detail Lainnya (Cth: Blok / Unit No., Patokan)" />
        </div>
        <div id="address-map-preview" class="relative flex min-h-64 items-center justify-center overflow-hidden border border-primary/10 bg-primary/5 text-foreground/40">
          <div id="leaflet-map-container" class="absolute inset-0 z-0 h-full w-full hidden"></div>
          <button type="button" id="address-location-btn" class="z-10 border-2 px-5 py-3 font-bold flex items-center gap-2 shadow-sm transition-all border-primary bg-background text-primary opacity-50 cursor-not-allowed" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span data-checkout-i18n="detectLocation">Deteksi Lokasi</span>
          </button>
        </div>
        <div id="address-latlon-display" class="hidden text-xs text-foreground/50 text-center">
          Kordinat: <span id="address-lat-val">-</span>, <span id="address-lon-val">-</span>
        </div>
        <button type="submit" class="w-full bg-primary px-6 py-3 font-bold uppercase tracking-widest text-white hover:bg-[#c95b04]" style="color: white !important;">Simpan Alamat</button>
      </form>
    </div>
  </div>

  <!-- Terms Modal -->
  <div id="checkout-terms-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="bg-background border border-primary/20 p-6 md:p-8 max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col relative scale-95 transition-transform duration-300 shadow-2xl rounded-lg">
      <button type="button" id="checkout-terms-close-icon" class="absolute top-6 right-6 text-foreground/50 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <h3 data-checkout-i18n="termsModalTitle" class="text-xl font-bold uppercase tracking-widest mb-4 pr-8 text-foreground">Syarat & Ketentuan Pengiriman</h3>
      <div class="space-y-4 text-sm text-foreground/80 leading-relaxed max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
        <p data-checkout-i18n="termsModalCopy1">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        <p data-checkout-i18n="termsModalCopy2">Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        <p data-checkout-i18n="termsModalCopy3">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.</p>
        <p data-checkout-i18n="termsModalCopy4">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt. Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-primary/20 flex justify-end">
        <button type="button" id="checkout-terms-close-btn" data-checkout-i18n="termsModalClose" class="px-6 py-2 bg-primary text-white font-bold uppercase tracking-widest hover:bg-[#c95b04] transition-colors text-sm" style="color: white !important;">TUTUP</button>
      </div>
    </div>
  </div>


</TuneBossChrome>

