---
import TuneBossChrome from "@/components/TuneBossChrome.astro";
import AdminDashboardWrapper from "@/components/AdminDashboard.tsx";
import SEO from "@/components/SEO.astro";
import "@/styles/global.css";

export const prerender = false;
---

<SEO title="Admin Dashboard | TuneBoss ID" description="TuneBoss admin dashboard." noindex={true} />

<TuneBossChrome>
  <main class="min-h-screen bg-background px-6 pb-16 pt-24 md:px-12 md:pb-24 md:pt-32">
    <section class="mx-auto max-w-6xl">
      <div class="mb-8">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.35em] text-primary">Admin</p>
        <h1 class="text-3xl font-bold uppercase tracking-widest text-foreground md:text-5xl">Dashboard</h1>
        <p class="mt-3 max-w-2xl text-sm text-foreground/60">Ringkasan marketplace, stok rendah, dan cleanup order pending manual.</p>
      </div>
      <AdminDashboardWrapper client:load />
    </section>
  </main>
</TuneBossChrome>
