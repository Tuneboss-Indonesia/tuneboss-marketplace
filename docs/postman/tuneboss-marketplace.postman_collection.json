{
  "info": {
    "name": "TuneBoss Marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:8000/api" },
    { "key": "productId", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{apiUrl}}/health" } },
        { "name": "Ready", "request": { "method": "GET", "url": "{{apiUrl}}/ready" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" } } },
        { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}" } } },
        { "name": "Me", "request": { "method": "GET", "url": "{{apiUrl}}/auth/me" } },
        { "name": "Request Email Verification", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/email-verification/request", "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\"\n}" } } },
        { "name": "Verify Email OTP", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/email-verification/verify", "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}" } } },
        { "name": "Forgot Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/forgot-password", "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\"\n}" } } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/auth/reset-password", "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"newpass123\"\n}" } } },
        { "name": "Logout", "request": { "method": "POST", "url": "{{apiUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "Products", "request": { "method": "GET", "url": "{{apiUrl}}/products" } },
        { "name": "Product Detail", "request": { "method": "GET", "url": "{{apiUrl}}/products/{{productId}}" } },
        { "name": "Product Reviews", "request": { "method": "GET", "url": "{{apiUrl}}/products/{{productId}}/reviews" } },
        { "name": "Categories", "request": { "method": "GET", "url": "{{apiUrl}}/categories" } }
      ]
    },
    {
      "name": "Customer",
      "item": [
        { "name": "Addresses", "request": { "method": "GET", "url": "{{apiUrl}}/addresses" } },
        { "name": "Create Address", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/addresses", "body": { "mode": "raw", "raw": "{\n  \"recipientName\": \"Test Customer\",\n  \"phone\": \"081234567890\",\n  \"addressLine\": \"Jl. Test No. 1\",\n  \"city\": \"Jakarta\",\n  \"province\": \"DKI Jakarta\",\n  \"postalCode\": \"10110\",\n  \"isDefault\": true\n}" } } },
        { "name": "Shipping Quote", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/shipping/quote", "body": { "mode": "raw", "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingMethod\": \"REGULAR\",\n  \"items\": [{ \"id\": \"{{productId}}\", \"quantity\": 1 }]\n}" } } },
        { "name": "Create Order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/orders", "body": { "mode": "raw", "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingMethod\": \"REGULAR\",\n  \"items\": [{ \"id\": \"{{productId}}\", \"quantity\": 1 }]\n}" } } },
        { "name": "Orders", "request": { "method": "GET", "url": "{{apiUrl}}/orders" } },
        { "name": "Order Detail", "request": { "method": "GET", "url": "{{apiUrl}}/orders/{{orderId}}" } },
        { "name": "Create Invoice", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/payments/xendit/invoice", "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" } } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Summary", "request": { "method": "GET", "url": "{{apiUrl}}/admin/summary" } },
        { "name": "Orders", "request": { "method": "GET", "url": "{{apiUrl}}/admin/orders" } },
        { "name": "Products", "request": { "method": "GET", "url": "{{apiUrl}}/admin/products" } },
        { "name": "Audit Logs", "request": { "method": "GET", "url": "{{apiUrl}}/admin/audit-logs" } }
      ]
    }
  ]
}
